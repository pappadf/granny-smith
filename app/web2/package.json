{
  "name": "granny-smith-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Granny Smith emulator web UI (Svelte 5 + Vite + TypeScript). Successor to app/web/.",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@codemirror/autocomplete": "~6.20.3",
    "@codemirror/commands": "~6.11.1",
    "@codemirror/language": "~6.13.1",
    "@codemirror/state": "~6.7.6",
    "@codemirror/view": "~6.43.14",
    "@lezer/common": "~1.5.3",
    "@lezer/highlight": "~1.2.5",
    "jszip": "^3.10.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.5",
    "@webgpu/types": "^0.1.74",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.9.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.0.7",
    "vitest": "^5.0.4"
  }
}
