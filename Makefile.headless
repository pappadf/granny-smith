# Makefile for headless (native) build
# Builds a command-line emulator using the system C compiler.
# Supports automatic header dependency tracking via -MMD -MP.

# -- Compiler --

# make's built-in CC=cc outranks `CC ?=`; replace only that default.
ifeq ($(origin CC),default)
CC := gcc
endif

# TARGET=node builds the same headless program with emcc into WebAssembly,
# run by Node with the host filesystem (NODERAWFS): the CPU cores run on
# the browser's engine, without the browser.  Single-threaded: use it with
# --io=sync, as the bench harness does.
TARGET ?= native
ifeq ($(TARGET),node)
CC := emcc
endif
# The dialect, warnings and feature macros every build shares.
include src/build-flags.mk
CFLAGS_BASE := $(WARN_CFLAGS) $(FEATURE_CFLAGS) -MMD -MP

# -- Build mode (release | debug | sanitize | fast) --

MODE ?= release

ifeq ($(MODE),debug)
	CFLAGS_MODE := -g -O0 -DDEBUG -DGS_DEBUG
else ifeq ($(MODE),sanitize)
	CFLAGS_MODE := -g -O1 -DGS_DEBUG -fsanitize=address,undefined -fno-omit-frame-pointer
	LDFLAGS_MODE := -fsanitize=address,undefined
else ifeq ($(MODE),fast)
	# Benchmarking profile: GS_ASSERT/invariant walks and libc assert compiled
	# out (perf proposal P4).  NOT the default — the headless binary is the
	# debugging tool and CI runs the assert-enabled build.
	CFLAGS_MODE := -O2 -DGS_FAST -DNDEBUG
else
	# No -DNDEBUG: keep assertions active in the headless test/debug tool
	CFLAGS_MODE := -O2
endif

# -- Directories --

# fast mode builds into its own tree, so switching between it and the default
# build does not recompile everything each time (a flags change does trigger
# a full rebuild -- see FLAGS_STAMP -- but only within one tree).
ifeq ($(MODE),fast)
BUILD_DIR     := build/headless-fast
else
BUILD_DIR     := build/headless
endif
ifeq ($(TARGET),node)
BUILD_DIR     := $(BUILD_DIR)-node
endif
CORE_DIR      := src/core
MACHINES_DIR  := src/machines
PLATFORM_DIR  := src/platform/headless
PEELER_DIR    := src/peeler
CODEC_DIR     := src/codec

# -- GS declaration-ROM 68K fragments --
# Assembled by m68k binutils into build/vrom68k/ (shared with the wasm
# build — the fragments are target-independent data).  Defines
# VROM68K_HEADER and the rules that produce it.

include src/core/peripherals/nubus/vrom68k/vrom68k.mk

# -- Predecoded-core T1 headers (generated into build/gen/) --

include src/core/cpu/pdgen.mk
# -- GSDisk SCSI disk driver (bare-volume wrapper) --
# Assembled into build/gsdisk/ like the vrom68k fragments; defines
# GSDISK_HEADER, which image_wrap.c includes.

include src/core/storage/gsdisk/gsdisk.mk

# -- EfterScript platen (PLATEN=1) and the embedded LaserWriter prelude --
# Defines PLATEN, PLATEN_CFLAGS, PLATEN_LIB_NATIVE, PLATEN_NATIVE_LIBS,
# LASERWRITER_OUT and the rule for LASERWRITER_PRELUDE_HEADER.

include src/core/network/laserwriter.mk
include src/core/lua/gs_lua.mk

# -- Sources and the shared include roster (CORE_INCLUDES) --

include src/sources.mk

# -- Include paths --
# The shared platform.h (src/platform), then this target's clock
# (platform_clock.h in PLATFORM_DIR).

INCLUDES := -Isrc/platform \
            -I$(PLATFORM_DIR) \
            $(CORE_INCLUDES) \
            $(PEELER_INCLUDES) \
            -I$(VROM68K_OUT) \
            -I$(PDGEN_OUT) \
            -I$(GSDISK_OUT) \
            -I$(LASERWRITER_OUT) \
            -I$(GS_LUA_OUT) \
            $(LUA_INCLUDES)

# -- Sources --
# CORE_SRC, PEELER_SRC and CODEC_SRC come from src/sources.mk (included above).

# Platform-specific sources
PLATFORM_SRC := $(wildcard $(PLATFORM_DIR)/*.c)

# The LaserWriter bridge reaches its interpreter through one transport per
# build (laserwriter_transport.h): headless links the platen library and
# calls it directly; the ring transport is the browser's (Makefile).
CORE_SRC := $(filter-out $(CORE_DIR)/network/laserwriter_transport_ring.c,$(CORE_SRC))

# All sources
SRC := $(CORE_SRC) $(PLATFORM_SRC) $(PEELER_SRC) $(CODEC_SRC) $(LUA_SRC)

# Object and dependency files (mirror source tree under BUILD_DIR)
OBJ := $(patsubst %.c,$(BUILD_DIR)/%.o,$(SRC))
DEP := $(OBJ:.o=.d)

# Output binary (TARGET=node: gs-headless.js plus a gs-headless launcher, so
# scripts that run the binary run the wasm build unchanged)
OUTPUT := $(BUILD_DIR)/gs-headless

# -- Combined flags --

CFLAGS  := $(CFLAGS_BASE) $(CFLAGS_MODE) $(INCLUDES) $(PLATEN_CFLAGS) $(LUA_CFLAGS) $(EXTRA_CFLAGS)
LDFLAGS := $(LDFLAGS_MODE) -lpthread -lm
ifeq ($(TARGET),node)
# ALLOW_TABLE_GROWTH: the PowerPC translation tier installs its functions
# in the function table (ppc_jit.c).
LDFLAGS := $(LDFLAGS_MODE) -lm -sENVIRONMENT=node -sNODERAWFS=1 -sALLOW_TABLE_GROWTH \
           -sALLOW_MEMORY_GROWTH=1 -sMAXIMUM_MEMORY=4GB -sSTACK_SIZE=5MB \
           -sEXIT_RUNTIME=1
endif

# With PLATEN=1 the platen archive goes on the link line after the objects
# (an archive resolves only what precedes it), followed by exactly the
# system libraries the Rust staticlib reports needing.  The archive is
# fetched from the pinned EfterScript release on demand (or taken from
# PLATEN_DIR); see laserwriter.mk.
ifeq ($(PLATEN),1)
PLATEN_LDLIBS := $(PLATEN_LIB_NATIVE) $(PLATEN_NATIVE_LIBS)
PLATEN_PREREQS := $(PLATEN_LIB_NATIVE) $(PLATEN_HEADER)
else
PLATEN_LDLIBS :=
PLATEN_PREREQS :=
endif

# Objects depend on the flags they were compiled with, not only on their
# sources: a stamp named after a hash of CFLAGS (MODE, EXTRA_CFLAGS, PLATEN,
# the include list) is a prerequisite of every object, so `make debug` after
# `make` recompiles instead of linking release objects with the asserts
# compiled out, and toggling PLATEN rebuilds the tree instead of mixing
# objects compiled either way.
FLAGS_HASH  := $(shell printf '%s' '$(subst ','\'',$(CFLAGS) PLATEN=$(PLATEN))' | md5sum | cut -c1-12)
FLAGS_STAMP := $(BUILD_DIR)/flags-$(FLAGS_HASH).stamp

# -- Targets --

.PHONY: all debug sanitize clean info FORCE

all: $(OUTPUT)

# Compile each .c -> .o with automatic dependency generation
$(BUILD_DIR)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

# Force-rebuild build_id.o so __DATE__/__TIME__ stay current
FORCE:
$(BUILD_DIR)/$(CORE_DIR)/build_id.o: FORCE

# The generated-header edges and the flags stamp, shared with wasm.
OBJ_ROOT := $(BUILD_DIR)
include src/build-rules.mk
$(OBJ): $(FLAGS_STAMP) $(PLATEN_PREREQS)

# Link all objects into the headless binary
ifeq ($(TARGET),node)
$(OUTPUT): $(OBJ)
	@mkdir -p $(dir $@)
	$(CC) $(OBJ) -o $@.js $(PLATEN_LDLIBS) $(LDFLAGS)
	@printf '#!/bin/sh\nexec node "$$(dirname "$$0")/gs-headless.js" "$$@"\n' > $@
	@chmod +x $@
	@echo "Built: $@ (wasm, run by node)"
else
$(OUTPUT): $(OBJ)
	@mkdir -p $(dir $@)
	$(CC) $(OBJ) -o $@ $(PLATEN_LDLIBS) $(LDFLAGS)
	@echo "Built: $@"
endif

# Include auto-generated header dependency files
-include $(DEP)

# Convenience build-mode shortcuts
debug:
	$(MAKE) MODE=debug

sanitize:
	$(MAKE) MODE=sanitize

# Clean build artifacts
# Both headless trees (default and MODE=fast).  build/vrom68k and
# build/laserwriter are shared with the WASM build; the top-level `make
# clean` owns them.
clean:
	rm -rf build/headless build/headless-fast build/headless-node build/headless-fast-node

# Show build configuration
info:
	@echo "CC:       $(CC)"
	@echo "MODE:     $(MODE)"
	@echo "PLATEN:   $(PLATEN) ($(PLATEN_DIR))"
	@echo "CFLAGS:   $(CFLAGS)"
	@echo "LDFLAGS:  $(LDFLAGS)"
	@echo "OUTPUT:   $(OUTPUT)"
	@echo ""
	@echo "Sources:"
	@echo "  Core:     $(words $(CORE_SRC)) files"
	@echo "  Platform: $(words $(PLATFORM_SRC)) files"
	@echo "  Peeler:   $(words $(PEELER_SRC)) files"
	@echo "  Codec:    $(words $(CODEC_SRC)) files"
	@echo "  Total:    $(words $(SRC)) files"
