# pm8500-boot-desktop — a whole System 7.6 boot on the Power Macintosh 8500
# (604, 32 MB, Control video), from power-on to the desktop, and then the
# desktop itself: the workload of the PCI Power Macs' DR (dynamic
# recompilation) 68K emulator.  Run by scripts/bench/scenario.py
# (docs/guide/BENCHMARKS.md, "Scenarios"); not a metric-A/B row.
#
# The DR emulator translates 68K code into PowerPC code in its translation
# cache in RAM (0x69019000-0x6903D060) and runs it from there, patching and
# flushing the cache as it goes: code written while it runs, the hard case
# for the PowerPC translation tier (docs/internals/core/cpu/ppc/ppc_jit.md,
# "volatile" pages).  Where the boot spends its time (the PC sampled every
# 1 M instructions on the native build):
#
#   0 - 0.6 G     ROM start-up, Open Firmware, POST, the disk's driver and
#                 the startup volume's mount
#   0.6 - 1.9 G   System 7.6 starting: much native PowerPC code in RAM,
#                 the DR emulator rising from 1.6 G; the desktop is drawn
#                 by 1.9 G
#   1.9 G on      the desktop with the Energy Saver first-boot message in
#                 front: the PC is in the DR emulator's runtime and cache
#                 more than half the time, and the Process Manager's code
#                 overflows the cache every few seconds of guest time
#
# The disk is gs-test-data `systems/system_7_6_170mb_24ac.img` (suite-tnt's
# and pm8500-finder's).
#
#   MODE=boot  attach the disk and save CKPT at power-on
#   MODE=run   load CKPT and run three fixed stretches of scheduler slots
#              (start-up, system, desktop), each printing one @@SCEN line
#              with its host wall time, the guest instructions it retired
#              and, on a build with the translation tier, the instructions
#              that ran translated and the blocks code writes invalidated
#
# Guards: the startup volume mounted and no system error after the system
# stretch; at the end the desktop is drawn (the screen's checksum without
# the menu bar's clock, which ticks with guest time), so a boot that
# stopped short fails the run rather than timing something else.

# Run `slots` scheduler slots and report the host time, the guest
# instructions they took, and the translation tier's share
def scen_phase(name, slots) {
    let w0 = scheduler.host_wall_ns
    let i0 = machine.cpu.instr_count
    let j0 = try(jit.instructions, 0)
    let v0 = try(jit.block_invals, 0)
    scheduler.run $slots
    let di = machine.cpu.instr_count - $i0
    let ns = scheduler.host_wall_ns - $w0
    let dj = try(jit.instructions, 0) - $j0
    let dv = try(jit.block_invals, 0) - $v0
    echo "@@SCEN {\"phase\":\"${$name}\",\"ns\":${$ns},\"instr\":${$di},\"jit_instr\":${$dj},\"jit_invals\":${$dv}}"
}

if $MODE == "boot" {
    # CPI pinned at 2 (the 8500's default), the value the stretches and
    # guards were placed with, so a change of the default does not move
    # them (the checkpoint carries it into MODE=run)
    scheduler.cpi = 2
    machine.rtc.time = "2026-04-26T21:30:36"
    machine.scsi.attach_hd "${$TEST_DATA}/systems/system_7_6_170mb_24ac.img" 0
    checkpoint.save "${$CKPT}"
    echo "@@SCEN {\"phase\":\"boot\",\"instr\":${machine.cpu.instr_count}}"
} else {
    checkpoint.load "${$CKPT}"
    # The configuration under test (scenario.py's driver defines it)
    try(scen_setup(), none)
    scen_phase("startup", 600000000)
    scen_phase("system", 1300000000)
    assert debug.mac.globals.read("BootDrive") == 0x8023 "pm8500-boot-desktop: the startup volume is not mounted (BootDrive ${debug.mac.globals.read("BootDrive"):04x})"
    assert debug.mac.globals.read("DSErrCode") == 0 "pm8500-boot-desktop: system error ${debug.mac.globals.read("DSErrCode"):04x} during startup"
    scen_phase("desktop", 2100000000)
    # The desktop below the menu bar, and the menu bar left of the clock
    let below = machine.screen.checksum(20, 0, 480, 640)
    let bar = machine.screen.checksum(0, 0, 20, 480)
    echo "pm8500-boot-desktop: desktop checksums ${$below} ${$bar}"
    assert $below == 4094759351 && $bar == 638233496 "pm8500-boot-desktop: the desktop is not drawn (${$below} ${$bar})"
}
quit
