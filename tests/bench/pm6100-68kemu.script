# pm6100-68kemu — the 601 core, the nanokernel and the ROM's 68K emulator:
# a Power Macintosh 6100 ROM boot (perf-pdm's state).  By 200 M instructions
# the ROM's self-tests are done and the emulator runs the Start Manager.

def bench_boot() {
    machine.boot model="pm6100" ram=24576 rom="${$TEST_DATA}/roms/pm6100-pm7100-pm8100-9feb69b3.rom"
    machine.rtc.time = 3000000000
    scheduler.run 200000000
    bench_guard()
}

def bench_guard() {
    bench_assert_68k_emulator("pm6100-68kemu")
}
