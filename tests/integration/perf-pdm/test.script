# perf-pdm (see config.mk): the 601 interpreter's throughput row.
include "../lib/mac.script"

# Pinned before the boot: the PDM adopts a pre-boot rtc.time as its seed.
machine.rtc.time = 3000000000
machine.boot model="pm6100" ram=24576 rom="${$ROM}"

let t0 = scheduler.host_user_ns
scheduler.run 200000000
# Past the ROM's self-tests and into the SCSI scan: the nanokernel is up
# and the 68K emulator is running the Start Manager (MSR[PR] set).
assert (machine.cpu.msr & 0x4000) != 0 "perf-pdm: not in the 68K emulator after 200M instructions"
mips_floor("perf-pdm", $t0, 25)
echo "perf-pdm: blocks=${predecode.blocks} decodes=${predecode.decodes} suppressed=${predecode.suppressed_writes}"
report_perf("perf-pdm/rom-boot", scheduler.instr_count)
quit
