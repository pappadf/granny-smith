# The tnt-voodoo2-glide flow on the normative synchronous walker
# (proposal-voodoo2-raster-thread §7): the sibling's script verbatim
# with RASTER pinned to "sw", so every assertion — the driver's
# self-tests, the counters, and the in-game golden — is an equivalence
# check between the walker and the threaded default.

let RASTER = "sw"
include "../tnt-voodoo2-glide/test.script"
