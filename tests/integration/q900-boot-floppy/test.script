# Quadra 900 floppy boot through the SWIM IOP (see config.mk).

machine.floppy.drive[0].insert "../../data/systems/SSW-7.1-1.4M/Disk Tools.img"
scheduler.run 300000000

# Finder desktop with the Disk Tools volume at 640x480.
assert machine.screen.width == 640 "not in 640x480 mode"
assert machine.screen.height == 480 "not in 640x480 mode"
machine.screen.match finder-desktop.png

# ADB is alive through the SWIM IOP autopoll path: a mouse move changes
# the frame (cursor redraw).
let before = machine.screen.checksum()
machine.adb.mouse.move 320 240
scheduler.run 20000000
assert machine.screen.checksum() != $before "cursor did not move"

quit
