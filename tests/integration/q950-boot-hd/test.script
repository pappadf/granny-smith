# Quadra 950 Phase H gate (see config.mk).

# Happy Mac → "Welcome to Macintosh" → extensions → Finder desktop.
scheduler.run 900000000

# The ROM identified the 33 MHz tower: BoxFlag ($CB3, listed under its
# older MMUFluff name) holds boxQuadra950 = 20 (InternalOnlyEqu.a).
assert debug.mac.globals.read("MMUFluff") == 20 "not identified as Quadra 950"
assert machine.screen.width == 640 "not in 640x480 mode"
assert machine.screen.height == 480 "not in 640x480 mode"

# Drive the Monitors control panel by mouse (deterministic desktop; global
# warps position the cursor exactly, the ADB path delivers the clicks):
# Apple menu → Control Panels (press on the title, drag down, release).
machine.adb.mouse.move 14 5 global
scheduler.run 8000000
machine.adb.mouse.click 1
scheduler.run 15000000
machine.adb.mouse.move 80 132 global
scheduler.run 15000000
machine.adb.mouse.click 0
scheduler.run 150000000

# Double-click the Monitors control panel icon.
machine.adb.mouse.move 124 137 global
scheduler.run 8000000
machine.adb.mouse.click 1
scheduler.run 4000000
machine.adb.mouse.click 0
scheduler.run 4000000
machine.adb.mouse.click 1
scheduler.run 4000000
machine.adb.mouse.click 0
scheduler.run 250000000

# Click "Thousands" in the depth list: the DAFB driver writes AC842a
# PCBR1 = $C0 and the scanout switches to x555 16bpp.
machine.adb.mouse.move 189 130 global
scheduler.run 8000000
machine.adb.mouse.click 1
scheduler.run 4000000
machine.adb.mouse.click 0
scheduler.run 200000000

# Pixel-exact: Monitors shows "Thousands" selected and the whole frame
# (including the control panel's continuous gradient bar) renders through
# the 16-bit path.
machine.screen.match thousands-desktop.png

quit
