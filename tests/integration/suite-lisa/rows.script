# Row bodies for suite-lisa, transcribed VERBATIM from the six test
# scripts this suite absorbed (lisa-profile-boot, lisa-xenix-hdinit,
# lisa-xenix-boot, lisa-xenix-nofloppy, xl-boot, xl-no-media). The only
# edits are mechanical: a machine.boot line per row so the suite
# re-instantiates between rows, screen.match rewritten to the library's
# check()/check_ex() so REGEN works, goldens renamed to the §5.5 grammar,
# and a report_perf call. The COPS keyboard choreographies — long exact
# scan-code sequences — were copied by script, not retyped.

def row_lisa_los31_profile() {
    machine.boot model="lisa" ram=2048 rom="../../data/roms/lisa2-revh-098917b2.rom"
    # Cold-boot LOS from the installed ProFile hard disk (no floppy), relying on the
    # image's OWN on-disk PRAM snapshot.  See config.mk + docs/machines/lisa/pram_format.md.
    #
    # The ProFile image is the one the lisa-los-profile install test produces (copied
    # to a writable scratch path by TEST_SETUP).  The PRAM (also from TEST_SETUP, via
    # `seed_pram.py --coldboot`) is intentionally invalid: BootVol=2 so the ROM boots
    # the ProFile, but an empty device table + corrupted checksum so the OS computes
    # pm_good=false and restores the device configuration from the boot volume's MDDF
    # snapshot (the copy written at a clean shutdown FROM the ProFile).  A good image
    # resolves the ProFile from that snapshot and boots; a non-clean-shutdown image
    # leaves a floppy-only snapshot and fails with error 10738.

    machine.hd.attach "$WORK_DIR/profile.image"
    assert machine.id == "lisa" "machine.id != lisa"
    assert machine.rom.checksum == "098917B2" "rom.checksum != 098917B2 (rev-H)"
    assert machine.hd.present == true "ProFile should be attached"

    # Seed (invalid) parameter memory before the ROM reads it at startup.
    assert machine.hd.pram_load("${$WORK_DIR}/profile.pram") "pram_load failed"

    # The ROM reads PRAM -> BootVol=2 -> PROBOOT the ProFile -> loader -> SYSTEM.OS;
    # pm_good=false, so INIT_CONFIG restores the on-disk MDDF snapshot and FIND_PM_IDS
    # resolves the ProFile (cd_paraport) from it.  By ~100M instructions LOS has booted
    # to the Office System desktop, which opens a first-boot "Lisa clock/calendar is not
    # set properly" note (the emulated COPS real-time clock reads zero, so the OS offers
    # to set it).
    scheduler.run 100000000

    # Dismiss the note: warp the cursor onto its OK button (closed-loop on the OS cursor
    # globals $CC00F0/F2 — live on this modal) and click, leaving the clean Office System
    # desktop: the menu bar (Desk / File-Print / Edit / Housekeeping) with the
    # Preferences / Wastebasket / Clipboard / Disk icons.
    machine.adb.mouse.move 622 108 "global"
    scheduler.run 2000000
    machine.adb.mouse.click true
    scheduler.run 600000
    machine.adb.mouse.click false
    scheduler.run 12000000
    check("goldens/lisa-los3.1-720x364x1-office.png")
    report_row("LOS 3.1", "builtin", "profile-boot own-pram")
    report_perf("suite-lisa/lisa-los31-profile", scheduler.instr_count)
}

def row_lisa_xenix_hdinit() {
    machine.boot model="lisa" ram=2048 rom="../../data/roms/lisa2-revh-098917b2.rom"
    machine.floppy.drive[0].insert "../../data/Lisa/Xenix-3.0/Xenix-3.0-Boot-XProFile.dc42"
    # SCO Xenix 3.0 — hard-disk initialization (hdinit) on the Apple Lisa 2.
    # See config.mk for the procedure (XENIX Installation Guide May-1984 §1.5.1-1.5.2).
    #
    # Keyboard input uses raw Lisa COPS scancodes via keyboard.press: a key is
    # pressed (down = 0x80|keycode) then released (up = keycode) back-to-back, with a
    # short run between characters.  Holding a key (running between down and up) would
    # trip Xenix's software auto-repeat, so the down/up pairs are always adjacent.
    # Keycodes: h=6b d=7b i=53 n=6f t=66 y=67 5=64 Return=48 (so down = +0x80).

    # Attach a blank in-memory ProFile to the parallel port (the Lisa 2/5 install
    # target).  Without it the kernel panics "pf0 not on line".
    machine.hd.attach
    assert machine.id == "lisa" "machine.id != lisa"
    assert machine.rom.checksum == "098917B2" "rom.checksum != 098917B2 (rev-H)"
    assert machine.hd.present == true "ProFile should be attached"

    # (§1.5.1) Boot the floppy to the loader's "boot :" prompt (a COPS poll loop).
    scheduler.run 60000000
    check("goldens/lisa-xenix3.0-720x364x1-hdinit-bootprompt.png")

    # The ROM's pre-handoff COPS re-init leaves the loader's protocol decoder in its
    # 3-byte-report state, so the first injected key is swallowed; send a dummy key to
    # clear it, then RETURN to load the kernel from fd(2,0)xenix.
    machine.adb.keyboard.press 0xC8
    scheduler.run 3000000
    machine.adb.keyboard.press 0xC8
    machine.adb.keyboard.press 0x48
    scheduler.run 120000000
    # Kernel booted to the boot-floppy single-user shell ("<BootFloppy>").
    check("goldens/lisa-xenix3.0-720x364x1-hdinit-bootfloppy.png")

    # (§1.5.2) Type "hdinit" + RETURN.
    machine.adb.keyboard.press 0xEB
    machine.adb.keyboard.press 0x6B
    scheduler.run 600000
    machine.adb.keyboard.press 0xFB
    machine.adb.keyboard.press 0x7B
    scheduler.run 600000
    machine.adb.keyboard.press 0xD3
    machine.adb.keyboard.press 0x53
    scheduler.run 600000
    machine.adb.keyboard.press 0xEF
    machine.adb.keyboard.press 0x6F
    scheduler.run 600000
    machine.adb.keyboard.press 0xD3
    machine.adb.keyboard.press 0x53
    scheduler.run 600000
    machine.adb.keyboard.press 0xE6
    machine.adb.keyboard.press 0x66
    scheduler.run 600000
    machine.adb.keyboard.press 0xC8
    machine.adb.keyboard.press 0x48
    scheduler.run 30000000
    # "WARNING: ... Do you want to continue <y/n>?"
    check("goldens/lisa-xenix3.0-720x364x1-hdinit-continue.png")

    # Answer "y" + RETURN.
    machine.adb.keyboard.press 0xE7
    machine.adb.keyboard.press 0x67
    machine.adb.keyboard.press 0xC8
    machine.adb.keyboard.press 0x48
    scheduler.run 20000000
    # "Enter size of hard disk (5 or 10):"
    check("goldens/lisa-xenix3.0-720x364x1-hdinit-size.png")

    # Answer "5" (5 MB ProFile) + RETURN.  hdinit builds the filesystem, runs fsck,
    # writes the boot block, then shuts the system down.
    machine.adb.keyboard.press 0xE4
    machine.adb.keyboard.press 0x64
    machine.adb.keyboard.press 0xC8
    machine.adb.keyboard.press 0x48
    scheduler.run 150000000
    # "Disk initialization complete. / ** Normal System Shutdown **"
    check("goldens/lisa-xenix3.0-720x364x1-hdinit-complete.png")
    report_perf("suite-lisa/lisa-xenix-hdinit", scheduler.instr_count)
}

def row_lisa_xenix_boot() {
    machine.boot model="lisa" ram=2048 rom="../../data/roms/lisa2-revh-098917b2.rom"
    machine.floppy.drive[0].insert "../../data/Lisa/Xenix-3.0/Xenix-3.0-Boot-XProFile.dc42"
    # Boot SCO Xenix 3.0 from the installed ProFile (Apple Lisa 2).
    # See config.mk for the procedure.  The installed ProFile (writable scratch copy
    # from TEST_SETUP) is attached; the "Boot XProFile Patch" floppy (config.mk fd=)
    # supplies the loader.  At the loader "boot :" prompt we type "pf(0,0)xenix" to
    # load the kernel from the hard disk.
    #
    # Keyboard input is raw Lisa COPS scancodes (down = 0x80|kc, then release); the
    # parens in "pf(0,0)xenix" hold SHIFT (kc 0x7e) around the digit with a short
    # settle.  Keycodes: p=44 f=69 e=60 x=7a 0=51 9=50 comma=5d Return=48 shift=7e.

    machine.hd.attach "$WORK_DIR/xenix-profile.image"
    assert machine.id == "lisa" "machine.id != lisa"
    assert machine.rom.checksum == "098917B2" "rom.checksum != 098917B2 (rev-H)"
    assert machine.hd.present == true "ProFile should be attached"

    # Boot the floppy loader to its "boot :" prompt.
    scheduler.run 60000000

    # Dummy key clears the loader's COPS state-3, then type "pf(0,0)xenix" + RETURN.
    machine.adb.keyboard.press 0xC8
    scheduler.run 3000000
    machine.adb.keyboard.press 0xC4
    machine.adb.keyboard.press 0x44
    scheduler.run 600000
    machine.adb.keyboard.press 0xE9
    machine.adb.keyboard.press 0x69
    scheduler.run 600000
    machine.adb.keyboard.press 0xFE
    scheduler.run 300000
    machine.adb.keyboard.press 0xD0
    machine.adb.keyboard.press 0x50
    scheduler.run 300000
    machine.adb.keyboard.press 0x7E
    scheduler.run 600000
    machine.adb.keyboard.press 0xD1
    machine.adb.keyboard.press 0x51
    scheduler.run 600000
    machine.adb.keyboard.press 0xDD
    machine.adb.keyboard.press 0x5D
    scheduler.run 600000
    machine.adb.keyboard.press 0xD1
    machine.adb.keyboard.press 0x51
    scheduler.run 600000
    machine.adb.keyboard.press 0xFE
    scheduler.run 300000
    machine.adb.keyboard.press 0xD1
    machine.adb.keyboard.press 0x51
    scheduler.run 300000
    machine.adb.keyboard.press 0x7E
    scheduler.run 600000
    machine.adb.keyboard.press 0xFA
    machine.adb.keyboard.press 0x7A
    scheduler.run 600000
    machine.adb.keyboard.press 0xE0
    machine.adb.keyboard.press 0x60
    scheduler.run 600000
    machine.adb.keyboard.press 0xEF
    machine.adb.keyboard.press 0x6F
    scheduler.run 600000
    machine.adb.keyboard.press 0xD3
    machine.adb.keyboard.press 0x53
    scheduler.run 600000
    machine.adb.keyboard.press 0xFA
    machine.adb.keyboard.press 0x7A
    scheduler.run 600000
    machine.adb.keyboard.press 0xC8
    machine.adb.keyboard.press 0x48
    scheduler.run 120000000
    # The installed Xenix has booted to its multi-user startup prompt
    # ("Type CONTROL-d to proceed with normal startup, / or give root password ...").
    check("goldens/lisa-xenix3.0-720x364x1-startup.png")
    report_row("Xenix 3.0", "builtin", "fd-boot cops-typing profile")
    report_perf("suite-lisa/lisa-xenix-boot", scheduler.instr_count)
}

def row_lisa_xenix_nofloppy() {
    machine.boot model="lisa" ram=2048 rom="../../data/roms/lisa2-revh-098917b2.rom"
    # Apple Lisa 2 — boot SCO Xenix 3.0 from the ProFile with NO floppy (see config.mk).
    #
    # Keyboard input is raw Lisa COPS scancodes via keyboard.press (down = 0x80|kc,
    # release = kc).  The ROM STARTUP FROM picker is driven with Apple-N hotkeys
    # (Apple = COPS 0xFF down / 0x7F up; digit 3 = 0xF2 down / 0x72 up); the loader's
    # "boot :" prompt is pre-filled with the default pf(0,0)xenix, so a bare Return
    # (0xC8/0x48) boots it.

    machine.hd.attach "$WORK_DIR/xenix-profile.image"
    assert machine.id == "lisa" "machine.id != lisa"
    assert machine.rom.checksum == "098917B2" "rom.checksum != 098917B2 (rev-H)"
    assert machine.hd.present == true "ProFile should be attached"

    # === No floppy: the ROM "insert diskette / STARTUP FROM…" screen =============
    scheduler.run 200000000
    check("goldens/lisa-xenix3.0-720x364x1-nofloppy.png")

    # === Apple-3 → the ROM STARTUP FROM device picker ===========================
    machine.adb.keyboard.press 0xFF
    scheduler.run 200000
    machine.adb.keyboard.press 0xF2
    scheduler.run 200000
    machine.adb.keyboard.press 0x72
    scheduler.run 200000
    machine.adb.keyboard.press 0x7F
    scheduler.run 5000000
    # Picker shows two boot devices: ▣2 (floppy) and ▣3 (the parallel-port ProFile).
    check("goldens/lisa-xenix3.0-720x364x1-nofloppy-startupfrom.png")

    # === Apple-3 → select the ProFile (▣3); its on-disk loader boots ============
    machine.adb.keyboard.press 0xFF
    scheduler.run 200000
    machine.adb.keyboard.press 0xF2
    scheduler.run 200000
    machine.adb.keyboard.press 0x72
    scheduler.run 200000
    machine.adb.keyboard.press 0x7F
    # The ProFile's loader reaches its "boot :" prompt (default cmd: pf(0,0)xenix).
    scheduler.run 60000000

    # === Accept the loader default (pf(0,0)xenix) and boot ======================
    # Dummy Return first clears the loader's COPS state-3, then Return boots the
    # kernel off the ProFile.  Completing the read depends on the deferred BSY/CA1
    # data-ready edge (lisa_profile.c pro_complete); without it this hangs forever.
    machine.adb.keyboard.press 0xC8
    scheduler.run 300000
    machine.adb.keyboard.press 0x48
    scheduler.run 5000000
    machine.adb.keyboard.press 0xC8
    scheduler.run 300000
    machine.adb.keyboard.press 0x48

    # Xenix boots to its multi-user startup prompt ("Type CONTROL-d to proceed with
    # normal startup, / or give root password for system maintenance").
    scheduler.run 120000000
    check("goldens/lisa-xenix3.0-720x364x1-startup.png")
    report_perf("suite-lisa/lisa-xenix-nofloppy", scheduler.instr_count)
}

def row_xl_macworks_boot() {
    machine.boot model="macxl" ram=1024 rom="../../data/roms/macxl-3a-094c82f0.rom"
    machine.floppy.drive[0].insert "../../data/Lisa/MacWorksXL/MacWorksXL_3.0_May1985.dc42"
    # Integration test: Macintosh XL — MacWorks XL boot to the Finder desktop.
    #
    # MacWorks XL ships as a two-disk set.  The loader disk (inserted via config.mk)
    # brings up the Mac environment on the Lisa hardware, then EJECTS itself (the
    # 6504A "unclamp" command — the Lisa drive is software-eject) and the Mac ROM
    # sits on its blinking-"?" disk, waiting for a system disk.  We drive that the
    # way a person would: run until the drive is empty, then insert the system disk.
    # Inserting raises the controller's disk-insertion interrupt (FDIR/IPL 1), the
    # Mac ROM re-reads the new disk, finds a valid boot block, and boots its System
    # and Finder.  Nothing special triggers the boot — just the plain insert.

    # Run until MacWorks has loaded and ejected the loader disk (drive empty).
    scheduler.run 200000000

    assert machine.id == "macxl" "machine.id != macxl"
    assert machine.rom.checksum == "094C82F0" "rom.checksum != 094C82F0"
    # Macintosh XL screen-modification raster (square pixels), not the Lisa 2's 720x364.
    assert machine.screen.width == 608 "screen.width != 608"
    assert machine.screen.height == 431 "screen.height != 431"
    # The loader disk has ejected itself and the machine is waiting for a system disk.
    assert machine.floppy.drive[0].present == false "loader disk should have ejected"

    # Insert the MacWorks XL system disk, as a user would at the "?" prompt.
    machine.floppy.drive[0].insert "../../data/Lisa/MacWorksXL/MacWorksXL_Sys_Disk.dc42"
    assert machine.floppy.drive[0].present == true "system disk should be inserted"

    # Boot the Mac System + Finder from the system disk.
    scheduler.run 550000000

    # Verify the Finder desktop: menu bar (File/Edit/View/Special), the open
    # "MacWorks System Disk" window with its icons, the Trash, and the gray desktop.
    check("goldens/xl-macworks3.0-608x431x1-finder.png")
    report_row("MacWorks 3.0", "builtin", "fd-boot loader-eject")
    report_perf("suite-lisa/xl-macworks-boot", scheduler.instr_count)
}

def row_xl_no_media() {
    machine.boot model="macxl" ram=1024 rom="../../data/roms/macxl-3a-094c82f0.rom"
    # Integration test: Macintosh XL — no startup device ("insert a diskette" prompt).
    #
    # Start the Macintosh XL with nothing to boot from: no floppy in the drive and no
    # ProFile on the parallel port.  The "3A" boot ROM runs its startup-device scan,
    # the Sony floppy controller reports DRVERR ("no disk in drive"), and the ROM
    # settles on its no-media prompt — a disk-drive icon with an insert arrow and the
    # drive id (2 = the internal upper Sony), with NO numeric error code, over the
    # CONTINUE (Cmd-2) and STARTUP FROM... (Cmd-3) recovery buttons.  This is the
    # no-media counterpart to xl-boot: same hardware and ROM, but with the media
    # removed, so the ROM asks for a diskette instead of handing off to MacWorks XL.
    #
    # (An empty drive must report DRVERR/$07, not $16 = clamp error — the latter is an
    # I/O-board fault the ROM would paint as a crossed I/O-board icon.  See
    # src/machines/lisa/lisa_fdc.c, fdc_execute_rwts.)

    # Confirm we are on the Macintosh XL, on the "3A" boot ROM, before there is any media.
    assert machine.id == "macxl" "machine.id != macxl"
    assert machine.rom.checksum == "094C82F0" "rom.checksum != 094C82F0"
    # Macintosh XL screen-modification raster (square pixels), not the Lisa 2's 720x364.
    assert machine.screen.width == 608 "screen.width != 608"
    assert machine.screen.height == 431 "screen.height != 431"
    # Nothing to boot from: the drive is empty and no ProFile is attached.
    assert machine.floppy.drive[0].present == false "no floppy should be present"
    assert machine.hd.present == false "no ProFile should be attached"

    # Let the boot ROM run its startup scan and give up.  The prompt renders and stays
    # put (a static idle loop) well before this budget; it is stable through 300M+
    # instructions, so 120M leaves a comfortable margin while staying cheap.
    scheduler.run 120000000

    # The "insert a diskette" prompt: disk-drive icon + insert arrow + drive id 2, no
    # error code, with the CONTINUE and STARTUP FROM... buttons.  Pixel-exact match.
    check("goldens/xl-608x431x1-no-media.png")
    report_perf("suite-lisa/xl-no-media", scheduler.instr_count)
}
