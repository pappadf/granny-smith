# Default configurations boot (see config.mk).

# Boot `model` from `rom` with its default configuration and run `n`
# instructions: the storage the default document names, a screen, pixels.
def default_boots(model, rom, n) {
    machine.boot model="${$model}" rom="../../data/roms/${$rom}"
    assert machine.id == $model "${$model}: not built"
    let want = len(catalog.default_config($model).storage)
    assert len(machine.storage) == $want "${$model}: ${len(machine.storage)} storage devices, the default document has ${$want}"
    scheduler.run $n
    assert machine.screen.width > 0 "${$model}: no screen"
    assert machine.screen.checksum() != 0 "${$model}: nothing drawn after ${$n} instructions"
}

default_boots("plus", "plus-v3-4d1f8172.rom", 20000000)
default_boots("se30", "iix-iicx-se30-97221136.rom", 40000000)
default_boots("iix", "iix-iicx-se30-97221136.rom", 40000000)
