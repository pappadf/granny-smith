# AV family suite — Quadra 840AV (Cyclone) and Centris/Quadra 660AV (Tempest).
#
# Row map:
#
#   av-identity     Both models come up on the shared 2 MB ROM and identify
#                   themselves through the YMCA machine-ID straps ($F vs $B)
#                   without entering the ROM's UnknownCPU self-loop, with the
#                   660AV's missing-MUNI bus-error path exercised.  ROM only —
#                   no media, so this row always runs.
#   av-ram-sizing   YMCA two-pass RAM sizing across the bank arrangements
#                   (8/16/32 MB), read back from the live MemTop.  ROM only.
#   av-video        CIVIC + Sebastian bring-up: the ROM's slot PrimaryInit
#                   senses the Hi-Res monitor, programs the timing generator
#                   and paints the gray boot pattern into CIVIC VRAM.  The
#                   assertions are the hardware truths (geometry, ScrnBase
#                   inside the VRAM aperture) — no golden, no media.
#   av-cd-device    The plug contract for the boot medium: a read-only,
#                   CD-typed device answering at ID 3 with the block size
#                   adopted from the disc's own Driver Descriptor Map.
#   q840av-71-cd-desktop  840AV boots System 7.1 + System Enabler 088 from
#                   the CD to the Finder desktop; hardware truths first, then
#                   the byte-exact golden.
#   q660av-71-cd-desktop  Same for the 660AV.
#
# Every row gates on have_media() and echoes "skip:" while its data is
# absent (proposal-quadra-av.md §5.2 — the landable-before-data pattern):
# the ROM-only rows need roms/q840av-q660av-5bf10fd1.rom, and the boot rows
# additionally need the small AV boot disk.  Both are pending the
# gs-test-data push; the boot rows' matrix cells carry media_gated: true
# until then.  The bring-up asset that proves the path today is the
# dossier's 245 MB Install-Me-First image, which stays local by design and
# is never a CI dependency.

include "../lib/mac.script"

let av_rom = "../../data/roms/q840av-q660av-5bf10fd1.rom"
let av_cd = "../../data/systems/system_7_1_20mb_av_cd.img"

# ---- av-identity ------------------------------------------------------------
# The ROM reads the CPU-ID register ($5FFFFFFC = $A55A2830, and must NOT be
# writable) and then the four YMCA strap registers, whose assembled nibble
# selects the ProductInfo.  A mismatch sends the ROM into `UnknownCPU: bra.s
# UnknownCPU` — an infinite loop with no other symptom — so "the machine is
# still executing ROM after POST" IS the identity assertion.
def row_av_identity() {
    machine.boot model="q840av" ram=16384 rom="${$av_rom}"
    scheduler.run 30000000
    assert machine.id == "q840av" "av-identity: machine.id != q840av"
    # $A55A2830 for every AV machine, and the ROM tests write-protection.
    assert machine.memory.peek.l(0x5FFFFFFC) == 0xA55A2830 "av-identity: CPU-ID is ${machine.memory.peek.l(0x5FFFFFFC):08x}, want A55A2830"
    machine.memory.poke.l 0x5FFFFFFC 0
    assert machine.memory.peek.l(0x5FFFFFFC) == 0xA55A2830 "av-identity: CPU-ID register is writable — GetCPUIDReg rejects the machine"
    # Strap nibble $F (Cyclone40): bit 31 of each of CPUID0..3.
    assert machine.memory.peek.l(0x50F30438) >= 0x80000000 "av-identity: 840AV strap 0 low"
    assert machine.memory.peek.l(0x50F3043C) >= 0x80000000 "av-identity: 840AV strap 1 low"
    assert machine.memory.peek.l(0x50F30440) >= 0x80000000 "av-identity: 840AV strap 2 low"
    assert machine.memory.peek.l(0x50F30444) >= 0x80000000 "av-identity: 840AV strap 3 low"
    # Past POST and running: not stuck in the UnknownCPU self-loop.
    assert machine.cpu.pc >= 0x40800000 "av-identity: 840AV PC ${machine.cpu.pc:08x} outside ROM"
    assert machine.cpu.instr_count > 20000000 "av-identity: 840AV made no progress"

    machine.boot model="q660av" ram=16384 rom="${$av_rom}"
    scheduler.run 30000000
    assert machine.id == "q660av" "av-identity: machine.id != q660av"
    # Strap nibble $B (Tempest25) = %1011: strap 2 is the low one.
    assert machine.memory.peek.l(0x50F30438) >= 0x80000000 "av-identity: 660AV strap 0 low"
    assert machine.memory.peek.l(0x50F3043C) >= 0x80000000 "av-identity: 660AV strap 1 low"
    assert machine.memory.peek.l(0x50F30440) < 0x80000000 "av-identity: 660AV strap 2 high — that is a Cyclone nibble"
    assert machine.memory.peek.l(0x50F30444) >= 0x80000000 "av-identity: 660AV strap 3 low"
    assert machine.cpu.pc >= 0x40800000 "av-identity: 660AV PC ${machine.cpu.pc:08x} outside ROM"
    assert machine.cpu.instr_count > 20000000 "av-identity: 660AV made no progress"
    # A 660AV without the NuBus adapter has no MUNI: the ROM's TestForMUNI
    # probe must bus-error rather than read a value, which is what clears
    # MUNIExists.  The boot above already ran that probe — reaching here at
    # all means the fault was taken and handled.
    report_perf("suite-av/av-identity", scheduler.instr_count)
}

# ---- av-ram-sizing ----------------------------------------------------------
# YMCA's two-pass sizer (standard then "wide" mode, larger result per bank)
# runs against the eight 16 MB-spaced banks.  MemTop is what it concluded.
def row_av_ram_sizing() {
    machine.boot model="q840av" ram=8192 rom="${$av_rom}"
    scheduler.run 120000000
    assert debug.mac.globals.read("MemTop") == 0x800000 "av-ram-sizing: 8 MB sized as ${debug.mac.globals.read("MemTop"):08x}"

    machine.boot model="q840av" ram=16384 rom="${$av_rom}"
    scheduler.run 200000000
    assert debug.mac.globals.read("MemTop") == 0x1000000 "av-ram-sizing: 16 MB sized as ${debug.mac.globals.read("MemTop"):08x}"

    machine.boot model="q660av" ram=32768 rom="${$av_rom}"
    scheduler.run 400000000
    assert debug.mac.globals.read("MemTop") == 0x2000000 "av-ram-sizing: 32 MB sized as ${debug.mac.globals.read("MemTop"):08x}"
    report_perf("suite-av/av-ram-sizing", scheduler.instr_count)
}

# ---- av-video ---------------------------------------------------------------
# CIVIC/Sebastian bring-up, ROM only.  The ROM's slot PrimaryInit drives the
# sense lines, finds the Hi-Res monitor, programs the bit-serial timing
# registers and paints the gray boot pattern.  ScrnBase landing inside the
# CIVIC VRAM aperture is the proof that QuickDraw is drawing at the frame
# buffer this family actually scans out.
def row_av_video() {
    machine.boot model="q840av" ram=16384 rom="${$av_rom}"
    scheduler.run 400000000
    assert machine.screen.width == 640 "av-video: width ${machine.screen.width}, want 640"
    assert machine.screen.height == 480 "av-video: height ${machine.screen.height}, want 480"
    let scrn = debug.mac.globals.read("ScrnBase")
    assert $scrn >= 0x50100000 "av-video: ScrnBase ${$scrn:08x} below the CIVIC VRAM aperture"
    assert $scrn < 0x50300000 "av-video: ScrnBase ${$scrn:08x} above the CIVIC VRAM aperture"
    # Something was actually painted: a blank framebuffer checksums as the
    # all-zero screen every model produces before video comes up.
    assert machine.screen.checksum() != 0 "av-video: framebuffer never written"
    report_perf("suite-av/av-video", scheduler.instr_count)
}

# ---- av-cd-device -----------------------------------------------------------
# The plug contract, no boot: what the guest sees on the bus.  read_only is
# what makes this a locked-volume boot, and block_size comes from the disc's
# own Driver Descriptor Map rather than a hard-coded CD default.
def row_av_cd_device() {
    machine.boot model="q840av" ram=16384 rom="${$av_rom}"
    machine.scsi.attach_cdrom "${$av_cd}" 3
    assert machine.scsi.device[3].type == "cdrom" "av-cd-device: SCSI 3 is not a CD-ROM"
    assert machine.scsi.device[3].read_only "av-cd-device: CD-ROM is not read-only"
    assert machine.scsi.device[3].medium_present "av-cd-device: no medium present"
    assert machine.scsi.device[3].block_size == 512 "av-cd-device: block_size ${machine.scsi.device[3].block_size}, want 512 (from the disc's DDM)"
    # Nothing else on the bus: any boot below can only come from the disc.
    assert try(machine.scsi.device[0].type, none) == none "av-cd-device: something is attached at SCSI 0"
}

# ---- q840av-71-cd-desktop ---------------------------------------------------
# The deliverable: System 7.1 + System Enabler 088 from a read-only CD to the
# Finder desktop on a Quadra 840AV.  The enabler is not optional — its `gbly`
# gates on machine IDs 72 and 54, so a stock 7.1 volume will not boot this
# machine at all.
#
# Hardware truths BEFORE the golden (the empty-screen-trap defense): a blank
# screen can match a blank golden, so the facts that prove a System is running
# are asserted first and the pixels only confirm what it drew.
def row_q840av_71_cd_desktop() {
    machine.rtc.time = 3000000000
    machine.boot model="q840av" ram=16384 rom="${$av_rom}"
    machine.scsi.attach_cdrom "${$av_cd}" 3
    scheduler.run 400000000
    scheduler.run 1000000000

    assert machine.id == "q840av" "q840av-cd: machine.id != q840av"
    assert debug.mac.globals.read("BootDrive") != 0 "q840av-cd: BootDrive is 0 — nothing booted"
    assert debug.mac.globals.read("SysMap") != 0 "q840av-cd: SysMap unset — no System file opened"
    assert debug.mac.globals.read("ApplZone") != debug.mac.globals.read("SysZone") "q840av-cd: ApplZone == SysZone — no application heap, the Finder never launched"
    assert debug.mac.globals.read("Ticks") > 10000 "q840av-cd: only ${debug.mac.globals.read("Ticks")} ticks — System not running"
    assert machine.scsi.device[3].read_only "q840av-cd: device stopped being read-only"

    check("goldens/q840av-7.1-640x480x8-cd-finder.png")
    report_row("7.1", "civic", "cdrom-boot")
    report_perf("suite-av/q840av-71-cd-desktop", scheduler.instr_count)
}

# ---- q660av-71-cd-desktop ---------------------------------------------------
# The same volume on the sibling board: 25 MHz, strap nibble $B, and no MUNI.
def row_q660av_71_cd_desktop() {
    machine.rtc.time = 3000000000
    machine.boot model="q660av" ram=16384 rom="${$av_rom}"
    machine.scsi.attach_cdrom "${$av_cd}" 3
    scheduler.run 400000000
    scheduler.run 1000000000

    assert machine.id == "q660av" "q660av-cd: machine.id != q660av"
    assert debug.mac.globals.read("BootDrive") != 0 "q660av-cd: BootDrive is 0 — nothing booted"
    assert debug.mac.globals.read("SysMap") != 0 "q660av-cd: SysMap unset — no System file opened"
    assert debug.mac.globals.read("ApplZone") != debug.mac.globals.read("SysZone") "q660av-cd: ApplZone == SysZone — no application heap, the Finder never launched"
    assert debug.mac.globals.read("Ticks") > 10000 "q660av-cd: only ${debug.mac.globals.read("Ticks")} ticks — System not running"

    check("goldens/q660av-7.1-640x480x8-cd-finder.png")
    report_row("7.1", "civic", "cdrom-boot")
    report_perf("suite-av/q660av-71-cd-desktop", scheduler.instr_count)
}

# --- row calls ---------------------------------------------------------------

if row_on("av-identity") {
    if have_media($av_rom) {
        row_end("av-identity", try(row_av_identity(), "FAILED"))
    } else {
        echo "skip: av-identity — ${$av_rom} not fetched"
    }
}
if row_on("av-ram-sizing") {
    if have_media($av_rom) {
        row_end("av-ram-sizing", try(row_av_ram_sizing(), "FAILED"))
    } else {
        echo "skip: av-ram-sizing — ${$av_rom} not fetched"
    }
}
if row_on("av-video") {
    if have_media($av_rom) {
        row_end("av-video", try(row_av_video(), "FAILED"))
    } else {
        echo "skip: av-video — ${$av_rom} not fetched"
    }
}

# The boot rows additionally need the small AV boot disk.
if row_on("av-cd-device") {
    if have_media($av_rom) && have_media($av_cd) {
        row_end("av-cd-device", try(row_av_cd_device(), "FAILED"))
    } else {
        echo "skip: av-cd-device — ${$av_cd} not fetched"
    }
}
if row_on("q840av-71-cd-desktop") {
    if have_media($av_rom) && have_media($av_cd) {
        row_end("q840av-71-cd-desktop", try(row_q840av_71_cd_desktop(), "FAILED"))
    } else {
        echo "skip: q840av-71-cd-desktop — ${$av_cd} not fetched"
    }
}
if row_on("q660av-71-cd-desktop") {
    if have_media($av_rom) && have_media($av_cd) {
        row_end("q660av-71-cd-desktop", try(row_q660av_71_cd_desktop(), "FAILED"))
    } else {
        echo "skip: q660av-71-cd-desktop — ${$av_cd} not fetched"
    }
}

suite_done()
quit
