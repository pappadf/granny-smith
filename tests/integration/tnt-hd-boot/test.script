# TNT MESH disk boot (see config.mk) — the Phase-E frontier row.
#
# Same discipline as the ladder: clean bounded runs, no PC logpoints,
# assertions read state afterward.

include "../lib/mac.script"

machine.boot model="pm7500" ram=32768 rom="${$ROM}"
machine.scsi.attach_hd "$WORK_DIR/hd.img" 0

# Through OF, POST, the 68k boot, the gray desktop (T11), the SCSI scan
# (complete MESH transactions against the disk), driver-partition load
# and the boot-volume mount.  BootDrive lands well before 900M; the
# budget reaches the stable splash screen.
scheduler.run 1100000000

# The boot-driver selection matched (XPRAM $77 "Default OS" = 1 through
# the banked NVRAM against the DDM's ddType) and the volume mounted:
# BootDrive carries the boot drive number instead of the scan's $FFFF.
assert debug.mac.globals.read("BootDrive") == 0x8003 "BootDrive not set (driver match / mount failed)"

# The System reached its startup screen: the "Mac OS" splash drawn over
# the T11 desktop.  The golden deliberately INCLUDES the system-error
# dialog of the current frontier (the disk driver's data-phase arming —
# config.mk): when that falls, REGEN moves this golden forward.
check("macos-splash.png")

echo "tnt-hd-boot: BootDrive=${debug.mac.globals.read("BootDrive"):04x} dserr=${debug.mac.globals.read("DSErrCode"):04x} ticks=${debug.mac.globals.read("Ticks")}"
quit
