# debug.frame's contract, per CPU family: the architecture tag, a register
# file whose pc is the CPU's, a window whose first row is the PC, and, with
# before=N, a window re-synchronised so its row N is exactly the PC (68K
# instructions are 2-20 bytes, so decoding from an arbitrary earlier address
# can step over the PC).

def check_frame(arch) {
    scheduler.run 3000000
    let f = debug.frame(count=4)
    assert $f.arch == $arch "frame arch"
    assert $f.pc == machine.cpu.pc "frame pc is the CPU's"
    assert $f.regs.pc == machine.cpu.pc "regs.pc is the CPU's"
    assert len($f.rows) == 4 "row count"
    assert $f.rows[0].addr == machine.cpu.pc "first row is the PC"
    let g = debug.frame(count=8, before=3)
    assert $g.rows[3].addr == machine.cpu.pc "before=3 puts the PC on row 3"
    assert machine.cpu.instr_count > 0 "instr_count on every architecture"
    # machine.cpu.frame is the same call.
    let c = machine.cpu.frame(count=4)
    assert $c.arch == $arch "machine.cpu.frame arch"
    assert $c.rows[0].addr == $f.rows[0].addr "machine.cpu.frame is debug.frame"
}

# The typed translate/peek every MMU kind has: the frame's row
# translation agrees with translate(), and a logical read equals a physical
# read of the translated address (`physical_ok` false on the Lisa, whose
# three physical spaces a bare address cannot name).
def check_mmu(physical_ok) {
    let pc = machine.cpu.pc
    let t = machine.cpu.mmu.translate($pc)
    assert $t.valid "the PC translates"
    assert $t.phys == debug.frame(count=1).rows[0].phys "frame rows use the same translation"
    assert machine.cpu.mmu.translate($pc, fetch=true).valid "fetch-side translation"
    if $physical_ok {
        assert machine.cpu.mmu.peek($pc, 4) == machine.cpu.mmu.peek($t.phys, 4, "physical") "logical == physical at the translation"
    } else {
        assert try(machine.cpu.mmu.peek($pc, 4, "physical"), none) == none "physical refused"
        assert machine.cpu.mmu.peek($pc, 2) == machine.memory.peek.w($pc) "logical peek"
    }
}

# 68000 (the startup machine from TEST_ROM).
check_frame("m68k")
assert debug.frame(count=1).regs.d0 == machine.cpu.d0 "68K register names"

# Lisa: 68000 behind the segment MMU.
machine.boot model="lisa" rom="../../data/roms/lisa2-revh-098917b2.rom"
check_frame("m68k")
check_mmu(false)
assert machine.cpu.mmu.translate(machine.cpu.pc).via == "segment" "the segment MMU, not identity"
assert machine.cpu.mmu.context >= 0 "the Lisa MMU node exists"

# 68030 with PMMU and FPU.
machine.boot model="se30" rom="../../data/roms/iix-iicx-se30-97221136.rom"
check_frame("m68k")
assert len(debug.frame(count=1).fpu.fp) == 8 "68882 register file"
check_mmu(true)

# 68040.
machine.boot model="q700" rom="../../data/roms/q700-q900-420dbff3.rom"
check_frame("m68k")
check_mmu(true)

# PowerPC 601: before, debug.frame returned "CPU not initialised" here.
machine.boot model="pm7100" rom="../../data/roms/pm6100-pm7100-pm8100-9feb69b3.rom"
check_frame("ppc")
assert debug.frame(count=1).regs.r1 == machine.cpu.r1 "PPC register names"
assert len(debug.frame(count=1).fpu.fpr) == 32 "PPC FPU register file"
check_mmu(true)

# PowerPC 604.
machine.boot model="pm8500" rom="../../data/roms/pm7500-pm8500-pm9500-96cd923d.rom"
check_frame("ppc")
check_mmu(true)

# The DSP3210 on an AV machine answers the same frame contract: its own
# architecture tag, register file and disassembly, and its accumulators as
# the floating-point block.
machine.boot model="q840av" ram=16384 rom="../../data/roms/q840av-q660av-5bf10fd1.rom"
check_frame("m68k")
let d = machine.dsp.frame(count=4)
assert $d.arch == "dsp3210" "dsp frame arch"
assert $d.pc == machine.dsp.pc "dsp frame pc"
assert $d.regs.pc == machine.dsp.pc "dsp regs.pc"
assert $d.regs.emr == machine.dsp.emr "dsp register names"
assert len($d.rows) == 4 "dsp row count"
assert $d.rows[0].addr == machine.dsp.pc "dsp first row is its pc"
assert $d.rows[1].addr == machine.dsp.pc + 4 "dsp instructions are 4 bytes"
assert len($d.fpu.a) == 4 "dsp accumulators"
assert machine.dsp.disasm(count=2) "dsp.disasm prints and answers true"

echo "debug-frame-ok"
quit
