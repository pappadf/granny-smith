# The 3dfx Voodoo2 (CVG) enumerating in socket A1 of a Power Macintosh
# 7500 — the first ROM-less socket card (proposal-pci-3dfx-voodoo2, 3b).
#
# THE ACCEPTANCE SHAPE IS APPLE'S OWN SPECIFICATION of a card with no
# expansion ROM ("Designing PCI Cards and Drivers", revised 1999):
#
#   "Open Firmware queries PCI cards that contain no FCode and creates
#    basic node entries ... only the properties that can be generated by
#    accessing a card's standard PCI configuration registers" (p.91)
#   "Bit 1, Memory Space Enable, is cleared to 0 for all devices before
#    an operating system is loaded" (p.97)
#   the generated name is `pci121a,2` — lower-case, no leading zeros
#    (p.164), from vendor $121A / device $0002 with ZERO subsystem IDs
#    (p.100 — a nonzero subsystem renames the node and the driver's
#    match silently misses)
#
# Where the emulator cannot read the guest's OF tree directly, the
# register state is the proxy — the tree is DERIVED from it.
#
# Config-port note (the tnt-pci-mach64 idiom): Bandit 1's address/data
# ports are LITTLE-ENDIAN and machine.memory.peek/poke are raw
# big-endian bus views, so literals go through swap32.  Socket A1 is
# device 13: one-hot IDSEL $00200000.

def swap32(v) {
    return (($v & 0xFF) << 24) | (($v & 0xFF00) << 8) | (($v >> 8) & 0xFF00) | (($v >> 24) & 0xFF)
}
def swap16(v) {
    return (($v & 0xFF) << 8) | (($v >> 8) & 0xFF)
}
def cfg_wr(reg, val) {
    machine.memory.poke.l(0xF2800000, swap32(0x00002000 | $reg))
    machine.memory.poke.l(0xF2C00000, swap32($val))
    machine.memory.poke.l(0xF2800000, 0)
}
def cfg_rd(reg) {
    machine.memory.poke.l(0xF2800000, swap32(0x00002000 | $reg))
    let v = swap32(machine.memory.peek.l(0xF2C00000))
    machine.memory.poke.l(0xF2800000, 0)
    return $v
}

# --- The kind is registered and seatable with no machine edit. --------------
assert machine.pci.cards() == "[tnt_control, mach64_gx, cirrus_54m30, sym53c825_0, sym53c825_1, voodoo2]" "the card must be registered"

machine.boot model="pm7500" ram=32768 rom="${$ROM}" pci_card="voodoo2"
assert machine.pci.slot[1].label == "A1" "the card sits in socket A1"
assert machine.pci.slot[1].card.name == "3dfx Voodoo2" "the card is seated"

# --- The type-0 header, before a single instruction runs. -------------------
assert cfg_rd(0x00) == 0x0002121A "vendor $121A / device $0002 — the halves of the generated node name pci121a,2"
assert cfg_rd(0x08) == 0x03800002 "class $038000 (display/other), revision $02 (pinned for Voodoo1 compat)"
assert (cfg_rd(0x3C) & 0x0000FF00) == 0x00000100 "interrupt pin 1 = INTA#"
assert machine.pci.slot[1].card.config.status == 0x0200 "medium DEVSEL"

# BAR0 sizes as 16 MB PREFETCHABLE memory — the universal $FFFFFFFF
# probe; only bits 31:24 are writable and bit 3 reads back set.
cfg_wr(0x10, 0xFFFFFFFF)
assert cfg_rd(0x10) == 0xFF000008 "BAR0: 16 MB, memory, prefetchable"
cfg_wr(0x10, 0x00000000)
# There is exactly ONE BAR.  The others read zero — the device exists,
# so they are "not implemented", never all-ones.
cfg_wr(0x14, 0xFFFFFFFF)
assert cfg_rd(0x14) == 0x00000000 "no BAR1"
cfg_wr(0x18, 0xFFFFFFFF)
assert cfg_rd(0x18) == 0x00000000 "no BAR2"
cfg_wr(0x24, 0xFFFFFFFF)
assert cfg_rd(0x24) == 0x00000000 "no BAR5"
# NO expansion ROM: the ROM BAR reads zero even after a sizing write.
# This is the mechanism of the whole design — no ROM, no FCode, a
# generated node (Apple p.88/p.91).
cfg_wr(0x30, 0xFFFFFFFF)
assert cfg_rd(0x30) == 0x00000000 "the ROM BAR reads zero — no expansion ROM exists"
# THE SUBSYSTEM TRAP, pinned so a well-meaning later change cannot
# silently rename the guest's node (Apple p.100).
assert cfg_rd(0x2C) == 0x00000000 "subsystem vendor/device MUST read zero"

# The vendor block answers before the aperture exists: cfgStatus at $4C
# aliases the memory-mapped status register (V2 §6.18), which is exactly
# what lets a driver poll before mapping.
assert (cfg_rd(0x4C) & 0x3F) == 0x3F "cfgStatus: the PCI FIFO reads empty through config space"
assert (cfg_rd(0x4C) & 0x380) == 0 "cfgStatus: every busy bit reads idle"
cfg_wr(0x50, 0xC0FFEE00)
assert cfg_rd(0x50) == 0xC0FFEE00 "cfgScratch is a pure scratchpad"
# The undocumented offsets sstfb pokes must not fault (both specs call
# $58-$FF reserved; we model no behaviour we cannot describe).
cfg_wr(0xC0, 0x00000001)
cfg_wr(0xE0, 0x00000001)
assert cfg_rd(0xC0) == 0x00000000 "reserved config space reads zero and swallows writes"

# --- The guest's own firmware enumerates the card. --------------------------
# Open Firmware probes Bandit 1, sizes BAR0 and assigns it inside the
# $80000000 window — and, this being a ROM-less card, loads NO driver
# and leaves Memory Space Enable CLEAR (Apple p.97).  Nothing below is
# emulator behaviour: it is the guest's firmware doing the enumerating.
scheduler.run 400000000
assert machine.pci.slot[1].card.config.bar[0].base == 0x81000000 "OF assigns BAR0 inside Bandit 1's window"
assert (machine.pci.slot[1].card.config.command & 0x0002) == 0 "Memory Space Enable left CLEAR — no ROM, no driver, nobody set it"
assert !machine.pci.slot[1].card.config.bar[0].mapped "...so the card does not decode its aperture yet"

# --- The driver's first act: set Memory Space Enable itself. ----------------
# This is why the Glide library imports ExpMgrConfigWriteWord — the same
# write, made here through the config port, exactly as the driver would.
cfg_wr(0x04, cfg_rd(0x04) | 0x0002)
assert machine.pci.slot[1].card.config.bar[0].mapped "the aperture decodes once the driver enables memory space"
let BAR = machine.pci.slot[1].card.config.bar[0].base

def vreg_wr(off, val) {
    machine.memory.poke.l($BAR + $off, swap32($val))
}
def vreg_rd(off) {
    return swap32(machine.memory.peek.l($BAR + $off))
}
# The §12.3 idle idiom with a CEILING: the failure mode of a busy bit
# that never clears must be a test failure, not a hung suite.
def idle3() {
    let ok = 0
    let polls = 0
    while $ok < 3 {
        $polls = $polls + 1
        assert $polls < 50 "idle contract: status[9] must clear within a bounded number of polls"
        if (vreg_rd(0x000) & 0x380) == 0 {
            $ok = $ok + 1
        } else {
            $ok = 0
        }
    }
}

# --- The full Glide bring-up, replayed step by step. ------------------------
include "glide-init.script"

# --- Registers are 32-bit only; the wrap aliases are identical. -------------
# A halfword read of the register face answers all-ones rather than
# inventing a lane behaviour the spec does not define (V2 p.128 §12.2).
assert machine.memory.peek.w($BAR + 0x144) == 0xFFFF "narrow register access is not a defined bus behaviour"
# The wrap field (address 19:14) exists to defeat write-combining; all
# 64 aliases are the same map (V2 p.21).
assert vreg_rd(0x144) == vreg_rd(0x4144) "wrap alias +$4000 reaches the same register"
assert vreg_rd(0x144) == vreg_rd(0x144 + 0xFC000) "the last wrap alias reaches the same register"

# --- The texture aperture is write-only. ------------------------------------
machine.memory.poke.l($BAR + 0x800000, 0x11223344)
assert machine.memory.peek.l($BAR + 0x800000) == 0xFFFFFFFF "texture reads return undefined (all-ones) data"

# --- The memory option: 8 MB and 12 MB boards. ------------------------------
# Both SKUs carry the same 4 MB framebuffer (both reach 800x600); the
# option changes texture capacity only.  The guest-visible TMU probe
# renders through the texture pipeline and lands with the rasteriser
# milestone; the configured capacity is asserted through the card node.
assert machine.pci.slot[1].card.regs.fb_size == 0x400000 "4 MB framebuffer"
assert machine.pci.slot[1].card.regs.tmu_size == 0x200000 "8 MB board: 2 MB per TMU is the default"
machine.boot model="pm7500" ram=32768 rom="${$ROM}" pci_card="voodoo2" pci_option="memory=12m"
assert machine.pci.slot[1].card.regs.tmu_size == 0x400000 "12 MB board: 4 MB per TMU by option"
assert machine.pci.slot[1].card.regs.fb_size == 0x400000 "...same 4 MB framebuffer either way"

# The card declares the option so a frontend can offer it without
# knowing which card this is.
assert machine.profile("pm7500").pci_slots[0].cards[1].options[0].key == "memory" "the card declares its option"
assert machine.profile("pm7500").pci_slots[0].cards[1].options[0].default_value == "8m" "...and its default"

# --- The positive control: an EMPTY slot reads all-ones. --------------------
# No "the card enumerated" assertion above is trusted until its negative
# has been seen (the §9.2 instrument discipline).
machine.boot model="pm7500" ram=32768 rom="${$ROM}"
assert cfg_rd(0x00) == 0xFFFFFFFF "an empty A1 reads all-ones"
assert cfg_rd(0x2C) == 0xFFFFFFFF "...including the subsystem registers"

quit
