include "../lib/mac.script"
let sys_701 = "../../data/systems/System_7_0_1.image"
def probe(label, v) {
    machine.boot model="iifx" ram=16384 video_card="mdc_8_24" rom="${$ROM}"
    machine.rtc.pram.validate
    machine.rtc.pram.poke 0x8a $v
    machine.floppy.drive[0].insert "${$sys_701}"
    scheduler.run 200000000
    wait_stable(900000000)
    echo "RESULT $8A=${$label}: MMU32bit=${debug.mac.globals.read("MMU32bit")}"
}
probe("01", 0x01:1)
probe("04", 0x04:1)
quit
