# The tnt-voodoo2-glide flow, as two functions: tnt-voodoo2-glide runs them
# back to back, tnt-voodoo2-glide-sw plays the second from a checkpoint.

# Boot Mac OS 8.1 with the Voodoo2 on backend `raster` and launch Quake 3Dfx
# from the Finder: on return the launch is in the guest's queue.
def glide_to_launch(raster) {
    # The 8 MB board: the golden was captured on it (texture memory size
    # changes where Glide places textures, so the command stream).
    machine.boot model="pm7500" ram=65536 rom="${$ROM}" pci_card="voodoo2" pci_option="raster=${$raster},memory=8m"
    assert machine.pci.slot[1].card.regs.raster == $raster "the requested raster backend is installed"
    machine.rtc.time = "2026-04-26T21:30:36"
    machine.scsi.attach_hd "${$img}" 0

    # Mac OS 8.1 to the Finder with the ROM-less card seated the whole way.
    scheduler.run 2600000000
    assert debug.mac.globals.read("BootDrive") == 0x8023 "BootDrive not set (driver match / mount failed)"
    assert debug.mac.globals.read("DSErrCode") == 0 "system error during startup"

    # --- Exactly ONE 3DfxGlideLib2.x fragment is registered. --------------------
    # The Quake CD ships a Voodoo1-era library under the SAME fragment name;
    # with both installed CFM may bind Glide to the library that cannot see
    # a Voodoo2, and the failure is silent.  The shipped image has the
    # collision removed; this pins it.  The CFM registry lives in the system
    # heap — one entry, holding the fragment name, in this window.
    assert len(debug.find.str("3DfxGlideLib2.x", 0x100000, 0x300000)) == 1 "exactly one 3DfxGlideLib2.x registration"
    # ...and registered-not-prepared: no Glide code is resident at boot
    # (nothing imports it until a client launches).
    assert len(debug.find.str("MacCheckBoardsInSystem", 0x0, 0x4000000)) == 0 "Glide code is not resident before a client runs"

    # The card is untouched: Mac OS loads no driver for a ROM-less card.
    assert machine.pci.slot[1].card.regs.init_enable == 0x00014000 "initEnable untouched before the client runs (rev 4 CVG, fab 1)"
    assert (machine.pci.slot[1].card.config.command & 0x0002) == 0 "Memory Space still clear — nobody enabled it"

    # --- Launch Quake 3Dfx from the Finder. -------------------------------------
    # Dismiss the image's dirty-shutdown notice and the Energy Saver
    # first-boot message (both close on Return), then navigate by
    # type-select + Cmd-O: volume -> Quake folder -> the app.
    # (Fixed budgets, not settle(): the Finder is still starting up behind
    # a desktop that holds still, and the notices come up inside them.)
    machine.adb.keyboard.press 0x24
    scheduler.run 300000000
    machine.adb.keyboard.press 0x24
    scheduler.run 300000000
    machine.adb.mouse.move 60 380 "global"
    scheduler.run 5000000
    machine.adb.mouse.click true
    scheduler.run 2000000
    machine.adb.mouse.click false
    scheduler.run 20000000
    machine.adb.keyboard.type "Macintosh HD"
    wait_keys_taken(100000000)
    settle(50000000)
    machine.adb.keyboard.down 0x37
    scheduler.run 2000000
    machine.adb.keyboard.press 0x1F
    scheduler.run 2000000
    machine.adb.keyboard.up 0x37
    wait_keys_taken(100000000)
    settle(200000000)
    machine.adb.keyboard.type "Quake"
    wait_keys_taken(100000000)
    settle(50000000)
    machine.adb.keyboard.down 0x37
    scheduler.run 2000000
    machine.adb.keyboard.press 0x1F
    scheduler.run 2000000
    machine.adb.keyboard.up 0x37
    wait_keys_taken(100000000)
    settle(200000000)
    machine.adb.keyboard.type "Quake 3Dfx"
    wait_keys_taken(100000000)
    settle(50000000)
    machine.adb.keyboard.down 0x37
    scheduler.run 2000000
    machine.adb.keyboard.press 0x1F
    scheduler.run 2000000
    machine.adb.keyboard.up 0x37
}

# From the launch: the driver's detection against the model, then the game,
# ending on the in-game frame `golden`; `perf_row` names the @@PERF record.
def glide_play(golden, raster, perf_row) {
    # Give the client its whole detection run: CFM prepares GlideLib2.x,
    # MacCheckBoardsInSystem walks the Name Registry, and
    # grSstQueryHardware drives the full bring-up and self-tests.
    scheduler.run 3500000000

    # --- The REAL driver drove the card. ----------------------------------------
    # (No string-residency check here: under the image's virtual memory the
    # library's loader strings need not be physically resident after the
    # prepare — the card state below is the evidence that it ran.)
    # It enabled Memory Space itself through the Expansion Manager
    # (Apple p.97: cleared before the OS loads; the driver's job)...
    assert (machine.pci.slot[1].card.config.command & 0x0002) != 0 "the driver enabled Memory Space itself"
    # ...opened both initEnable gates (fbiInit writes + PCI FIFO)...
    assert (machine.pci.slot[1].card.regs.init_enable & 0x3) == 0x3 "initEnable[1:0] opened by the driver"
    # ...enabled the PPC byte-swizzle register path, exactly as 3dfx said a
    # big-endian host should (V2 p.52)...
    assert (machine.pci.slot[1].card.regs.fbi_init0 & 0x8) != 0 "fbiInit0[3]: the PPC driver enabled byte swizzling"
    # ...enabled LFB reads for its memory probes...
    assert (machine.pci.slot[1].card.regs.fbi_init1 & 0x8) != 0 "fbiInit1[3]: LFB reads enabled"
    # ...detected the ICS5342 and — the query no longer stalls anywhere, so
    # by this point grSstWinOpen has already run — programmed the FULL
    # graphics clock (the 16 MHz bring-up clock was an earlier step of the
    # same guest-driven PLL sequence)...
    let GKHZ = machine.pci.slot[1].card.dac.graphics_khz
    assert $GKHZ > 40000 && $GKHZ < 60000 "the DAC runs the full graphics clock grSstWinOpen programmed"
    # ...and ran its render-based self-tests through the rasteriser: the
    # dither calibration (256 flat triangles, unique un-dither sums), the
    # TMU census (send-config triangles) and both TMUs' memory sensing.
    assert machine.pci.slot[1].card.regs.read(0x25C) > 200 "the driver's self-tests drew hundreds of triangles"
    assert machine.pci.slot[1].card.regs.read(0x15C) > 100000 "...and they filled pixels through the pipeline"
    # The idle contract held the whole way: every one of the driver's
    # unbounded status polls returned, or this row would never have reached
    # this line.
    assert (machine.pci.slot[1].card.regs.status & 0x380) == 0 "the card reports idle after the whole detection"

    echo "tnt-voodoo2-glide: grSstQueryHardware completed against the model (raster=${$raster})"

    # --- ...and then the game RENDERS. ------------------------------------------
    # Keep running to the same instruction count as the reference frame:
    # by now Quake has opened the screen (grSstWinOpen), taken over the
    # monitor, and is deep in its attract demo, drawing thousands of
    # textured triangles per frame through the CMDFIFO's setup path.
    scheduler.run 1300000000
    assert machine.pci.slot[1].card.video.drives_monitor "the Voodoo drives the monitor in-game (pass-through switched)"
    assert (machine.pci.slot[1].card.regs.read(0x24C) & 0x100) != 0 "fbiInit7[8]: the guest enabled the CMDFIFO"
    assert machine.pci.slot[1].card.regs.read(0x25C) > 1000000 "the demo pushed over a million setup-path submissions"
    assert machine.pci.slot[1].card.regs.read(0x15C) > 100000 "...rasterised through the pixel pipeline"
    # The frame itself: a lit, textured, mip-mapped, dithered in-game demo
    # frame — inspected by hand at capture (health 82, ammo 60, the full
    # status bar).  Deterministic: the whole launch is scripted and the
    # scheduler is instruction-exact.  (Played from a restored checkpoint
    # the demo is a few frames elsewhere at this count, so the -sw row's
    # golden is its own: see that row.)
    check($golden)
    report_perf($perf_row, scheduler.instr_count)

    echo "tnt-voodoo2-glide: Quake renders in-game frames through the model (raster=${$raster})"
}
