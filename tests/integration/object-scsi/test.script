# Integration: `scsi` object class.
# A SCSI HD image is attached at boot, so devices.N has at least one
# populated slot. We verify the path resolves, the bus phase enum
# reports a known phase, the device collection enumerates correctly
# (sparse semantics — empty IDs are holes), and the legacy loopback
# command shares state with scsi.loopback.

scheduler.run 50000

# Top-level object. Loopback default is false at boot.
machine.scsi
assert machine.scsi.loopback == false

# Bus child: phase is a VK_ENUM, target / initiator are ints. After a
# brief warmup the bus has settled back to bus_free.
machine.scsi.bus
assert machine.scsi.bus.phase == "bus_free"
machine.scsi.bus.target
machine.scsi.bus.initiator

# Devices collection — at least one populated slot from hd1.img.
machine.scsi.device
# Boot HD lands on SCSI id 0; assert the populated-slot attributes
# match the expected catalog entry for the test image.
assert machine.scsi.device[0].id == 0
assert machine.scsi.device[0].type == "hd"
assert machine.scsi.device[0].block_size == 512
assert machine.scsi.device[0].medium_present == true
assert machine.scsi.device[0].read_only == false
# hd1.img matches the HD20SC catalog entry. vendor / product are the
# raw SCSI INQUIRY fields stored on the device — vendor is the 8-char
# catalog literal " SEAGATE" (leading space); product_id is left-
# padded to 16 chars by scsi_attach (see scsi.c:1188).
assert machine.scsi.device[0].vendor == " SEAGATE" "boot HD vendor regressed"
assert machine.scsi.device[0].product == "ST225N          " "boot HD product regressed"

# Empty slot 5 (no CD attached) reports an "empty" error from node_get,
# which is the correct sparse-collection behavior.
assert try(machine.scsi.device[5], none) == none "empty slot 5 must read as an error"

# Loopback: flip via attr setter, observe via the same attr (round-trip
# through the same path the legacy `hd loopback` command writes).
machine.scsi.loopback = true
assert machine.scsi.loopback == true
machine.scsi.loopback = false
assert machine.scsi.loopback == false

# --- files.identify: which drives take a file ------------------------------
# The one identify the web2 upload pipeline gates on (lib/media.ts): a file
# dropped into the HD/CD slot must fit that kind of drive or the upload is
# rejected.  It answers for every kind of drive, not just SCSI's.
#
# HD: anything that opens and isn't floppy-sized; a fresh catalog-model
# image is the positive case, a blank 800K floppy the negative one.
assert files.hd_create("${$WORK_DIR}/ident-hd.img", "HD20SC") "hd_create failed"
assert files.fd_create("${$WORK_DIR}/ident-fd.img") "fd_create failed"
assert contains(files.identify("${$WORK_DIR}/ident-hd.img").fits, "hd") "HD image not identified as HD"
assert !contains(files.identify("${$WORK_DIR}/ident-fd.img").fits, "hd") "floppy wrongly identified as HD"
assert contains(files.identify("${$WORK_DIR}/ident-fd.img").fits, "floppy") "floppy not identified as a floppy"
assert files.identify("${$WORK_DIR}/ident-fd.img").floppy == "gcr800" "the blank floppy is an 800K GCR one"
let missing = files.identify("${$WORK_DIR}/does-not-exist.img")
assert !$missing.opens && len($missing.fits) == 0 "missing file identified as a disk"
# A disk smaller than the smallest floppy is no hard disk (S1018-26): a
# 32 KB PCI card ROM opens and is not floppy-sized, but is refused.
assert !contains(files.identify("../../data/roms/mach64-gx-104-437584e0.prom").fits, "hd") "a 32 KB card ROM identified as HD"
# The floor is the disk's size, not the file's: the UDIF of the blank 20 MB
# disk above is a few KB, and still a hard disk.
assert files.convert("${$WORK_DIR}/ident-hd.img", "${$WORK_DIR}/ident-hd.dmg") "convert to UDIF failed"
assert files.path_size("${$WORK_DIR}/ident-hd.dmg") < 409600 "the blank disk's UDIF is not smaller than a floppy"
assert contains(files.identify("${$WORK_DIR}/ident-hd.dmg").fits, "hd") "a compact UDIF of a 20 MB disk not identified as HD"

# CD-ROM: requires a recognised filesystem (ISO 9660 / HFS / APM). The
# retail A/UX install disc is the positive case; a blank (all-zero) HD
# image and a floppy are the negatives.
assert contains(files.identify("../../data/aux/aux_3.0.1/APPLE_AUX_3-0-1_RETAIL.iso").fits, "cd") "A/UX retail ISO not identified as CD-ROM"
assert !contains(files.identify("${$WORK_DIR}/ident-hd.img").fits, "cd") "blank HD image wrongly identified as CD-ROM"
assert !contains(files.identify("${$WORK_DIR}/ident-fd.img").fits, "cd") "floppy wrongly identified as CD-ROM"

# kind: what an upload of no stated kind (a drop, Load ROM) is filed as.  A
# CD-ROM only when it holds ISO 9660 (S1018-06): a partitioned or bare HFS
# disk fits a CD-ROM drive (the CD-ROM section's own Add takes it as a disc)
# but holds no ISO 9660, so a drop files it as a hard disk -- the A/UX disc,
# all partition map, too.  The ISO cases are in image-iso9660.
assert files.identify("../../data/aux/aux_3.0.1/APPLE_AUX_3-0-1_RETAIL.iso").kind == "hd" "the A/UX disc (APM, no ISO side) filed as a CD-ROM"
assert contains(files.identify("../../data/systems/system_6_0_8_20mb_8_24gc.img").fits, "cd") "partitioned HFS disk not accepted as a CD-ROM"
assert files.identify("../../data/systems/system_6_0_8_20mb_8_24gc.img").kind == "hd" "partitioned HFS disk filed as a CD-ROM"
assert contains(files.identify("../../data/systems/system_7_0_1_10mb_bare_plus.img").fits, "cd") "bare HFS disk not accepted as a CD-ROM"
assert files.identify("../../data/systems/system_7_0_1_10mb_bare_plus.img").kind == "hd" "bare HFS disk filed as a CD-ROM"
assert files.identify("${$WORK_DIR}/ident-fd.img").kind == "floppy" "the floppy is filed as a floppy"

# --- eject / insert round-trip ----------------------------------------------
# eject() is deliberately type-agnostic: on a hard disk it is "detach this
# disk" (scsi_eject_device takes any id, and the CD-ROM's PREVENT lock is the
# only thing that refuses it).  insert() has to be its counterpart, and was
# not: it called system_attach_scsi_cdrom() whatever the slot held, so putting a hard
# disk back turned it into a read-only SONY CDU-8002 with 2048-byte blocks.
#
# The slot's type survives an eject -- scsi_eject_device clears
# medium_present and the image pointer, never the type -- so insert() asks it.

# Hard disk: out and back in as a hard disk.
assert machine.scsi.device[0].type == "hd" "slot 0 should start as a hard disk"
let tracked = files.images.count
assert machine.scsi.device[0].eject() "ejecting the boot HD failed"
assert machine.scsi.device[0].medium_present == false "HD still reports a medium after eject"
# The eject hands the image back: it is closed and its slot in the machine's
# image list freed, so the file is free at once.  It used to stay open until
# the machine went away.
assert files.images.count == $tracked - 1 "the ejected HD's image is still open"
assert machine.scsi.device[0].insert("${$WORK_DIR}/ident-hd.img") "re-inserting the HD failed"
assert machine.scsi.device[0].type == "hd" "HD came back as ${machine.scsi.device[0].type} after insert"
assert machine.scsi.device[0].read_only == false "HD came back read-only after insert"
assert machine.scsi.device[0].block_size == 512 "HD came back with ${machine.scsi.device[0].block_size}-byte blocks"

# CD-ROM: the case that always worked, pinned so the type lookup cannot
# regress it in the other direction.
assert machine.scsi.attach_cdrom("../../data/aux/aux_3.0.1/APPLE_AUX_3-0-1_RETAIL.iso", 3) "attach_cdrom failed"
assert machine.scsi.device[3].type == "cdrom" "slot 3 should be a CD-ROM"
assert machine.scsi.device[3].eject() "ejecting the CD failed"
assert machine.scsi.device[3].insert("../../data/aux/aux_3.0.1/APPLE_AUX_3-0-1_RETAIL.iso") "re-inserting the CD failed"
assert machine.scsi.device[3].type == "cdrom" "CD came back as ${machine.scsi.device[3].type} after insert"
assert machine.scsi.device[3].read_only == true "CD came back writable after insert"
assert machine.scsi.device[3].block_size == 2048 "CD came back with ${machine.scsi.device[3].block_size}-byte blocks"

# An attach that cannot open its file must SAY so.  system_attach_scsi_hd and
# system_attach_scsi_cdrom returned void and their callers reported success
# unconditionally, so `attach_hd` on a missing file printed "Failed to open
# image" and then answered true -- which is how the first version of the
# round-trip test above passed while inserting nothing at all.
assert machine.scsi.attach_hd("${$WORK_DIR}/no-such-file.img", 4) == false "attach_hd invented a disk"
assert try(machine.scsi.device[4], none) == none "slot 4 must still be empty"
assert machine.scsi.attach_cdrom("${$WORK_DIR}/no-such-file.iso", 5) == false "attach_cdrom invented a disc"
assert try(machine.scsi.device[5], none) == none "slot 5 must still be empty"
assert machine.scsi.device[0].insert("${$WORK_DIR}/no-such-file.img") == false "insert invented a medium"

quit
