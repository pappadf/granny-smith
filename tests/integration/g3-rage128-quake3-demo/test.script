# Quake III Arena's demo `four` on the G3 with a Rage 128 GL, timed.
#
# The G3 of g3-rage128-macos921 with 256 MB, booting gs-test-data's
# stripped 9.2.1 disk (systems/mac_os_9_2_1_516mb_g3_rage128_demos.dmg),
# and the Quake III 1.30 CD cut down to that demo
# (apps/quake3_1_30_demo_four_cd.iso, HFS volume "Q3A").  The Finder opens
# the CD and starts Quake3; the CD key screen takes no key (Tab to ACCEPT,
# then Return: Quake reads the mouse as deltas, so a click cannot be
# aimed); the console runs `demo four`: 63 s of an eight-player FFA on
# q3dm6 that ends when THEINDIGO reaches the fraglimit, after which Quake
# disconnects and returns to its main menu.
#
# The row times the demo from the Return that enters the command to the
# point it ends.  Quake's console text is a ring of 16-bit cells (colour
# byte, character) in guest RAM, found by the command's own echo; the run
# goes on in slices until the console holds " hit the fraglimit" (the
# demo's last event) and then, in finer slices, until the main menu is back
# on the screen (its copyright line, checksummed before the demo): Quake
# disconnects at the demo's end and draws the menu at once.  Printed: host
# wall-clock and CPU time, guest time (cycles over the clock), instructions,
# the frames Quake drew (the card's page flips) and the frame rate in guest
# and in host time, the 3D primitives.  Asserted: the demo ends, every
# file it loads is on the CD (no "could not find" on the console), and it
# drew.

include "../lib/mac.script"

let hd = "../../data/systems/mac_os_9_2_1_516mb_g3_rage128_demos.dmg"
let cd = "../../data/apps/quake3_1_30_demo_four_cd.iso"

# Console cells: colour 7 (white) for the echo and the engine's lines,
# colour 3 (yellow) for warnings
# The row's name and CPU engine (run.sh of g3-rage128-quake3-demo-jit
# sets both)
let ROW = try($ROW_NAME, "g3-rage128-quake3-demo")
let ENGINE = try($CPU_ENGINE, "default")

let PAT_ECHO = "07 5d 07 5c 07 64 07 65 07 6d 07 6f 07 20 07 66 07 6f 07 75 07 72"
let PAT_FRAGLIMIT = "07 20 07 68 07 69 07 74 07 20 07 74 07 68 07 65 07 20 07 66 07 72 07 61 07 67 07 6c 07 69 07 6d 07 69 07 74"
# The main menu's copyright line: top, left, bottom, right
let MENU_LINE = [448, 0, 472, 640]
let PAT_MISSING = "03 63 03 6f 03 75 03 6c 03 64 03 20 03 6e 03 6f 03 74 03 20 03 66 03 69 03 6e 03 64"

def q3_cmdkey(k) {
    machine.adb.keyboard.down "Command"
    scheduler.run 60000000
    machine.adb.keyboard.down $k
    scheduler.run 60000000
    machine.adb.keyboard.up $k
    machine.adb.keyboard.up "Command"
    scheduler.run 2000000000
}
# Select a Finder item by typing its name, then File > Open
def q3_open(name, run) {
    machine.adb.keyboard.type "${$name}"
    scheduler.run 1500000000
    q3_cmdkey("o")
    scheduler.run $run
}
# Thousandths as d.ddd
def milli(x) {
    return "${$x / 1000}.${$x % 1000:03d}"
}

def q3_run() {
    let doc = "{\"cards\":[{\"slot\":\"pci_1\",\"card\":\"rage128\",\"options\":{\"memory\":\"32m\"}}],\"displays\":{\"pci_1\":{\"monitor\":\"13in_rgb\"}}}"
    machine.boot model="pmg3dt" ram=262144 rom="${$ROM}" config="${$doc}"
    # ENGINE=jit (g3-rage128-quake3-demo-jit, the wasm build under Node):
    # the browser's "JIT + kernel" -- the predecoded loop, and hot code,
    # supervisor code too, translated to WebAssembly
    if $ENGINE == "jit" {
        predecode.enabled = 1
        jit.supervisor = 1
        jit.enabled = 1
        assert jit.enabled == 1 "this build has no translation tier (ENGINE=jit needs the wasm build)"
    }
    echo "${$ROW}: engine ${$ENGINE}, predecode ${predecode.enabled}, jit ${jit.enabled}"
    machine.rtc.time = "2026-10-01T12:00:00"
    machine.scsi.attach_hd "${$hd}" 0
    machine.scsi.attach_cdrom "${$cd}" 3
    scheduler.run 30000000000
    # A system error is a positive DSErrCode; start-up leaves negative
    # status values there in passing (as the machine watch reads it)
    let ds = debug.mac.globals.read("DSErrCode")
    assert $ds == 0 || $ds >= 0x8000 "system error ${$ds:04x} during startup"

    # The CD (the desktop's "Q3A"), its Quake3 folder, the Quake3 application
    q3_open("Q3A", 6000000000)
    q3_open("Quake3", 6000000000)
    q3_open("Quake3", 32000000000)
    try(machine.screen.save("${$RESULTS_DIR}/cdkey.png"), none)
    # The CD key screen: no key needed, ACCEPT by keyboard
    machine.adb.keyboard.press "tab"
    scheduler.run 600000000
    machine.adb.keyboard.down "return"
    scheduler.run 200000000
    machine.adb.keyboard.up "return"
    scheduler.run 4000000000
    # The held Return goes on into Single Player: back to the main menu
    machine.adb.keyboard.press "escape"
    scheduler.run 2000000000
    try(machine.screen.save("${$RESULTS_DIR}/menu.png"), none)
    # The menu's copyright line (the banner above it turns, the selected
    # item pulses): the demo has ended when it is back
    let menu_sum = machine.screen.checksum($MENU_LINE[0], $MENU_LINE[1], $MENU_LINE[2], $MENU_LINE[3])
    scheduler.run 500000000
    assert machine.screen.checksum($MENU_LINE[0], $MENU_LINE[1], $MENU_LINE[2], $MENU_LINE[3]) == $menu_sum "the main menu's copyright line is steady"

    # The console, and the command
    machine.adb.keyboard.down 0x32
    scheduler.run 60000000
    machine.adb.keyboard.up 0x32
    scheduler.run 1500000000
    machine.adb.keyboard.type "demo four"
    scheduler.run 500000000

    let hz = scheduler.frequency
    let i0 = scheduler.instr_count
    let c0 = scheduler.cycles
    let w0 = scheduler.host_wall_ns
    let u0 = scheduler.host_user_ns
    let f0 = machine.pci.slot[1].card.regs.flips
    let p0 = machine.pci.slot[1].card.regs.prims3d
    let j0 = jit.instructions
    # The status lines over exactly the demo: the card's says where its
    # host time went (3D, 2D, scanout)
    log.status_every = 0
    log.status
    machine.adb.keyboard.press "return"
    scheduler.run 20000000
    let echo = debug.find.bytes($PAT_ECHO, 0, 0x10000000)
    assert len($echo) == 1 "the console's echo of the command (found ${len($echo)} times)"
    let lo = $echo[0] - 0x10000
    let hi = $echo[0] + 0x10000
    echo "${$ROW}: the console is around ${$echo[0]:08x}"

    # Until the demo's last event (coarse), then until the main menu is back
    # (fine): the disconnect at the demo's end
    let ceiling = 60000000000
    let spent = 20000000
    while $spent < $ceiling && len(debug.find.bytes($PAT_FRAGLIMIT, $lo, $hi)) == 0 {
        scheduler.run 100000000
        let spent = $spent + 100000000
    }
    assert $spent < $ceiling "the demo never reached its fraglimit"
    while $spent < $ceiling && machine.screen.checksum($MENU_LINE[0], $MENU_LINE[1], $MENU_LINE[2], $MENU_LINE[3]) != $menu_sum {
        scheduler.run 2000000
        let spent = $spent + 2000000
    }
    assert $spent < $ceiling "Quake never went back to its main menu after the demo"

    let di = scheduler.instr_count - $i0
    let gms = (scheduler.cycles - $c0) * 1000 / $hz
    let wms = (scheduler.host_wall_ns - $w0) / 1000000
    let ums = (scheduler.host_user_ns - $u0) / 1000000
    let frames = machine.pci.slot[1].card.regs.flips - $f0
    let prims = machine.pci.slot[1].card.regs.prims3d - $p0
    let dj = jit.instructions - $j0
    log.status
    try(machine.screen.save("${$RESULTS_DIR}/end.png"), none)
    echo "${$ROW}: demo four, from Return to its end (within 2 M instructions):"
    echo "${$ROW}:   host wall-clock ${milli($wms)} s, host CPU ${milli($ums)} s"
    echo "${$ROW}:   guest ${milli($gms)} s (${scheduler.cycles - $c0} cycles at ${$hz} Hz)"
    echo "${$ROW}:   ${$di} instructions: ${$di / 1000 / $gms} MIPS guest, ${$di / 1000 / $wms} MIPS host"
    echo "${$ROW}:   speed ${milli($gms * 1000 / $wms)}x real time"
    echo "${$ROW}:   ${$frames} frames (page flips): ${milli($frames * 1000000 / $gms)} fps guest, ${milli($frames * 1000000 / $wms)} fps host"
    echo "${$ROW}:   ${$prims} 3D primitives, raster ${machine.pci.slot[1].card.regs.raster}"
    echo "${$ROW}:   engine ${$ENGINE}: ${$dj * 100 / $di}% of the instructions ran translated"

    let missing = len(debug.find.bytes($PAT_MISSING, $lo, $hi))
    assert $missing == 0 "${$missing} files the demo loads are not on the CD (could not find)"
    assert $frames > 500 "Quake drew ${$frames} frames"
    assert $prims > 100000 "the 3D engine drew ${$prims} primitives"
    echo "${$ROW}: Quake III plays demo four to its end"
}

# Both disc images are private test data.  Without them the row skips, by
# not running (see g3-rage128-opengl).
if have_media($cd) && have_media($hd) {
    q3_run()
} else {
    echo "skip: ${$cd} or ${$hd} not present"
}
quit
