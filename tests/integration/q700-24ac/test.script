# Quadra 700 + Display Card 24AC — Phase F gate #1 (see config.mk).

# Pin the RTC so the boot is deterministic run-to-run.
machine.rtc.time = 3000000000

# Seat the 24AC in the first socket (slot $D) at 8-bpp 640x480; the
# video_mode pick seeds the slot PRAM the same way the IIcx tests do.
machine.boot model="q700" ram=8192 video_card="display_card_24ac" video_mode="rgb_640x480_8bpp"
machine.scsi.attach_hd "$WORK_DIR/hd.img" 0

# Dual-display boot is slower than the bare HD boot (~800M): the Slot
# Manager scans the card, both frame buffers initialise, and the System
# runs the card's declROM driver.  Desktop is stable by 1.5B.
scheduler.run 1500000000

# The card seated in slot $D and came up at 8-bpp 640x480.
assert machine.nubus.slot[13].card.name == "Apple Macintosh Display Card 24AC" "slot $D card != 24AC"
assert machine.nubus.slot[13].card.framebuffer.width == 640 "card fb width != 640"
assert machine.nubus.slot[13].card.framebuffer.depth == 8 "card fb depth != 8 bpp"

# The System's main screen (menu bar) is the built-in DAFB, not the card.
assert (debug.mac.globals.read("ScrnBase") & 0xFF000000) == 0xF9000000 "ScrnBase not on the DAFB"
assert machine.screen.width == 640 "screen width != 640"
assert machine.screen.height == 480 "screen height != 480"

# Finder desktop on the DAFB, pixel-exact.
machine.screen.match dafb-desktop.png

quit
