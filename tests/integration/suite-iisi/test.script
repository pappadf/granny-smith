# Macintosh IIsi suite (see config.mk).
#
# Row map (former directory → row; **bold** = new matrix coverage):
#
#   iisi-chime      iisi-boot-chime: sample-exact chime WAV, on the
#                   65 MB maximum RAM option (a ROM-only row, so the
#                   biggest RAM config costs nothing here)
#   iisi-701-fd     iisi-boot: V8 built-in video, 7.0.1 floppy, 17 MB
#   iisi-608-hd     **IIsi x 6.0.8** (media re-assignment): the
#                   6.0.8 HD image on the 5 MB minimum — 6.0.8's HD
#                   rows all boot the prepared image
#   iisi-71-kbd     **IIsi x 7.1** and the re-hosted ADB keyboard test:
#                   Find dialog + typed text through ADB behind the
#                   EGRET transceiver (9 MB)
#   iisi-75-hd      **IIsi x 7.5**: the pure-redistribution gap that could
#                   not close by moving anything — one cheap boot row
#   iisi-701-depths **IIsi x 7.0.1 at 2, 4 and 8 bpp** on the V8
#
# The IIsi is builtin-video only, so every row runs the V8 at 640x480.

include "../lib/mac.script"

let sys_701 = "../../data/systems/System_7_0_1.image"
let disk_tools_71 = "../../data/systems/SSW-7.1-1.4M/Disk Tools.img"
let hd_608 = "../../data/systems/system_6_0_8_20mb_8_24gc.img"
let hd_75 = "../../data/systems/system_7_5_0_77mb_mode32_24ac.img"

# ---- iisi-chime -------------------------------------------------------------
# Frame-exact capture window: both the 12 M budget and the 13,444-frame length
# are the assertion. Runs at the 65 MB maximum, so the ROM's RAM sizing covers
# the largest supported configuration.
def row_iisi_chime() {
    machine.boot model="iisi" ram=66560 rom="${$ROM}"
    machine.sound.capture.start
    scheduler.run 12000000
    machine.sound.capture.stop
    assert machine.ram == 66560 "iisi-chime: machine.ram != 66560"
    assert machine.sound.capture.frames == 13444 "iisi-chime: unexpected capture length"
    # machine.rbv on the V8 superset — same node, same four attributes, and
    # the variant is the part the node has to distinguish.
    assert machine.rbv.chip == "RBV" "iisi-chime: machine.rbv missing"
    assert machine.rbv.variant == "V8/IIsi" "iisi-chime: wrong RBV variant"
    machine.sound.match goldens/iisi-chime.wav
    report_perf("suite-iisi/iisi-chime", scheduler.instr_count)
}

# ---- iisi-701-fd ------------------------------------------------------------
def row_iisi_701_fd() {
    machine.boot model="iisi" ram=17408 rom="${$ROM}"
    machine.floppy.drive[0].insert "${$sys_701}"
    # Run past the early boot transient BEFORE waiting. The desktop pattern is
    # painted long before the Finder draws its menu bar and icons, and that bare
    # grey frame is static, so REGEN and verify agreed on a screen with nothing
    # on it — this row's golden was such a frame until 2026-07-28. Same defect
    # fixed in suite-iifx's two floppy rows. The real Finder is up by ~200 M.
    scheduler.run 200000000
    let spent = wait_match("goldens/iisi-7.0.1-640x480x1-finder.png", 800000000, 20000000)
    assert machine.id == "iisi" "iisi-701-fd: machine.id != iisi"
    assert machine.rom.checksum == "36B7FB6C" "iisi-701-fd: rom.checksum != 36B7FB6C"
    assert machine.ram == 17408 "iisi-701-fd: machine.ram != 17408"
    assert machine.screen.width == 640 "iisi-701-fd: screen.width != 640"
    assert machine.screen.height == 480 "iisi-701-fd: screen.height != 480"
    assert_addr(false)
    report_row("7.0.1", "v8", "fd-boot")
    # Total row spend, not $spent: with the 200 M pre-run above the wait matches
    # on its first poll, so $spent would be a constant 20 M and signal nothing.
    report_perf("suite-iisi/iisi-701-fd", scheduler.instr_count)
}

# ---- iisi-608-hd -----------------------------------------------------------
# NEW CELL IIsi x 6.0.8 on the 5 MB minimum (1+4 two-bank split).
def row_iisi_608_hd() {
    machine.rtc.time = 3000000000
    machine.boot model="iisi" ram=5120 rom="${$ROM}"
    machine.scsi.attach_hd "${$hd_608}" 0
    let spent = wait_match("goldens/iisi-6.0.8-640x480x1-finder.png", 900000000, 20000000)
    assert machine.ram == 5120 "iisi-608-hd: machine.ram != 5120"
    assert machine.screen.width == 640 "iisi-608-hd: screen.width != 640"
    assert_addr(false)
    report_row("6.0.8", "v8", "hd-boot scsi")
    report_perf("suite-iisi/iisi-608-hd", $spent)
}

# ---- iisi-71-kbd -----------------------------------------------------------
# NEW CELL IIsi x 7.1, and the ADB keyboard test re-hosted here so the
# keystroke path runs through the Egret transceiver. The regression it
# guards: the ADB keyboard used to drop roughly every other keystroke,
# so typing into the Find dialog and matching the result pixel-exactly
# is the assertion.
def row_iisi_71_kbd() {
    machine.rtc.time = 3000000000
    machine.boot model="iisi" ram=9216 rom="${$ROM}"
    machine.floppy.drive[0].insert "${$disk_tools_71}"
    scheduler.run 60000000
    wait_stable(900000000)
    assert machine.ram == 9216 "iisi-71-kbd: machine.ram != 9216"
    assert machine.screen.width == 640 "iisi-71-kbd: screen.width != 640"
    # golden-collision-ok: iisi-7.1-640x480x1-desktop.png iisi-7.0.1-640x480x1-finder.png
    # - System_7_0_1.image and the 7.1 Disk Tools disk are both volumes named
    # "Disk Tools", so at 640x480x1 the two Finders draw an identical desktop
    # (the same frame appears in suite-iifx and suite-se30 for the same reason).
    # Neither golden is what proves its row: this one exists as the stable
    # starting point for the ADB keystroke choreography that follows.
    check("goldens/iisi-7.1-640x480x1-desktop.png")

    # File → Find… (drag the File menu open and release on the item).
    machine.adb.mouse.move 50 50 "global"
    run_ticks(30)
    machine.adb.mouse.move 38 7 "global"
    run_ticks(20)
    machine.adb.mouse.click true
    run_ticks(40)
    machine.adb.mouse.move 38 200 "global"
    run_ticks(40)
    machine.adb.mouse.click false
    # Fixed guest-time window, not a settle: the Find dialog blinks a
    # text caret, so the screen never holds still and the golden is
    # caret-phase-sensitive.
    run_ticks(90)
    check("goldens/iisi-7.1-640x480x1-find-dialog.png")

    # Type "macintosh" one key at a time — every keystroke must land.
    machine.adb.keyboard.press 0x2E
    machine.adb.keyboard.press 0x00
    machine.adb.keyboard.press 0x08
    machine.adb.keyboard.press 0x22
    machine.adb.keyboard.press 0x2D
    machine.adb.keyboard.press 0x11
    machine.adb.keyboard.press 0x1F
    machine.adb.keyboard.press 0x01
    machine.adb.keyboard.press 0x04
    run_ticks(90)
    check("goldens/iisi-7.1-640x480x1-typed.png")
    report_row("7.1", "v8", "fd-boot adb-egret keyboard")
    report_perf("suite-iisi/iisi-71-kbd", scheduler.instr_count)
}

# ---- iisi-75-hd ------------------------------------------------------------
# NEW CELL IIsi x 7.5 — the one cell pure redistribution could not close,
# so it is a plain cheap boot row.
def row_iisi_75_hd() {
    machine.rtc.time = 3000000000
    machine.boot model="iisi" ram=17408 rom="${$ROM}"
    machine.scsi.attach_hd "${$hd_75}" 0
    scheduler.run 300000000
    wait_stable(1500000000)
    assert machine.id == "iisi" "iisi-75-hd: machine.id != iisi"
    assert machine.screen.width == 640 "iisi-75-hd: screen.width != 640"
    assert_addr(false)
    check_ex("goldens/iisi-7.5-640x480x1-finder.png", 0, 440, 20, 640)
    report_row("7.5", "v8", "hd-boot scsi")
    report_perf("suite-iisi/iisi-75-hd", scheduler.instr_count)
}

# ---- row dispatch -----------------------------------------------------------

# ---- iisi-701-depths --------------------------------------------------------
# The V8 built-in video at 2, 4 and 8 bpp.  These were once recorded as
# unreachable ("built-in video exposes no depth mode list"), because seeds
# written for the IIci did nothing here.  The IIsi's record is elsewhere:
# its built-in video is slot $E, so its sPRAMRec is PRAM $6E..$75, and its
# BoardID is $0028.  Within the record, byte 2 ($70) is the saved depth spID
# and byte 3 ($71) the video sRsrc spID; an unseeded 7.0.1 boot leaves
# 00 28 80 86 there, $86 being what the ROM computes for this monitor.
#
# pram.validate first, or PRAMInit rewrites the record during boot.
def boot_iisi_701_at_depth(spid) {
    machine.boot model="iisi" ram=17408 rom="${$ROM}"
    machine.floppy.drive[0].insert "${$sys_701}"
    machine.rtc.pram.validate
    if $spid == 0x81 { machine.rtc.pram.poke 0x6E 0x0028818600000000:8 }
    if $spid == 0x82 { machine.rtc.pram.poke 0x6E 0x0028828600000000:8 }
    if $spid == 0x83 { machine.rtc.pram.poke 0x6E 0x0028838600000000:8 }
    scheduler.run 300000000
    wait_stable(900000000)
    assert machine.rtc.pram.peek(0x70) == $spid "iisi-701-depths: savedMode rewritten by the ROM (wanted ${$spid:02x})"
    assert machine.screen.width == 640 "iisi-701-depths: width != 640"
    assert machine.screen.height == 480 "iisi-701-depths: height != 480"
}
def row_iisi_701_depths() {
    boot_iisi_701_at_depth(0x81)
    assert machine.screen.depth == 2 "iisi-701-depths: savedMode $81 gave depth ${machine.screen.depth}, want 2"
    check("goldens/iisi-7.0.1-640x480x2-finder.png")
    report_row("7.0.1", "v8", "fd-boot 2bpp")

    boot_iisi_701_at_depth(0x82)
    assert machine.screen.depth == 4 "iisi-701-depths: savedMode $82 gave depth ${machine.screen.depth}, want 4"
    check("goldens/iisi-7.0.1-640x480x4-finder.png")
    report_row("7.0.1", "v8", "fd-boot 4bpp")

    boot_iisi_701_at_depth(0x83)
    assert machine.screen.depth == 8 "iisi-701-depths: savedMode $83 gave depth ${machine.screen.depth}, want 8"
    check("goldens/iisi-7.0.1-640x480x8-finder.png")
    report_row("7.0.1", "v8", "fd-boot 8bpp")
    report_perf("suite-iisi/iisi-701-depths", scheduler.instr_count)
}

if row_on("iisi-chime") { row_end("iisi-chime", try(row_iisi_chime(), "FAILED")) }
if row_on("iisi-701-fd") { row_end("iisi-701-fd", try(row_iisi_701_fd(), "FAILED")) }
if row_on("iisi-608-hd") { row_end("iisi-608-hd", try(row_iisi_608_hd(), "FAILED")) }
if row_on("iisi-71-kbd") { row_end("iisi-71-kbd", try(row_iisi_71_kbd(), "FAILED")) }
if row_on("iisi-701-depths") { row_end("iisi-701-depths", try(row_iisi_701_depths(), "FAILED")) }
if row_on("iisi-75-hd") {
    if have_media($hd_75) {
        row_end("iisi-75-hd", try(row_iisi_75_hd(), "FAILED"))
    } else {
        echo "skip: iisi-75-hd (7.5 prepared image not fetched)"
    }
}

suite_done()
quit
