# See config.mk.

let ROM = "${$TEST_DATA}/roms/iix-iicx-se30-97221136.rom"

# The profile: each card with a substitute ROM, then its generic variant
def card(id) {
    for c in catalog.profile("iicx").cards {
        if $c.id == $id {
            return $c
        }
    }
    return none
}
for id in ["mdc_8_24", "display_card_24ac", "824gc"] {
    let c = card($id)
    let g = card("${$id}_generic")
    assert $c != none "the card ${$id} is not listed"
    assert $c.status == "ok" "Apple's ROM of ${$id} is offered here"
    assert $g != none "no generic variant of ${$id}"
    assert $g.variant_of == $id "the variant does not name its card"
    assert $g.status == "ok" "the generic variant needs no ROM"
    assert $g.rom == none "the generic variant asks for a ROM file"
    assert $g.label == "${$c.label} · Substitute ROM" "the variant's label"
}
# A card without a substitute has no variant
assert card("mdc_8_24_generic_generic") == none "a variant of a variant"

# The plain card runs Apple's ROM when it is offered
assert machine.boot(model="iicx", rom=$ROM, config="{\"cards\":[{\"slot\":\"nubus_9\",\"card\":\"mdc_8_24\"}]}") "the plain card boots"
assert machine.nubus.slot[9].card.substitute == false "the plain card does not run Apple's ROM"

# The generic variant runs the substitute although Apple's is offered
for id in ["mdc_8_24", "display_card_24ac", "824gc"] {
    assert machine.boot(model="iicx", rom=$ROM, config="{\"cards\":[{\"slot\":\"nubus_9\",\"card\":\"${$id}_generic\"}]}") "the generic ${$id} boots"
    assert machine.nubus.slot[9].card.substitute "the generic ${$id} runs Apple's ROM"
    assert machine.nubus.slot[9].card.declrom.path == "builtin:${$id}" "the generic ${$id} is not on the generated ROM"
}

# With a monitor and startup mode from the substitute's own modes
assert machine.boot(model="iicx", rom=$ROM, config="{\"cards\":[{\"slot\":\"nubus_9\",\"card\":\"824gc_generic\"}],\"displays\":{\"nubus_9\":{\"monitor\":\"13in_rgb\",\"mode\":\"640x480x8\"}}}") "the generic 8•24 GC with a startup mode boots"
assert machine.nubus.slot[9].card.substitute "the generic 8•24 GC runs Apple's ROM"

# The SE/30's built-in video is no slot card: its ROM is the video_rom option
assert catalog.default_config("se30").options.video_rom == "apple" "the SE/30 has no video_rom option"
assert try(catalog.default_config("iicx").options.video_rom, "absent") == "absent" "a IIcx has no built-in video ROM choice"
assert machine.boot(model="se30", rom=$ROM) "the SE/30 boots"
assert machine.nubus.slot[14].card.substitute == false "the SE/30 does not run Apple's video ROM"
assert machine.boot(model="se30", rom=$ROM, config="{\"options\":{\"video_rom\":\"substitute\"}}") "the SE/30 on its substitute video ROM boots"
assert machine.nubus.slot[14].card.substitute "video_rom=substitute does not run the substitute"
assert machine.nubus.slot[14].card.declrom.path == "builtin:builtin_se30_video" "the SE/30 is not on the generated video ROM"

echo "PASS: display-card-generic"
quit
