# Integration test: a UDIF (.dmg) image decodes transparently when opened.
#
# The fixture is built by make-fixture.py at setup time from the raw source
# below, mixing zlib, raw and zero-fill chunks across two 'mish' block tables
# (so the second table's chunk sectors restart at zero).  The runner cd's into
# tests/integration/, so the source path is relative and WORK_DIR is absolute.

let dmg = "${$WORK_DIR}/fixture.dmg"
let raw = "../../data/systems/system_6_0_8_20mb_8_24gc.img"

# The .dmg is far smaller on the host than the disk it carries — proof the
# thing being opened really is the compressed container, not a raw image.
assert files.path_size($dmg) < 8000000 "fixture .dmg is not compressed"
assert files.path_size($raw) == 21411840 "raw source image changed size"

# Opening it decodes the whole container.  Every block table's stored CRC-32
# is verified during that decode, so reaching this line at the right geometry
# already means the decoded bytes match what the writer recorded.
files.probe $dmg
assert files.list("${$dmg}/partition1") "decoded UDIF did not mount as HFS"

# The volume inside is the same one the raw source carries.
files.probe $raw
let from_dmg = files.list("${$dmg}/partition1")
let from_raw = files.list("${$raw}/partition1")
assert len($from_dmg) == len($from_raw) "decoded volume has a different entry count"
for i in 0..len($from_raw) {
    assert $from_dmg[$i].name == $from_raw[$i].name "entry ${$i} differs between decoded and raw"
}

# A nested directory reads too, so the decode holds up past the volume header.
assert files.list("${$dmg}/partition1/System Folder") "System Folder unreadable in the decoded image"

# The same image addressed two ways decodes once, not once per spelling: the
# scratch name is keyed on the canonicalised path.  Checked by total bytes in
# the storage cache, which a second decode would roughly double (the decoded
# disk is 21,411,840 bytes; the delta/journal sidecars beside it are tiny).
assert files.probe("${$WORK_DIR}/./fixture.dmg") "second spelling of the .dmg did not open"
let cached = 0
for e in files.list("${$WORK_DIR}/storage-cache") {
    $cached = $cached + $e.size
}
assert $cached < 32000000 "image decoded once per path spelling (scratch cache holds ${$cached} bytes)"

# Exporting the decoded image yields the full logical disk, not the .dmg size.
assert files.export_raw($dmg, "${$WORK_DIR}/exported.img") "export_raw failed"
assert files.path_size("${$WORK_DIR}/exported.img") == files.path_size($raw) "exported image is not the source disk's size"

# The decoded chunks came from the disk-image cache -- memory only, so a
# compressed image never re-expands into scratch files -- whose budget is a
# setting.
assert files.cache.image_misses > 0 "the UDIF chunks were decoded through the image cache"
assert files.cache.image_hits > 0 "re-reading decoded chunks was served from the image cache"
assert files.cache.image_memory_bytes <= files.cache.image_mb * 1048576 "the image cache holds no more than its budget"
files.cache.image_mb = 1
assert files.cache.image_mb == 1 "the image budget is settable"
assert files.cache.image_memory_bytes <= 1048576 "a smaller image budget evicts at once"
assert files.cache.memory_bytes <= files.cache.memory_mb * 1048576 "the cache holds no more than its budget"
files.cache.memory_mb = 1
assert files.cache.memory_mb == 1 "the memory budget is settable"
assert files.cache.memory_bytes <= 1048576 "a smaller budget evicts at once"
files.cache.spill_mb = 7
assert files.cache.spill_mb == 7 "the spill budget is settable"

quit
