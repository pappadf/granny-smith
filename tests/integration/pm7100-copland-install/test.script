# Integration test: Power Macintosh 7100 — install System 7.5.0 onto the volume
# Copland D11E4 will be installed into.
#
# Phase 3 of the bring-up plan §6.2.  See config.mk for the phase map and why
# this is a separate test from pm7100-copland-format.
#
# The bus:
#
#   SCSI 0   system_7_5_0_77mb_mode32_24ac.img       the host we boot from
#   SCSI 1   copland_target_formatted_230mb.img      the target, formatted and
#                                                    empty, from phase 2
#   SCSI 3   the Mac OS 8 DDK 0.4 CD                 for phase 4's Install Mac OS
#   FD0      the seven System 7.5.0 install floppies, fed one at a time
#
# Both SCSI volumes and the floppies are attached read/write and accumulate
# delta writes.  Under the harness those land in the per-test GS_STORAGE_CACHE,
# so the published formatted image and tests/data are left untouched and the
# run is repeatable.  Driving this by hand without GS_STORAGE_CACHE set would
# write through to them.

include "../lib/mac.script"

let copland_root = "../../../local/gs-docs/projects/copland"
let media = "${$copland_root}/media"
let ddk_cd = "${$copland_root}/images/copland_d11e4_jun_1996_mac_os_8_ddk_0.4_original_cd_image.dmg"
let ssw75 = "${$media}/ssw75-1.4M"
let target = "${$media}/copland_target_formatted_230mb.img"
let host_hd = "../../data/systems/system_7_5_0_77mb_mode32_24ac.img"

# Poll the DEVICE for a pending disk swap, then prove WHICH disk by matching a
# golden before inserting it — the iifx-install-76 pattern, and its header
# records why reading the request out of guest memory was abandoned (ParamText's
# ^0 slot goes empty exactly when a request is pending).  Do not re-derive that.
#
# The ceiling is a hang detector, not a tuning knob, and it has to be generous:
# the Installer's "Preparing to install..." phase alone runs ~2.5 G instructions
# before it touches the floppy at all (measured), and each disk is read over an
# emulated 1.44 MB drive.  1500 polls = 30 G instructions.
def await_request_named(n, golden) {
    let k = 0
    while machine.floppy.drive[0].present {
        assert $k < 1500 "disk ${$n:d}: the Installer never ejected the previous disk"
        scheduler.run 20000000
        $k = $k + 1
    }
    wait_stable(900000000)
    check_ex("${$golden}", 0, 440, 20, 640)
}

def await_request(n) {
    await_request_named($n, "insert-disk${$n:d}.png")
}

def hand_over(n) {
    await_request($n)
    assert machine.floppy.drive[0].insert("${$ssw75}/Install Disk ${$n:d}.img", true) == true "insert of Install Disk ${$n:d} failed"
}

# Phase 3 — the System 7.5.0 install.
def phase3_install_75() {
    machine.rtc.time = 0xE0000000
    machine.boot model="pm7100" ram=24576 rom="${$ROM}"
    machine.scsi.attach_hd "${$host_hd}" 0
    machine.scsi.attach_hd "${$target}" 1
    machine.scsi.attach_cdrom "${$ddk_cd}" 3

    # suite-pdm's boot_pdm_75() recipe: chip init and bus scan, skip the 20 s
    # WaitForPollDrive spin-up window, then boot blocks through to the Finder.
    scheduler.run 360000000
    machine.memory.poke.l 0x9716A 0x2000
    scheduler.run 1200000000
    wait_stable(900000000)
    assert machine.cpu.mmu.peek(0xAF0, 2) == 0 "system error ${machine.cpu.mmu.peek(0xAF0, 2)} during boot"

    # The formatted target mounts as `untitled` beside the host volume and the
    # CD — phase 2's work, seen from the guest for the first time.
    machine.floppy.drive[0].insert "${$ssw75}/Install Disk 1.img" true
    scheduler.run 600000000
    wait_stable(900000000)
    check_ex("host-with-target.png", 0, 440, 20, 640)

    # The floppy's window auto-opens on its single Installer.
    double_click(153, 95)
    scheduler.run 800000000
    wait_stable(3000000000)
    check_ex("welcome.png", 0, 440, 20, 640)

    click(470, 366)
    wait_stable(2000000000)
    # "Easy Install", and the destination the Installer picked by itself: the
    # volume we booted from.  Wrong — hence the two Switch Disk clicks below.
    check_ex("easy-install-wrong-disk.png", 0, 440, 20, 640)

    # Switch Disk cycles the mounted volumes: Macintosh HD -> Mac OS 8 DDK 0.4
    # (locked, and it says so) -> untitled.  The intervening move is required,
    # not cosmetic: a same-spot warp emits no ADB motion, so a second click at
    # the same pixel has no fresh position event to bind to and is dropped
    # (../lib/mac.script, click()).
    click(307, 355)
    wait_stable(1000000000)
    machine.adb.mouse.move 420 300 "global"
    run_ticks(10)
    click(307, 355)
    wait_stable(1000000000)
    # Destination Disk: untitled, and Install is live again.
    check_ex("easy-install-untitled.png", 0, 440, 20, 640)

    click(471, 359)
    # Disks 2-7.  Each request is matched pixel-exact before the disk goes in,
    # so the golden is both the synchronisation point and the assertion that
    # the Installer asked for that particular disk.
    for n in 2..8 {
        hand_over($n)
    }

    # Install Disk 1 goes back in at the end.  The Installer asks for it after
    # the last source disk, to write the boot blocks and update the volume
    # ("Updating disk..."), exactly the way 7.6's does — iifx-install-76 feeds
    # "Install 1" back for the same reason.  Same await/prove/insert shape as
    # the source disks, and the same generous ceiling: the Installer works for
    # a long time after disk 7 goes in (measured: 2 G instructions later it was
    # still reading AppleScript resources) before it asks.
    await_request_named(1, "insert-disk1-again.png")
    assert machine.floppy.drive[0].insert("${$ssw75}/Install Disk 1.img", true) == true "re-insert of Install Disk 1 failed"

    # ...and then it writes the volume out.  A stability wait, with a ceiling
    # sized for the real thing rather than a guess: the whole install is ~91 G
    # instructions, and a 6 G ceiling here timed out with "screen never
    # settled" while the run was still going — which is what a too-small
    # ceiling looks like, not a hang.
    scheduler.run 600000000
    wait_stable(30000000000)
    # NOT the end.  7.5's Installer stops on an advisory about QuickDraw GX and
    # PowerTalk that has to be dismissed before it reports anything.  Treating
    # this frame as the finish line was the mistake that made an earlier
    # version of this test quit mid-install: the volume looked plausible (a
    # System Folder was there) while the Installer had not written the boot
    # blocks or its own verdict yet.
    check_ex("quickdraw-gx-notice.png", 0, 440, 20, 640)
    click(445, 360)

    # NOW it finishes.
    scheduler.run 600000000
    wait_stable(30000000000)
    # Always leave the frame behind, so a golden mismatch is diagnosable from
    # the run's artifacts rather than needing a 25-minute re-run.
    try(machine.screen.save("${$RESULTS_DIR}/tail.png"), none)
    check_ex("installed.png", 0, 440, 20, 640)
    report_perf("pm7100-copland-install/phase3", scheduler.instr_count)
}

# Prove the System landed, and publish the volume for phase 4.
def phase3_export() {
    machine.scsi.device[1].image.export "${$WORK_DIR}/installed.img"
    let root = vfs.list("${$WORK_DIR}/installed.img/partition6")
    echo "target root: ${$root}"
    let sysfolder = vfs.list("${$WORK_DIR}/installed.img/partition6/System Folder")
    echo "System Folder: ${len($sysfolder)} items"
    # THE ANTI-TRUNCATION CHECK.  `installed.png` matching the Installer's
    # "Installation was successful." dialog is the primary proof, but a golden
    # only says what the screen looked like — and a quiet screen is not a
    # finished install.  Two earlier versions of this test passed while the
    # install was still running (one stopped at "Reading AppleScript...", one at
    # the "Updating disk..." request for Install Disk 1) because a stability
    # wait returned on a static progress frame, and both published a
    # half-installed volume that looked plausible: a System Folder was there.
    #
    # These name the files the Installer writes LAST, measured by diffing a
    # truncated run against a complete one.  Truncated: 4 root items, 9 in the
    # System Folder.  Complete: 8 and 10.
    #
    # NOT " Installer Temp": the Installer leaves its own scratch folder behind
    # even on a fully successful run (verified against the completed volume), so
    # its absence is not a completion marker however much it looks like one.
    assert storage.path_exists("${$WORK_DIR}/installed.img/partition6/SimpleText") "no SimpleText at the volume root — the install stopped before its last files"
    assert storage.path_exists("${$WORK_DIR}/installed.img/partition6/System 7.5 --Read Me") "no 'System 7.5 --Read Me' — the install stopped before its last files"
    assert storage.path_exists("${$WORK_DIR}/installed.img/partition6/System Folder/Scrapbook File") "no Scrapbook File in the System Folder — the install stopped before its last files"
    # Name the two files that make a System Folder bootable rather than
    # counting entries: 7.5's Easy Install lays down nine items here (System,
    # Finder, Apple Menu Items, Control Panels, Extensions, Fonts, Launcher
    # Items, Preferences and the Installer's own " Installer Temp"), and a
    # count is both weaker evidence and more brittle than this.
    assert storage.path_exists("${$WORK_DIR}/installed.img/partition6/System Folder/System") "no System file — the install did not land"
    assert storage.path_exists("${$WORK_DIR}/installed.img/partition6/System Folder/Finder") "no Finder — the install did not land"
    # The loader partition Drive Setup 2.0d5c2 wrote must still be there: the
    # 7.5 Installer writes a volume, it does not re-partition the drive, and
    # Copland's rule 207 will look for this again in phase 4.
    storage.partmap "${$WORK_DIR}/installed.img"
    assert len(vfs.list("${$WORK_DIR}/installed.img")) == 7 "the install disturbed the partition map"

    storage.cp "${$WORK_DIR}/installed.img" "${$media}/copland_target_75_230mb.img"
    assert storage.path_exists("${$media}/copland_target_75_230mb.img") "the installed volume was not published to media/"
}

if have_media($target) && have_media("${$ssw75}/Install Disk 7.img") && have_media($ddk_cd) && have_media($host_hd) {
    phase3_install_75()
    phase3_export()
    report_row("7.5", "ariel", "copland-install-phase3 ssw75-floppy-install")
} else {
    echo "skip: pm7100-copland-install (Copland media not present — see the bring-up plan §6.0)"
}

quit
