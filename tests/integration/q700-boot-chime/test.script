# Quadra 700 Phase C gate (see config.mk).

# Capture the boot chime while the ROM runs POST + Start Manager entry.
machine.sound.capture.start
scheduler.run 30000000
machine.sound.capture.stop

# The EASC (ASC-compatible core) played the chime: the capture window
# holds ~62.4k frames at 22,257 Hz.  A silent boot (EASC probe failure)
# yields 0 frames; a hung POST never reaches the capture stop.
assert machine.sound.capture.frames > 60000 "boot chime missing or short"
assert machine.sound.capture.frames < 65000 "unexpected capture length"

# RAM sizing completed: MemTop == configured 8 MB.
assert debug.mac.globals.read("MemTop") == 0x800000 "RAM sizing wrong"

# The ROM based itself in the aperture (overlay dropped, mirrors live).
assert debug.mac.globals.read("ROMBase") == 0x40800000 "ROMBase wrong"

# Ticks advance (VIA1 CA1 tick + level-1 interrupts are being serviced).
let t0 = debug.mac.globals.read("Ticks")
scheduler.run 10000000
assert debug.mac.globals.read("Ticks") > $t0 "Ticks stalled"

quit
