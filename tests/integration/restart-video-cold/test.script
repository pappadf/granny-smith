# Restart-video conformance -- see config.mk.

# The booted machine, run for `budget`, must show a different frame after
# machine.restart than before it.
def check(label, budget) {
    scheduler.run $budget
    let before = machine.screen.checksum()
    machine.restart
    let after = try(machine.screen.checksum(), none)
    assert $after != $before "${$label}: machine.restart still shows the pre-restart frame"
    echo "restart-video-cold ${$label}: ok"
}

def cold(model, rom, budget) {
    machine.boot model="${$model}" ram=8192 rom="../../data/roms/${$rom}"
    check($model, $budget)
}

cold("iicx", "iix-iicx-se30-97221136.rom", 30000000)
cold("iifx", "iifx-4147dd77.rom", 40000000)
cold("q700", "q700-q900-420dbff3.rom", 60000000)
cold("q840av", "q840av-q660av-5bf10fd1.rom", 300000000)

# The cards and built-ins with VRAM of their own beyond those: the SE/30's
# built-in card, the 24AC and the 8*24 GC in a NuBus slot, Control (pm7500)
# and a PCI display card.  The SE/30 and the 8*24 GC kept their frame before
# the bus-level default; the others already changed it at the /RESET, and are
# here so the default does not regress them.
cold("se30", "iix-iicx-se30-97221136.rom", 30000000)
machine.boot model="iicx" ram=8192 video_card="display_card_24ac" rom="../../data/roms/iix-iicx-se30-97221136.rom"
check("iicx+24ac", 30000000)
machine.boot model="iicx" ram=8192 video_card="824gc" rom="../../data/roms/iix-iicx-se30-97221136.rom"
check("iicx+824gc", 30000000)
machine.boot model="pm7500" ram=32768 rom="../../data/roms/pm7500-pm8500-pm9500-96cd923d.rom"
check("pm7500", 300000000)
machine.boot model="pm9500" ram=32768 pci_card="mach64_gx" rom="../../data/roms/pm7500-pm8500-pm9500-96cd923d.rom"
check("pm9500+mach64_gx", 300000000)

quit
