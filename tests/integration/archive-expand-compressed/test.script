# A disk image inside an archive is offered (expandable) whether the member
# is stored or compressed: the listing decodes a compressed member of up to
# 64 MB to find out.  It used to probe only a stored one, so a disk in a
# deflated zip member or in a .sit.hqx was never offered.

# The one entry's expandable flag, named `name`, in the listing of `dir`.
def expandable(dir, name) {
    let flag = "missing"
    for e in files.list($dir) {
        if $e.name == $name {
            $flag = "${$e.expandable}"
        }
    }
    return $flag
}

let w = $WORK_DIR
assert expandable("${$w}/stored.zip", "System.dsk") == "true" "a stored zip member is not offered"
assert expandable("${$w}/deflated.zip", "System.dsk") == "true" "a deflated zip member is not offered"
assert files.list("${$w}/deflated.zip/System.dsk/partition1/System Folder") "the deflated member's HFS volume"

# BinHex around StuffIt around the disk: the BinHex layer is peeled, the
# StuffIt archive listed, and its compressed member probed.
assert expandable("${$w}/mactest.sit.hqx", "MacTest Disk.image") == "true" "a disk in a .sit.hqx is not offered"
assert files.list("${$w}/mactest.sit.hqx/MacTest Disk.image/partition1") "the .sit.hqx disk's volume"

# Over the cap the member is not decoded for a listing, though it is a disk
# and lists when asked.
assert expandable("${$w}/big.zip", "Big.dsk") == "false" "a 65 MB compressed member was probed"
assert files.list("${$w}/big.zip/Big.dsk/partition1") "the large member does not list when asked"

echo "archive-expand-compressed-ok"
quit
