# Integration test: configuration-document boot.  machine.boot inherits
# NOTHING — the document is the whole specification.
#
# Pins the boot-document contract end-to-end:
#   * headless startup writes the built-from record (same path as scripts);
#   * model and rom are required; every other omitted field resolves to the
#     MODEL's own default, never to the previous machine's record —
#     including after a model change;
#   * all validation runs BEFORE teardown: a rejected boot leaves the
#     running machine (and its record) untouched;
#   * slots= configures each slot (card, mode, ROM, options); video_card=
#     is sugar for the first socket's card, and the two may not disagree;
#   * machine.config.vroms records the declaration-ROM picks the loader
#     actually resolved; vrom= (or a slot's rom=) pins a specific revision;
#   * the record rides in checkpoints: checkpoint.load builds the saved
#     machine, its slots and its monitor strap from it.

# --- Startup boot wrote the built-from record (headless CLI = same path). ---
assert machine.config.valid "record valid after startup boot"
assert machine.config.model == "iicx" "record model from CLI"
assert machine.config.ram == 8192 "record ram from CLI"
assert machine.config.rom_id == "97221136" "record rom_id"
assert machine.config.created != "" "record created stamped"

# --- Slot nodes describe what is installed: an empty socket has none. ---
assert machine.nubus.slot[9].number == 9 "populated socket $9 missing from object model"
assert try(machine.nubus.slot[10].number, none) == none "an empty socket has no slot node"

# --- The document is the whole specification: model and rom are required. ---
assert !machine.boot() "bare machine.boot must be rejected (model required)"
assert !machine.boot(model="iicx") "machine.boot without rom must be rejected"
assert !machine.boot(rom="${$ROM}") "machine.boot without model must be rejected"

# --- Validate-before-teardown: every rejection leaves the machine running. ---
assert !machine.boot(model="bogus", rom="${$ROM}") "unknown model must be rejected"
assert !machine.boot(model="iicx", rom="${$ROM}", ram=999) "off-menu ram must be rejected"
assert !machine.boot(model="iicx", rom="does/not/exist.rom") "unreadable rom must be rejected"
assert !machine.boot(model="iicx", rom="${$ROM}", vrom="../../data/roms/plus-v3-4d1f8172.rom") "non-vROM vrom= must be rejected"
assert !machine.boot(model="iicx", rom="${$ROM}", video_card="nonesuch") "unknown card id must be rejected"
# A real card that fits no slot of this model (the IIci's built-in RBV video
# on a IIcx) is rejected too: seated nowhere, it used to boot the default
# display and leave the row that named it testing something else.
assert !machine.boot(model="iicx", rom="${$ROM}", video_card="builtin_rbv_video") "a card that fits no slot must be rejected"
# 15 is one past the top of Apple's indexed sense numbering: 0..7 is the
# passive 3-bit code, 8..14 names a monitor that answers the EXTENDED
# tie-matrix probe (dafb.h's DAFB_SENSE_INDEXED_*).
assert !machine.boot(model="iicx", rom="${$ROM}", video_sense=15) "out-of-range sense must be rejected"
assert !machine.boot(model="iicx", rom="${$ROM}", video_mode="nonesuch") "unknown video mode must be rejected"
assert !machine.boot(model="iicx", rom="${$ROM}", pci_card="tnt_control") "pci_card= on a model with no PCI slots must be rejected"
# slots= is checked slot by slot, before teardown too.
assert !machine.boot(model="iicx", rom="${$ROM}", slots="8=824gc") "a slot the model does not have must be rejected"
assert !machine.boot(model="iicx", rom="${$ROM}", slots="9") "an entry that is not SLOT=CARD must be rejected"
assert !machine.boot(model="iicx", rom="${$ROM}", slots="9=nonesuch") "an unknown card in slots= must be rejected"
assert !machine.boot(model="iicx", rom="${$ROM}", slots="9=824gc;9=8_24") "a slot named twice must be rejected"
assert !machine.boot(model="iicx", rom="${$ROM}", slots="9=824gc,mode=rgb_640x480_8bpp") "a mode of another card must be rejected"
assert !machine.boot(model="iicx", rom="${$ROM}", slots="9=824gc,custom=640x480x8") "custom geometry on a card without it must be rejected"
assert !machine.boot(model="iicx", rom="${$ROM}", slots="9=8_24,custom=640x480x16") "custom geometry the card cannot hold must be rejected"
assert !machine.boot(model="iicx", rom="${$ROM}", slots="9=824gc,vram=4m") "a NuBus card takes no options"
assert !machine.boot(model="iicx", rom="${$ROM}", slots="9=824gc,rom=../../data/roms/plus-v3-4d1f8172.rom") "a slot ROM that is no vROM must be rejected"
assert !machine.boot(model="iicx", rom="${$ROM}", slots="9=824gc,rom=../../data/roms/mdc-8-24-revb-d1629664.vrom") "a slot ROM for another card must be rejected"
assert !machine.boot(model="iicx", rom="${$ROM}", video_card="824gc", slots="9=display_card_24ac") "video_card= and slots= disagreeing about a slot must be rejected"
assert machine.id == "iicx" "machine survives every rejected boot"
assert machine.config.ram == 8192 "record intact after rejected boots"

# --- Non-inheritance: omitted fields resolve to the MODEL's defaults. ---
machine.boot model="iicx" ram=16384 rom="${$ROM}" video_card="824gc"
assert machine.config.ram == 16384 "explicit ram recorded"
assert machine.config.video_card == "824gc" "explicit card recorded"
machine.boot model="iicx" rom="${$ROM}"
assert machine.config.ram == 8192 "omitted ram must be the model default, not the record's 16384"
assert machine.config.video_card == "" "omitted video_card must not come from the record"
assert machine.nubus.slot[9].card.name == "Apple Macintosh Display Card 8•24" "omitted card must resolve to the slot default"
assert machine.rom.loaded == true "boot must stage the ROM"

# --- slots=: the 24AC in socket $9. ---
machine.boot model="iicx" rom="${$ROM}" slots="9=display_card_24ac"
assert machine.nubus.slot[9].card.name == "Apple Macintosh Display Card 24AC" "per-slot entry not honoured"
# The next document says nothing about the slot: its default again.
machine.boot model="iicx" rom="${$ROM}"
assert machine.nubus.slot[9].card.name == "Apple Macintosh Display Card 8•24" "a slot entry must not outlive its document"
# none empties a socket, even one with a declared default.
machine.boot model="iicx" rom="${$ROM}" slots="9=none"
assert try(machine.nubus.slot[9].card.name, none) == none "slots=9=none must leave socket $9 empty"

# --- Sugar: video_card= applies to the machine's first socket. ---
machine.boot model="iicx" rom="${$ROM}" video_card="824gc"
assert machine.nubus.slot[9].card.name == "Apple Macintosh Display Card 8•24 GC" "video_card= not applied to first socket"
assert machine.config.video_card == "824gc" "record video_card"
assert machine.config.vroms != "[]" "vroms record must list resolved picks"

# --- The record lists the seated cards, including the socket video_card=
# cannot name. ---
machine.boot model="iicx" rom="${$ROM}" slots="9=display_card_24ac;10=824gc"
assert machine.config.slot_cards == "[{\"bus\":\"nubus\",\"slot\":9,\"card_id\":\"display_card_24ac\"}, {\"bus\":\"nubus\",\"slot\":10,\"card_id\":\"824gc\"}]" "both populated sockets must appear in the record"
# ...and a slot the document says nothing about resolves its default.
machine.boot model="iicx" rom="${$ROM}"
assert machine.config.slot_cards == "[{\"bus\":\"nubus\",\"slot\":9,\"card_id\":\"mdc_8_24\"}]" "a default-populated socket is recorded"

# --- A slot's video mode: the 8-bpp seed reaches its card. ---
machine.boot model="iicx" rom="${$ROM}" slots="9=824gc,mode=gc_640x480_8bpp"
assert machine.nubus.slot[9].card.name == "Apple Macintosh Display Card 8•24 GC" "mode test: card not seated"
assert machine.nubus.slot[9].card.mode.depth == 8 "the slot's video mode did not set 8 bpp"

# --- Checkpoint round-trip of the built-from record. ---
machine.boot model="iicx" ram=16384 rom="${$ROM}" slots="9=824gc,mode=gc_640x480_8bpp;10=display_card_24ac"
scheduler.run 100000
assert checkpoint.save("${$WORK_DIR}/bootcfg.checkpoint") "checkpoint save"
machine.boot model="iicx" rom="${$ROM}" video_card="display_card_24ac"
assert machine.config.video_card == "display_card_24ac" "pre-restore record differs"
assert checkpoint.load("${$WORK_DIR}/bootcfg.checkpoint") "checkpoint load"
assert machine.config.model == "iicx" "restored record model"
assert machine.config.ram == 16384 "restored record ram"
assert machine.nubus.slot[9].card.name == "Apple Macintosh Display Card 8•24 GC" "restored machine: slot $9's card"
assert machine.nubus.slot[10].card.name == "Apple Macintosh Display Card 24AC" "restored machine: slot $A's card"
# Under a non-inheriting boot a bare machine.boot after restore is an error.
assert !machine.boot() "bare machine.boot after restore must be rejected"

# --- vrom= pins a revision: the record's resolved-pick list shows the v1.0
# ROM (crc $9E9857E8) used instead of the catalog-preferred v1.1. ---
machine.boot model="iicx" rom="${$ROM}" video_card="824gc" vrom="../../data/roms/824gc-v1.0-reva-9e9857e8.vrom"
assert machine.config.vroms == "[{\"card_id\":\"824gc\",\"path\":\"../../data/roms/824gc-v1.0-reva-9e9857e8.vrom\",\"crc\":\"0x9e9857e8\"}]" "vrom= v1.0 must be used over the preferred v1.1"
# ...for that document only: the next boot without vrom= resolves the
# catalog-preferred v1.1 again (a boot never writes the catalog).
machine.boot model="iicx" rom="${$ROM}" video_card="824gc"
assert machine.config.vroms[0].crc == "0xd722b053" "the previous boot's vrom= must not outlive it"
# A slot's own rom= does the same for that slot alone: two GCs, two revisions.
machine.boot model="iicx" rom="${$ROM}" slots="9=824gc,rom=../../data/roms/824gc-v1.0-reva-9e9857e8.vrom;10=824gc"
assert machine.config.vroms[0].crc == "0x9e9857e8" "slot $9 runs its own rom="
assert machine.config.vroms[1].crc == "0xd722b053" "slot $A resolves the catalog's preferred revision"
# vrom= is the ROM of every slot whose card it provides.
machine.boot model="iicx" rom="${$ROM}" slots="9=824gc;10=824gc" vrom="../../data/roms/824gc-v1.0-reva-9e9857e8.vrom"
assert machine.config.vroms[0].crc == "0x9e9857e8" "vrom= reaches slot $9"
assert machine.config.vroms[1].crc == "0x9e9857e8" "vrom= reaches slot $A"

# --- The built-in monitor strap (PDM) is part of the record: checkpoint.load
# builds with it.  monitor=none leaves the port unconnected, so the machine
# has no screen until a card provides one. ---
let pdm_rom = "../../data/roms/pm6100-pm7100-pm8100-9feb69b3.rom"
machine.boot model="pm7100" rom=$pdm_rom monitor="none"
assert machine.config.monitor == "none" "record carries the monitor strap"
assert machine.screen.width == 0 "monitor=none: no built-in screen"
assert checkpoint.save("${$WORK_DIR}/monitor.checkpoint") "checkpoint save (pm7100)"
machine.boot model="pm7100" rom=$pdm_rom
assert machine.screen.width == 640 "default strap: the built-in 640x480"
assert checkpoint.load("${$WORK_DIR}/monitor.checkpoint") "checkpoint load (pm7100)"
assert machine.config.monitor == "none" "restored record carries the strap"
assert machine.screen.width == 0 "restored machine has no built-in screen"

# --- A model change carries nothing (the v0.8.0 staging regression). ---
# video_card / video_mode / video_sense / vrom name a card in a slot, so
# they describe the model they were captured on and no other.  Under the
# old inheritance rule they followed the user onto a machine that could not
# host them: booting an SE/30 (or IIcx) and then a 660AV in one session
# failed with "model 'q660av' has no NuBus slots for video_card 'se30'".
# The AV machines declare no NuBus slots at all, so they are the strict case.
machine.boot model="iicx" rom="${$ROM}" video_card="824gc"
assert machine.config.video_card == "824gc" "precondition: record carries a card"
assert machine.boot(model="q660av", rom="../../data/roms/q840av-q660av-5bf10fd1.rom") "a slotless model must boot cleanly after a carded one"
assert machine.config.video_card == "" "the old card must not enter the new record"
# Coming back does not resurrect it either — the IIcx boots on its slot default.
assert machine.boot(model="iicx", rom="${$ROM}") "back to a carded model"
assert machine.config.video_card == "" "video_card must not survive any model change"
assert machine.nubus.slot[9].card.name == "Apple Macintosh Display Card 8•24" "slot default after the round trip"

quit
