# Integration test: synthetic resource-fork VFS tree.
# Runner cd's into this directory; paths are relative.

# Mount the System 6 floppy explicitly so the rest of the script uses a
# stable image-VFS path.
files.probe ../../data/systems/System_6_0_8.dsk

# /rsrc on a file with a non-empty resource fork must surface as a directory.
files.path_exists ../../data/systems/System_6_0_8.dsk/partition1/System\ Folder/Finder/rsrc

# Resource types enumerate.  The classic Finder uses CODE / MENU / STR# /
# vers / DLOG / ICN# / ... — we don't assert exact ordering here, just
# expect the listing to come back non-empty.
files.ls ../../data/systems/System_6_0_8.dsk/partition1/System\ Folder/Finder/rsrc/

# CODE IDs enumerate; .info sidecars appear immediately after their bin.
files.ls ../../data/systems/System_6_0_8.dsk/partition1/System\ Folder/Finder/rsrc/CODE/

# vers/1 exists as bytes and as a .info sidecar.
files.path_exists ../../data/systems/System_6_0_8.dsk/partition1/System\ Folder/Finder/rsrc/vers/1
files.path_exists ../../data/systems/System_6_0_8.dsk/partition1/System\ Folder/Finder/rsrc/vers/1.info

# .info sidecar JSON is small + well-formed.
files.cat ../../data/systems/System_6_0_8.dsk/partition1/System\ Folder/Finder/rsrc/vers/1.info

# _raw escape hatch exposes the full fork bytes.
files.path_exists ../../data/systems/System_6_0_8.dsk/partition1/System\ Folder/Finder/rsrc/_raw

# Bogus type 4-CC cleanly returns ENOENT (no hang / crash).
files.path_exists ../../data/systems/System_6_0_8.dsk/partition1/System\ Folder/Finder/rsrc/BADX
files.path_exists ../../data/systems/System_6_0_8.dsk/partition1/System\ Folder/Finder/rsrc/CODE/9999

# Folders never gain a synthetic /rsrc/... subtree.
files.path_exists ../../data/systems/System_6_0_8.dsk/partition1/System\ Folder/rsrc

# Recursive copy of the synthetic tree out to the host.  Reads every leaf;
# any path-resolution bug would surface as a failed cp.
files.cp ../../data/systems/System_6_0_8.dsk/partition1/System\ Folder/Finder/rsrc/ "$WORK_DIR/rsrc-dump/" recursive=true
files.ls "$WORK_DIR/rsrc-dump"

# Drop the mount on the way out so the next test starts from a clean slate.
let n = files.mounts.find("../../data/systems/System_6_0_8.dsk")
files.mounts[$n].unmount

quit
