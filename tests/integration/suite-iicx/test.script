# Macintosh IIcx suite (see config.mk for why this suite is small).
#
# Row map (former directory → row):
#
#   iicx-chime        iicx-boot-chime: sample-exact ASC wavetable chime
#                     through the producer path
#   iicx-gc-accel8    the 8•24 GC accelerated at 8 bpp with the counters
#                     asserted, plus the absorbed iicx-824gc-adb-mouse
#                     cursor-tracking checks
#   iicx-gc-decline8  the decline half of that differential ORACLE: same
#                     golden, accelerator forced to the fallback
#   iicx-24ac         iicx-24ac: the 24AC under 7.1 at 8 bpp — desktop,
#                     Apple menu, control-panel scroll, PLUS the engine
#                     counters §3.2 says nothing asserted
#   iicx-24ac-restart iicx-24ac-restart: warm restart back to the 8 bpp
#                     desktop
#   iicx-gc-beep      iicx-824gc-beep: Control Panel, two Speaker Volume
#                     drags, two sample-exact beeps + the ASC volume
#                     register — kept on this host, see the row comment

include "../lib/mac.script"

let hd_608_gc = "../../data/systems/system_6_0_8_20mb_8_24gc.img"

# ---- iicx-chime -------------------------------------------------------------
# Frame-exact capture window (§5.2 run_exact): the 12 M budget and the
# 15,359-frame length are both the assertion.
def row_iicx_chime() {
    machine.boot model="iicx" ram=8192
    machine.sound.capture.start
    scheduler.run 12000000
    machine.sound.capture.stop
    assert machine.id == "iicx" "iicx-chime: machine.id != iicx"
    assert machine.sound.capture.frames == 15359 "iicx-chime: unexpected capture length"
    machine.sound.match goldens/iicx-chime.wav
    report_perf("suite-iicx/iicx-chime", scheduler.instr_count)
}


# ---- iicx-gc-accel8 / iicx-gc-decline8 --------------------------------------
# The 8•24 GC's accel/decline differential pair at 8 bpp. §7 keeps this
# pair on the IIcx (the 1 bpp pair re-hosted to suite-iix) because the
# 6.0.8 GC image is this host's home media and because a differential
# pair must share a host by construction: both rows match the SAME
# golden, since a correct accelerated render and a correct ROM/QuickDraw
# fallback are pixel-identical by design. That is exactly why pixels
# cannot prove engagement — the gc.* counters do.
#
# The accel row also absorbs iicx-824gc-adb-mouse (§2.3): rather than
# re-running the same 200 M-cycle boot to reach a few lowmem asserts, the
# cursor-tracking checks run after the golden matched. They guard a real
# regression — an aborted ADB Talk used to lose the delta, so MTemp,
# RawMouse and Mouse are all asserted, which also proves the slot VBL
# task is firing.
def gc_boot_8bpp() {
    machine.rtc.time = 3000000000
    machine.boot model="iicx" ram=8192 video_card="824gc" video_mode="gc_640x480_8bpp"
    machine.scsi.attach_hd "${$hd_608_gc}" 0
}

def row_iicx_gc_accel8() {
    gc_boot_8bpp()
    scheduler.run 200000000
    wait_stable(600000000)
    assert machine.nubus.slot[9].card.gc.on == true "iicx-gc-accel8: accelerator did not turn on"
    assert machine.nubus.slot[9].card.gc.state == "gc-on" "iicx-gc-accel8: accelerator state != gc-on"
    assert machine.nubus.slot[9].card.gc.error == 0 "iicx-gc-accel8: accelerator posted an error"
    assert machine.nubus.slot[9].card.gc.rpc_count > 0 "iicx-gc-accel8: no RPCs serviced"
    assert machine.nubus.slot[9].card.gc.queue_bytes > 100 "iicx-gc-accel8: geometry queue never drained"
    assert machine.screen.width == 640 "iicx-gc-accel8: screen width != 640"
    assert machine.screen.height == 480 "iicx-gc-accel8: screen height != 480"
    assert machine.screen.depth == 8 "iicx-gc-accel8: screen depth != 8"
    check("goldens/iicx-6.0.8-640x480x8-gc-finder.png")
    report_row("6.0.8", "824gc", "hd-boot gc-accel-on 8bpp rpc-counted")

    # Absorbed from iicx-824gc-adb-mouse: cursor tracking through the real
    # ADB path. Mouse starts at (15,15) and the deltas must land in all
    # three lowmem cursor globals.
    assert machine.memory.peek.l(0x830) == 0x000F000F "iicx-gc-accel8: Mouse != (15,15) after boot"
    machine.adb.mouse.move 40 40 "hw"
    scheduler.run 20000000
    assert machine.memory.peek.l(0x828) == 0x00370037 "iicx-gc-accel8: MTemp: ADB delta not consumed (aborted-Talk delta loss)"
    assert machine.memory.peek.l(0x82C) == 0x00370037 "iicx-gc-accel8: RawMouse: cursor task did not run (slot VBL not firing)"
    assert machine.memory.peek.l(0x830) == 0x00370037 "iicx-gc-accel8: Mouse != (55,55) after +40,+40"
    machine.adb.mouse.move -20 10 "hw"
    scheduler.run 20000000
    assert machine.memory.peek.l(0x830) == 0x00410023 "iicx-gc-accel8: Mouse != (35,65) after -20,+10"
    report_perf("suite-iicx/iicx-gc-accel8", scheduler.instr_count)
}

def row_iicx_gc_decline8() {
    machine.rtc.time = 3000000000
    machine.boot model="iicx" ram=8192 video_card="824gc" video_mode="gc_640x480_8bpp"
    machine.nubus.slot[9].card.gc.force_decline = true
    machine.scsi.attach_hd "${$hd_608_gc}" 0
    scheduler.run 200000000
    wait_stable(600000000)
    assert machine.nubus.slot[9].card.gc.force_decline == true "iicx-gc-decline8: force_decline lost"
    assert machine.nubus.slot[9].card.gc.on == true "iicx-gc-decline8: accelerator did not turn on"
    assert machine.nubus.slot[9].card.gc.error == 0 "iicx-gc-decline8: accelerator posted an error"
    assert machine.nubus.slot[9].card.gc.rpc_count > 0 "iicx-gc-decline8: no RPCs serviced"
    assert machine.screen.width == 640 "iicx-gc-decline8: screen width != 640"
    assert machine.screen.depth == 8 "iicx-gc-decline8: screen depth != 8"
    # The oracle: the SAME golden as the accel row above.
    check("goldens/iicx-6.0.8-640x480x8-gc-finder.png")
    report_perf("suite-iicx/iicx-gc-decline8", scheduler.instr_count)
}


# ---- iicx-gc-beep -----------------------------------------------------------
# The former iicx-824gc-beep test, folded in as a row on its ORIGINAL host
# and mode (IIcx, 1 bpp). §7 wanted the beep to travel to the IIx with the
# 1 bpp accel/decline pair; measurement says it should not. Its strongest
# assertion is that the two beeps are byte-identical pre-volume — the guard
# proving no Sound Manager state (wavetable fill, phase accumulators, FIFO
# pointers) leaks from one beep into the next. On the 68020 IIx that
# invariant does NOT reproduce: the second capture runs 3 frames longer and
# the waveforms diverge ~31 frames in, so re-hosting would have traded a
# real oracle for two per-host baselines. Whether that divergence is a
# capture-phase artifact or genuine leakage on the 020 path is unresolved
# and worth a look; until then the guard stays where it holds.
#
# The choreography (Control Panel, two Speaker Volume drags, the exact
# slider pixel coordinates) is copied verbatim from the original test.
def row_iicx_gc_beep() {
    # Boots on the card's DEFAULT mode, with no video_mode staged — and
    # that is load-bearing. Staging the nominally identical
    # "gc_640x480_1bpp" produces the same two screen goldens but shifts
    # the beep timing enough that the second capture stops being
    # byte-identical to the first (measured 2026-07-28), which would
    # destroy this row's whole point. So the row must run BEFORE the
    # 8 bpp rows, before anything stages a mode into the built-from
    # record that machine.boot would inherit; the depth assert below
    # fails loudly if that ordering is ever broken.
    machine.boot model="iicx" ram=8192 video_card="824gc"

    # Pin the RTC so the run is deterministic. This must come AFTER machine.boot
    # (which resets the RTC to the host wall clock) — the Control Panel's clock
    # is visible in the golden, so an unpinned RTC changes pixels run-to-run.
    machine.rtc.time = 3000000000

    machine.scsi.attach_hd "../../data/systems/system_6_0_8_20mb_8_24gc.img" 0
    scheduler.run 200000000

    # --- The Finder desktop, drawn by the card (accelerator ON). ---
    assert machine.nubus.slot[9].card.gc.on == true "accelerator did not turn on"
    check("goldens/iicx-6.0.8-640x480x1-gc-finder.png")

    # --- Open the Control Panel from the Apple menu. ---
    # Held mouse-down at the Apple menu (25,10) drops the menu; "Control Panel"
    # sits at y=139; releasing over it launches the DA (General cdev selected).
    machine.adb.mouse.move 50 50 "global"
    scheduler.run 5000000
    machine.adb.mouse.move 25 10 "global"
    scheduler.run 3000000
    machine.adb.mouse.click true
    scheduler.run 8000000
    machine.adb.mouse.move 68 139 "global"
    scheduler.run 3000000
    machine.adb.mouse.click false
    scheduler.run 60000000
    check("goldens/iicx-6.0.8-640x480x1-gc-control-panel.png")

    # --- Drag the Speaker Volume slider from level 3 to 5. ---
    # The slider track is at x=458; the level-3 knob center is y=248 and each
    # level is ~11.5 px. The knob itself must be pressed (the track is inert),
    # and the drag needs intermediate steps for the control to track it. On
    # release the Sound Manager plays the confirmation beep at the new volume:
    # mode 2 wavetable, one clean mode 2->0 window, with the decay envelope
    # re-rendering the 512-byte voice table in place ~14 times mid-play.
    machine.sound.capture.start
    machine.adb.mouse.move 458 248 "global"
    scheduler.run 3000000
    machine.adb.mouse.click true
    scheduler.run 3000000
    machine.adb.mouse.move 458 242 "global"
    scheduler.run 2000000
    machine.adb.mouse.move 458 236 "global"
    scheduler.run 2000000
    machine.adb.mouse.move 458 230 "global"
    scheduler.run 2000000
    machine.adb.mouse.move 458 225 "global"
    scheduler.run 2000000
    machine.adb.mouse.click false
    scheduler.run 40000000

    # The beep window is Sound-Manager-controlled: mode 2 for exactly 5,423
    # samples (22,257 Hz), captured pre-resampling/pre-volume.
    check_sound("goldens/iicx-gc-beep.wav", 5423)

    # Sample-exact compare against the golden (fails the test on any divergence).
    # Loudness does NOT appear in the capture: the sink is pre-volume, and the
    # slider level lands in the ASC volume register (post-DAC attenuation the
    # host applies at playback). The register is asserted directly instead.
    assert machine.sound.volume == 5 "ASC volume register != slider level 5"

    # --- Drag the slider one more notch, from level 5 to 6: a second beep. ---
    # The level-5 knob center is y=225, level 6 is y=214. A second, separately
    # captured beep guards the beep path's repeatability (the Sound Manager
    # re-renders the wavetable from scratch each time; state left over from the
    # first beep — table fill, phase accumulators, FIFO pointers — must not leak
    # into the next one).
    machine.sound.capture.start
    machine.adb.mouse.move 458 225 "global"
    scheduler.run 3000000
    machine.adb.mouse.click true
    scheduler.run 3000000
    machine.adb.mouse.move 458 221 "global"
    scheduler.run 2000000
    machine.adb.mouse.move 458 217 "global"
    scheduler.run 2000000
    machine.adb.mouse.move 458 214 "global"
    scheduler.run 2000000
    machine.adb.mouse.click false
    scheduler.run 40000000

    check_sound("goldens/iicx-gc-beep2.wav", 5423)
    # The pre-volume waveform is identical to the first beep (beep2.wav ==
    # beep.wav byte-for-byte): the Sound Manager re-renders the same table and
    # no state leaks between beeps. The second beep is LOUDER only through the
    # volume register, asserted below.
    assert machine.sound.volume == 6 "ASC volume register != slider level 6"
    report_perf("suite-iicx/iicx-gc-beep", scheduler.instr_count)
}


# ---- iicx-24ac / iicx-24ac-restart ------------------------------------------
# The 24AC's OS-level rows, folded in from iicx-24ac and iicx-24ac-restart.
# §7 wanted these re-hosted to the IIci so the card would sit beside a live
# RBV; measurement says only half of that works. On the IIci the built-in
# video stays the boot screen (PRAM $80..$81 seeding does not move it), so
# machine.screen would capture the RBV and the 24AC's own pixels — the
# whole point of these rows — would stop being observable. They therefore
# stay on the IIcx, where the 24AC is the only display, and the IIci gets
# a dual-display row of its own (suite-iici's iici-24ac-dual) for the
# second-screen cell §7 was after. Choreography copied verbatim.
def row_iicx_24ac() {
    # Integration test: IIcx + Display Card 24AC — boot the 32-bit SCSI cdev image
    # to an 8-bpp COLOUR Finder desktop.
    #
    # Unlike iicx-display-card-24ac (which boots the floppy System 7.0.1 with the
    # $017A boot-wait poke and exercises the engine via memory.poke/peek), this
    # boots the genuine "Step B" artifact: systems/system_7_1_20mb_24ac_cd_32bit_gc.img
    # — a 20 MB System 7.1 SCSI HD with the 24AC cdev pre-installed and 32-bit
    # addressing on.  So the cdev binds at boot and drives the real card end-to-end
    # (proposal-nubus-card-display-card-24ac §3.7 Step B).
    #
    # The image is stored as a .7z in gs-test-data (systems/) and auto-extracted by
    # scripts/fetch-test-data.sh, so the raw .img is present under tests/data.

    # Select the 24AC card and an 8-bpp 640x480 mode BEFORE boot.  The video_mode
    # pick seeds a COMPLETE valid PRAM ('NuMc' validity + PRAMInitTbl boot-device
    # defaults + the slot sPRAMRec savedMode $82) — which both selects 8-bpp colour
    # AND arms the 32-bit SCSI HD boot in one shot (commit a08f30d).  (video_card
    # can't be an arg, so the harness booted the default card; we re-boot here.)
    machine.boot model="iicx" ram=8192 video_card="display_card_24ac" video_mode="rgb_640x480_8bpp"

    # Attach the cdev HD at SCSI ID 0 (the boot device) and run to the desktop.
    # The complete valid PRAM lets the ROM boot straight from SCSI (no cold-init
    # scan).  The image reaches a stable Finder by ~150M instr; 200M gives margin
    # and the frame is steady well beyond it.
    machine.scsi.attach_hd "../../data/systems/system_7_1_20mb_24ac_cd_32bit_gc.img" 0
    scheduler.run 200000000

    # The card that booted into the IIcx video slot ($9) is the 24AC, not the
    # slot-default 8•24 — i.e. machine.nubus.video_card took effect.
    assert machine.nubus.slot[9].card.name == "Apple Macintosh Display Card 24AC" "slot $9 card != 24AC"
    # 8-bpp colour at 640x480: MODE depth bits 7-5 == 0x40, framebuffer 8 bpp.
    assert machine.screen.width == 640 "boot: screen width != 640"
    assert machine.screen.height == 480 "boot: screen height != 480"
    assert (machine.memory.peek.b(0xF9D80001) & 0xE0) == 0x40 "boot: MODE depth latch != 8 bpp"
    assert machine.nubus.slot[9].card.framebuffer.depth == 8 "boot: framebuffer not 8 bpp"
    # The 8-bpp colour Finder desktop, booted from the SCSI HD, pixel-exact.
    check("goldens/iicx-7.1-640x480x8-24ac-finder-640x480-8bpp.png")

    # Open the Apple menu with a held mouse-down (press and hold — the menu stays
    # down while the button is held), same global-mode geometry as iici-boot
    # (Apple menu at 25,10).  This drives the menu draw through the 24AC
    # acceleration engine's run-length fill — the first test that exercises the
    # engine end-to-end (32-bit mode + the cdev installed).
    #
    # Regression guard for the engine fill run-length flag bug (display_card_24ac.c
    # engine_fill_run): the live cdev OR-s a command flag (bit 30) into each fill's
    # run-length write; before the fix the engine took the whole longword as the
    # byte count and each fill ran to end-of-VRAM.  The boot desktop's top-to-bottom
    # full-width fills self-corrected, but the Apple menu's narrow bottom-up fills
    # smeared the desktop into solid white/black bands.  The baseline below is the
    # corrected render: the menu over an intact gray desktop.
    machine.adb.mouse.move 50 50 "global"
    scheduler.run 5000000
    machine.adb.mouse.move 25 10 "global"
    scheduler.run 3000000
    machine.adb.mouse.click true
    scheduler.run 8000000
    check("goldens/iicx-7.1-640x480x8-24ac-applemenu-640x480-8bpp.png")

    # --- Part 3: vertical scroll through the engine's block-copy ($7F) path. ---
    # Dismiss the Apple menu (release over the desktop → no selection), then open
    # Control Panels, switch to "by Name" (a list taller than the window → a real
    # vertical scrollbar) and hold the down-arrow.  Each scrolled line is a
    # VRAM→VRAM ScrollRect the cdev runs as an engine block copy (CONTROL=$7F).
    #
    # Regression guard for the engine block-copy bug (engine_store_long): $7F is a
    # two-write handshake (no-flag source-latch + bit-30-flagged copy trigger), NOT
    # "store the written longword as source pixels".  The old model stored the
    # command words as pixels, tearing the scrolled list into garbled rows; the
    # baseline is the correctly-scrolled list.
    machine.adb.mouse.move 320 350 "global"
    scheduler.run 2000000
    machine.adb.mouse.click false
    scheduler.run 6000000
    machine.adb.mouse.move 25 10 "global"
    scheduler.run 2000000
    machine.adb.mouse.click true
    scheduler.run 6000000
    machine.adb.mouse.move 25 132 "global"
    scheduler.run 5000000
    machine.adb.mouse.click false
    scheduler.run 80000000
    machine.adb.mouse.move 125 10 "global"
    scheduler.run 3000000
    machine.adb.mouse.click true
    scheduler.run 5000000
    machine.adb.mouse.move 140 62 "global"
    scheduler.run 4000000
    machine.adb.mouse.click false
    scheduler.run 40000000
    machine.adb.mouse.move 411 214 "global"
    scheduler.run 4000000
    machine.adb.mouse.click true
    scheduler.run 35000000
    machine.adb.mouse.click false
    scheduler.run 8000000
    check("goldens/iicx-7.1-640x480x8-24ac-cp-scroll-640x480-8bpp.png")
    # §3.2's missing proof: no OS-level test asserted the 24AC's engine
    # counters, so engine use was only ever INFERRED from goldens that a
    # fallback render would reproduce exactly. These make it explicit.
    assert machine.nubus.slot[9].card.engine.fill_ops > 0 "iicx-24ac: engine did no fills — accelerator never engaged"
    assert machine.nubus.slot[9].card.engine.fill_bytes > 0 "iicx-24ac: engine filled no bytes"
    report_row("7.1", "display_card_24ac", "hd-boot 8bpp engine-counted menus scroll")
    report_perf("suite-iicx/iicx-24ac", scheduler.instr_count)
}

def row_iicx_24ac_restart() {
    # Integration test: IIcx + Display Card 24AC — Finder "Restart" reboots cleanly
    #
    # Regression guard for the warm-restart hang: on a IIcx with the 24AC card that
    # booted the 32-bit SCSI cdev image (systems/system_7_1_20mb_24ac_cd_32bit_gc.img),
    # picking Special ▸ Restart in the Finder used to wedge with distorted VRAM.
    # The Mac restart runs the ROM warm-boot path (mask IRQs → 68k RESET → set up
    # MMU → jump to the boot entry); the RESET instruction is meant to reset the
    # external peripherals via the bus /RESET line.  That instruction was a no-op,
    # so the SCSI controller and the 24AC card kept stale OS-session state — the
    # rebooting ROM painted garbage and then aborted in scsi.c write_mr.  Fixed by
    # modelling the /RESET line (OP_RESET → system_reset_devices).  This test drives
    # the real Special ▸ Restart and confirms the machine reboots to the desktop.
    #
    # The boot half mirrors iicx-24ac (see that test for the full commentary): the
    # rgb_640x480_8bpp video_mode pick seeds a COMPLETE valid PRAM ('NuMc' validity
    # + PRAMInitTbl boot-device defaults + slot savedMode $82) so the ROM boots
    # straight from the SCSI HD to an 8-bpp COLOUR Finder desktop.

    # === Boot the 24AC 32-bit SCSI cdev image to the 8-bpp Finder desktop. ======
    machine.boot model="iicx" ram=8192 video_card="display_card_24ac" video_mode="rgb_640x480_8bpp"
    machine.scsi.attach_hd "../../data/systems/system_7_1_20mb_24ac_cd_32bit_gc.img" 0
    scheduler.run 200000000

    # Sanity: the 24AC booted into the IIcx video slot ($9) at 8-bpp 640x480 and we
    # are sitting on the colour Finder desktop (pixel-exact, shared iicx-24ac baseline).
    assert machine.nubus.slot[9].card.name == "Apple Macintosh Display Card 24AC" "boot: slot $9 card != 24AC"
    assert machine.screen.width == 640 "boot: screen width != 640"
    assert machine.screen.height == 480 "boot: screen height != 480"
    assert machine.nubus.slot[9].card.framebuffer.depth == 8 "boot: framebuffer not 8 bpp"
    check("goldens/iicx-7.1-640x480x8-24ac-finder-640x480-8bpp.png")

    # === Pick Special ▸ Restart with a real press-and-hold-drag-release. =========
    # The Special menu title sits at (235,10); the "Restart" item is at (245,124)
    # in the open menu (see the geometry in the reproduction notes).  Press and
    # hold on the title to pull the menu down, drag to Restart, release to choose
    # it — exactly the user's interaction.
    machine.adb.mouse.move 235 10 "global"
    scheduler.run 2000000
    machine.adb.mouse.click true
    scheduler.run 4000000
    machine.adb.mouse.move 245 124 "global"
    scheduler.run 2000000
    machine.adb.mouse.click false
    scheduler.run 3000000

    # === A healthy restart reboots all the way back to the 8-bpp Finder. ========
    # The Finder tears down and the machine re-enters the boot ROM; the armed PRAM
    # boots the same SCSI HD again, back to the colour desktop.  Give it a full
    # boot budget (250M — the cold boot above reaches a stable Finder well inside
    # 200M).
    #
    # BUG (what this test reproduces): instead of rebooting, the machine hangs in
    # the ROM's QuickDraw bitBlt inner loop (PC parked around $4081ADE8) with a
    # corrupt destination bitmap, so the framebuffer fills with garbage and the
    # card is left in the ROM's 1-bpp power-on depth — it never gets back to the
    # 8-bpp desktop.  The two assertions below therefore FAIL on the current code
    # and PASS once the restart is fixed.
    scheduler.run 250000000

    # Robust signal: after a clean reboot the OS/cdev has re-selected 8-bpp colour.
    # The bug left the card in the ROM boot's 1-bpp mode (and then aborted in SCSI).
    assert machine.screen.width == 640 "restart: screen width != 640"
    assert machine.screen.height == 480 "restart: screen height != 480"
    assert machine.nubus.slot[9].card.framebuffer.depth == 8 "restart: did not reboot to 8-bpp desktop (hung in 1-bpp ROM boot)"

    # Park the cursor back at the top-left boot position — the ADB mouse was left
    # over the Restart menu item, so the only thing separating the rebooted desktop
    # from the cold-boot baseline is where the cursor sprite sits.  Move it into the
    # top-left corner and exclude that small box (rows 12-34, cols 10-30) from the
    # compare, so the match turns on the desktop content, not the cursor hotspot.
    machine.adb.mouse.move 14 15 "global"
    scheduler.run 3000000
    machine.screen.save "$WORK_DIR/after-restart.png"
    # Definitive end state: the machine is back on the 8-bpp colour Finder desktop,
    # pixel-exact against the same baseline the cold boot produces (iicx-24ac).
    check_ex("goldens/iicx-7.1-640x480x8-24ac-finder-640x480-8bpp.png", 12, 10, 34, 30)
    report_perf("suite-iicx/iicx-24ac-restart", scheduler.instr_count)
}

if row_on("iicx-chime") { row_end("iicx-chime", try(row_iicx_chime(), "FAILED")) }
# iicx-gc-beep runs before the 8 bpp rows on purpose — see its comment.
if row_on("iicx-gc-beep") { row_end("iicx-gc-beep", try(row_iicx_gc_beep(), "FAILED")) }
if row_on("iicx-gc-accel8") { row_end("iicx-gc-accel8", try(row_iicx_gc_accel8(), "FAILED")) }
if row_on("iicx-gc-decline8") { row_end("iicx-gc-decline8", try(row_iicx_gc_decline8(), "FAILED")) }
if row_on("iicx-24ac") { row_end("iicx-24ac", try(row_iicx_24ac(), "FAILED")) }
if row_on("iicx-24ac-restart") { row_end("iicx-24ac-restart", try(row_iicx_24ac_restart(), "FAILED")) }

suite_done()
quit
