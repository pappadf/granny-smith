# TNT MESH disk boot on the pm8500 (604) — the 604 boot-wall row.
# Same script as tnt-hd-boot with model=pm8500: the machine that used
# to die in the boot Name-Registry import (the split-store update-loss
# bug in the 604 model, fixed on branch tnt-604-boot-wall) boots
# System 7.6 all the way to the Finder desktop.

include "../lib/mac.script"

machine.boot model="pm8500" ram=32768 rom="${$ROM}"
machine.rtc.time = "2026-04-26T21:30:36"
machine.scsi.attach_hd "$WORK_DIR/hd.img" 0

# Through OF, POST, the 68k boot, the gray desktop (T11), the SCSI scan
# (complete MESH transactions against the disk), driver-partition load,
# the boot-volume mount, the Mac OS splash, and the full System 7.6
# startup to the Finder desktop.
scheduler.run 2500000000

# The boot-driver selection matched (XPRAM $77 "Default OS" = 1 through
# the banked NVRAM against the DDM's ddType) and the volume mounted:
# BootDrive carries the boot drive number instead of the scan's $FFFF.
# ($23, not $03: the .Sony driver owns the floppy drive and its drive
# numbers now that the SWIM3 is wired, and the SCSI volume lands after it.)
assert debug.mac.globals.read("BootDrive") == 0x8023 "BootDrive not set (driver match / mount failed)"

# Startup completed without a system error: DSErrCode was explicitly
# cleared by the running system (the scan-era sentinel is $FFFF; the
# old data-phase wall bombed here with $66 dsOldSystem).
assert debug.mac.globals.read("DSErrCode") == 0 "system error during startup"

# The Finder desktop: menu bar, mounted "Macintosh HD" volume, Trash,
# and the Energy Saver first-boot dialog.  The menu-bar clock area is
# excluded — it tracks the pinned RTC plus guest uptime, so it shifts
# whenever model changes move boot timing.
check_ex("finder-desktop.png", 0, 500, 20, 640)

echo "tnt-hd-boot: BootDrive=${debug.mac.globals.read("BootDrive"):04x} dserr=${debug.mac.globals.read("DSErrCode"):04x} ticks=${debug.mac.globals.read("Ticks")}"
quit
