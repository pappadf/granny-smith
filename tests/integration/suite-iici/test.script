# Macintosh IIci suite (see config.mk).
#
# Row map (former directory → row; **bold** = new matrix coverage):
#
#   iici-chime      iici-boot-chime: sample-exact chime WAV (ROM-only row,
#                   8 MB — see the row for why not 1 MB)
#   iici-701-fd     iici-boot: RBV built-in video, 7.0.1 floppy boot,
#                   Finder + About This Macintosh (8 MB)
#   iici-75-hd      **IIci x 7.5**: prepared 7.5 image over the MDU's
#                   NCR 5380 (16 MB — see the row comment for why not 5)
#   iici-76-hd      **IIci x 7.6**: §7 moved the second 7.6 consumer
#                   here because the IIci is clean-ROM 32-bit; 7.6
#                   selects 32-bit itself, so this row is also the
#                   suite's asserted 32-bit addressing cell (32 MB,
#                   which only a 32-bit System can see in full)
#   iici-lowram     the IIci's low-RAM plane: every published sub-8 MB size
#                   sizes correctly (was ledger §3; fixed and enforced)
#   iici-71-hd      **IIci x 7.1** on the built-in RBV — the cell §8 wrongly
#                   believed unreachable (8 MB)
#   iici-24ac-dual  **first OS-level DUAL DISPLAY**: a 24AC in socket $C beside
#                   the live built-in RBV, booting 7.1 to the Finder, with the
#                   24AC engine counters §3.2 wanted asserted. Was ledger §8
#                   (seating the card hung the boot at Welcome); fixed and
#                   enforced.
#   iici-checkpoint **MDU-family checkpoint round-trip** (§7 epilogue):
#                   save → reboot into a different machine → load →
#                   re-match. Was ledger §2 (restored screen came back
#                   blank); fixed and enforced.
#   iici-mactest-diag MacTest 2.11 runs its board-level sequence to the floppy
#                   phase, which means VIA, RBV, sound, clock/PRAM, FPU, SCC
#                   and SCSI all pass. Was ledger §9 (it condemned the machine
#                   as a bad logic board); fixed and enforced.

include "../lib/mac.script"

let sys_701 = "../../data/systems/System_7_0_1.image"
let hd_75 = "../../data/systems/system_7_5_0_77mb_mode32_24ac.img"
let hd_76 = "../../data/systems/system_7_6_170mb_24ac.img"
let hd_71_gc = "../../data/systems/system_7_1_20mb_24ac_cd_32bit_gc.img"
let mactest_img = "../../data/apps/MacTest-IIcx-IIci.image"

# ---- iici-chime -------------------------------------------------------------
# Frame-exact capture window (§5.2 run_exact): the 12 M budget and the
# 13,405-frame length are both the assertion.
#
# Boots at the machine's default 8 MB, like every sibling chime row
# (iicx/iifx 8192, iisi 66560). It used to boot 1024 KB — a size that, until
# the ledger §3 fix landed 2026-07-29, never completed POST. The chime was
# therefore being captured from a machine stuck in RAM sizing; once POST
# completed, the Sound Manager reconfigured the ASC inside the capture window
# and sound.match failed with "sample rate changed mid-capture".
#
# The golden itself did NOT change: the 8 MB capture matches the committed
# iici-chime.wav byte-for-byte at the same 13,405 frames. Only the RAM size
# this row asks for was wrong.
def row_iici_chime() {
    machine.boot model="iici" ram=8192 video_card="builtin_rbv_video"
    machine.sound.capture.start
    scheduler.run 12000000
    machine.sound.capture.stop
    assert machine.ram == 8192 "iici-chime: machine.ram != 8192"
    assert machine.sound.capture.frames == 13405 "iici-chime: unexpected capture length"
    machine.sound.match goldens/iici-chime.wav
    report_perf("suite-iici/iici-chime", scheduler.instr_count)
}

# ---- iici-701-fd ------------------------------------------------------------
# wait_stable (not wait_match) because the row interacts afterwards.
def row_iici_701_fd() {
    machine.boot model="iici" ram=8192 video_card="builtin_rbv_video"
    machine.floppy.drive[0].insert "${$sys_701}"
    scheduler.run 300000000
    wait_stable(900000000)
    assert machine.id == "iici" "iici-701-fd: machine.id != iici"
    assert machine.rom.checksum == "368CADFE" "iici-701-fd: rom.checksum != 368CADFE"
    assert machine.ram == 8192 "iici-701-fd: machine.ram != 8192"
    assert machine.screen.width == 640 "iici-701-fd: screen.width != 640"
    assert machine.screen.height == 480 "iici-701-fd: screen.height != 480"
    assert_addr(false)
    check("goldens/iici-7.0.1-640x480x1-finder.png")
    about_box()
    check("goldens/iici-7.0.1-640x480x1-about.png")
    report_row("7.0.1", "rbv", "fd-boot about")
    report_perf("suite-iici/iici-701-fd", scheduler.instr_count)
}

# ---- iici-701-depths --------------------------------------------------------
# The built-in RBV video at 2, 4 and 8 bpp — the three cells ledger §5 recorded
# as unreachable.
#
# §5 claimed the built-in video "exposes no guest-visible depth mode list, so the
# OS cannot select 2/4/8 bpp", and §12.2 concluded that seeding slot PRAM was the
# wrong lever because a seeded record made no difference. Both were wrong, and
# for the same reason: the seeds were malformed. The mechanism is exactly the one
# iicx-video-modes already uses for the IIcx's JMFB, only on this machine's own
# slot and board ID.
#
# The IIci's built-in video is slot $B (VideoInfoMDU sets SlotPramAddr from slot
# $0B), so its sPRAMRec is PRAM $56..$5D, and its BoardID is ciVidBoardID =
# $001F. Within the record: byte 2 ($58) is the saved depth spID and byte 3
# ($59) the selected video sRsrc spID. $86 is what the ROM computes here on its
# own — bit 7 plus monitor ID 6 ("MacII monitors", 13" RGB) with the sub-1.5 MB
# flag clear — verified by dumping the record after an unseeded boot.
#
# pram.validate first, or PRAMInit rewrites the record during boot and the poke
# looks inert (ledger §12.2). Safe here because these rows boot from floppy; a
# SCSI boot would need the startup device seeded too.
def boot_iici_701_at_depth(spid) {
    machine.boot model="iici" ram=8192 video_card="builtin_rbv_video"
    machine.floppy.drive[0].insert "${$sys_701}"
    machine.rtc.pram.validate
    if $spid == 0x81 { machine.rtc.pram.poke 0x56 0x001f818600000000:8 }
    if $spid == 0x82 { machine.rtc.pram.poke 0x56 0x001f828600000000:8 }
    if $spid == 0x83 { machine.rtc.pram.poke 0x56 0x001f838600000000:8 }
    scheduler.run 300000000
    wait_stable(900000000)
    assert machine.rtc.pram.peek(0x58) == $spid "iici-701-depths: savedMode rewritten by the ROM (wanted ${$spid:02x})"
    assert machine.screen.width == 640 "iici-701-depths: width != 640"
    assert machine.screen.height == 480 "iici-701-depths: height != 480"
}
def row_iici_701_depths() {
    boot_iici_701_at_depth(0x81)
    assert machine.screen.depth == 2 "iici-701-depths: savedMode $81 gave depth ${machine.screen.depth}, want 2"
    check("goldens/iici-7.0.1-640x480x2-finder.png")
    report_row("7.0.1", "rbv", "fd-boot 2bpp")

    boot_iici_701_at_depth(0x82)
    assert machine.screen.depth == 4 "iici-701-depths: savedMode $82 gave depth ${machine.screen.depth}, want 4"
    check("goldens/iici-7.0.1-640x480x4-finder.png")
    report_row("7.0.1", "rbv", "fd-boot 4bpp")

    boot_iici_701_at_depth(0x83)
    assert machine.screen.depth == 8 "iici-701-depths: savedMode $83 gave depth ${machine.screen.depth}, want 8"
    check("goldens/iici-7.0.1-640x480x8-finder.png")
    report_row("7.0.1", "rbv", "fd-boot 8bpp")
    report_perf("suite-iici/iici-701-depths", scheduler.instr_count)
}

# ---- iici-75-hd -------------------------------------------------------------
# NEW CELL IIci x 7.5 over the MDU's NCR 5380 pseudo-DMA path.
# 16 MB, not the 5 MB bank split the RAM axis would have preferred,
# because a IIci does not boot at all below 8 MB — POST never completes
# and no lowmem global is ever written (measured 2026-07-28; tracked as
# an emulator defect in proposal-emulator-bug-fixes.md §3, which is also
# what made an earlier version of this row misread uninitialised memory
# as an addressing mode). At 16 MB the flag reads a clean 0: 7.5 + MODE32
# still boots 24-bit under default PRAM, matching the IIcx measurement.
def row_iici_75_hd() {
    machine.rtc.time = 3000000000
    machine.boot model="iici" ram=16384 video_card="builtin_rbv_video"
    machine.scsi.attach_hd "${$hd_75}" 0
    scheduler.run 300000000
    wait_stable(1500000000)
    assert machine.id == "iici" "iici-75-hd: machine.id != iici"
    assert machine.ram == 16384 "iici-75-hd: machine.ram != 16384"
    assert_addr(false)
    check_ex("goldens/iici-7.5-640x480x1-finder.png", 0, 440, 20, 640)
    report_row("7.5", "rbv", "hd-boot 5380")
    report_perf("suite-iici/iici-75-hd", scheduler.instr_count)
}

# ---- iici-76-hd -------------------------------------------------------------
# NEW CELL IIci x 7.6, and the suite's 32-bit addressing cell: 7.6
# selects 32-bit itself on a clean-ROM machine (measured §3.4), so 32 MB
# is fully visible — the RAM-sizing and addressing axes interact here.
def row_iici_76_hd() {
    machine.rtc.time = 3000000000
    machine.boot model="iici" ram=32768 video_card="builtin_rbv_video"
    machine.scsi.attach_hd "${$hd_76}" 0
    scheduler.run 400000000
    wait_stable(1800000000)
    assert machine.id == "iici" "iici-76-hd: machine.id != iici"
    assert machine.ram == 32768 "iici-76-hd: machine.ram != 32768"
    assert_addr(true)
    check_ex("goldens/iici-7.6-640x480x1-finder.png", 0, 440, 20, 640)
    report_row("7.6", "rbv", "hd-boot 5380 addr32")
    report_perf("suite-iici/iici-76-hd", scheduler.instr_count)
}

# ---- iici-71-hd -------------------------------------------------------------
# NEW CELL IIci x 7.1 on the built-in RBV, and the row that retired a wrong
# ledger entry. §8 recorded "the IIci hangs at Welcome booting either prepared
# 7.1 image", with a no-card control said to hang identically. The control was
# not actually card-free: it ran after iici-24ac-dual in the same suite and, with
# no video_card named, INHERITED that row's 24AC (machine.boot inherits every
# unspecified staging field from the record it was built from). Name the built-in
# video explicitly and 7.1 boots straight to the Finder — measured 2026-07-28.
# The real defect is that a 24AC seated beside the live RBV hangs the boot, which
# is what §8 now says and what iici-24ac-dual now guards.
def row_iici_71_hd() {
    machine.rtc.time = 3000000000
    machine.boot model="iici" ram=8192 video_card="builtin_rbv_video"
    machine.scsi.attach_hd "${$hd_71_gc}" 0
    scheduler.run 300000000
    wait_stable(1200000000)
    assert machine.id == "iici" "iici-71-hd: machine.id != iici"
    assert machine.ram == 8192 "iici-71-hd: machine.ram != 8192"
    assert machine.screen.width == 640 "iici-71-hd: screen.width != 640"
    assert machine.screen.depth == 1 "iici-71-hd: screen.depth != 1"
    # The 24AC must NOT be present: this row exists to prove the card-free path,
    # so an inherited card would make it silently re-measure the §8 hang.
    assert machine.nubus.slot[11].card.name == "Macintosh IIci Built-in Video" "iici-71-hd: slot $B is not the built-in video"
    check("goldens/iici-7.1-640x480x1-finder.png")
    report_row("7.1", "rbv", "hd-boot 5380")
    report_perf("suite-iici/iici-71-hd", scheduler.instr_count)
}

# ---- iici-lowram ------------------------------------------------------------
# The IIci's low-RAM plane: every published sub-8 MB option must complete POST
# and publish its installed size in MemTop.
#
# 5120 KB is the load-bearing one — 5 MB is 4 MB in bank A plus 1 MB in bank B,
# so it is the only row in this suite that exercises the two-bank split at all.
# 1024/2048 are single-bank; 4096 fills bank A exactly.
#
# ROM-only, so the whole sweep costs almost nothing.
#
# This was a milestone row guarding proposal-emulator-bug-fixes.md §3 (POST
# never completed below 8 MB — MemTop read back the $DB6DB6DB
# uninitialised-read pattern, meaning no lowmem global was ever written).
# Fixed 2026-07-29 by modelling the two physical SIMM banks and their 64 MB
# mirror windows in iici_memory_layout_init; promoted to enforced here.
def row_iici_lowram() {
    for kb in [1024, 2048, 4096, 5120] {
        machine.boot model="iici" ram=$kb video_card="builtin_rbv_video"
        scheduler.run 120000000
        assert machine.ram == $kb "iici-lowram: machine.ram != ${$kb}"
        assert debug.mac.globals.read("MemTop") == $kb * 1024 "iici-lowram: POST did not complete at ${$kb} KB — MemTop=${debug.mac.globals.read("MemTop"):08x} want ${$kb * 1024:08x}"
    }
    report_perf("suite-iici/iici-lowram", scheduler.instr_count)
}

# ---- iici-24ac-dual (MILESTONE) ---------------------------------------------
# §7's second-display goal, and the first test anywhere to boot an OS with
# TWO display devices present: a 24AC in socket $C beside the IIci's live
# built-in RBV video. The card-level facts below all hold — both devices
# come up, the RBV keeps the boot screen, and the 24AC's engine really
# runs (§3.2's missing proof of engagement, counters rather than pixels).
#
# What does NOT hold is the boot itself: with the 24AC seated the machine
# hangs at "Welcome to Macintosh" forever (ledger §8).
#
# The card IS the trigger, and an earlier version of this comment said the
# opposite. It claimed a no-card control hung identically "so it is not the
# 24AC" — but that control was a bare `machine.boot` running after this row,
# which inherits every staging field it does not name and so inherited the very
# card it was meant to exclude. Named explicitly, the same 7.1 image boots to
# the Finder: that is now the iici-71-hd row above. Two arms agreeing on an
# EXACT checksum was the clue that they were the same arm.
#
# So the row is a milestone and claims no cell: it asserts what is true,
# then asserts it got past the splash, which fails today. When the 7.1
# boot works, that assert passes on its own — then this row gains its
# desktop golden and a report_row call, and the cell's `blocked` marker
# comes off matrix-targets.json in the same reviewed diff.
def row_iici_24ac_dual() {
    machine.rtc.time = 3000000000
    machine.boot model="iici" ram=8192 video_card="display_card_24ac" video_mode="rgb_640x480_8bpp"
    machine.scsi.attach_hd "${$hd_71_gc}" 0
    scheduler.run 900000000
    wait_stable(1500000000)
    assert machine.id == "iici" "iici-24ac-dual: machine.id != iici"
    # Two display devices, both live.
    assert machine.nubus.slot[11].card.name == "Macintosh IIci Built-in Video" "iici-24ac-dual: slot $B is not the built-in video"
    assert machine.nubus.slot[12].card.name == "Apple Macintosh Display Card 24AC" "iici-24ac-dual: slot $C card != 24AC"
    assert machine.nubus.slot[12].card.framebuffer.depth == 8 "iici-24ac-dual: 24AC framebuffer not 8 bpp"
    # The boot screen is the built-in RBV: seeding the Start Manager's
    # default-video-device pointer (PRAM $80..$81, pram.md §7) does not move
    # it — the ROM rewrites the high byte.
    assert machine.screen.width == 640 "iici-24ac-dual: primary width != 640"
    assert machine.screen.depth == 1 "iici-24ac-dual: primary depth != 1 (did the 24AC become the boot screen?)"
    # §3.2's proof of engagement: counters, not pixels.
    assert machine.nubus.slot[12].card.engine.fill_ops > 0 "iici-24ac-dual: 24AC engine did no fills under the OS"
    assert machine.nubus.slot[12].card.engine.fill_bytes > 0 "iici-24ac-dual: 24AC engine filled no bytes"
    # It reaches the Finder with both displays present. As a milestone this row
    # could only assert a checksum INEQUALITY against the settled "Welcome to
    # Macintosh" frame (-288949432) it used to park on; now it asserts the
    # desktop it actually reaches, and claims the cell.
    # golden-collision-ok: iici-7.1-640x480x1-24ac-dual-finder.png iici-7.1-640x480x1-finder.png
    # - the PRIMARY display is the built-in RBV at 1 bpp in both rows, showing the
    # same settled 7.1 desktop, so the frames are legitimately identical; the 24AC
    # is a SECOND display and its content is not in this framebuffer. What proves
    # the states differ is above and not pixel-based: slot $C is the 24AC, its own
    # framebuffer is 8 bpp, and its blitter engine did non-zero fills under the OS.
    check("goldens/iici-7.1-640x480x1-24ac-dual-finder.png")
    report_row("7.1", "rbv+24ac", "dual-display hd-boot 24ac-engine")
    report_perf("suite-iici/iici-24ac-dual", scheduler.instr_count)
}

# ---- iici-checkpoint --------------------------------------------------------
# §7 epilogue on the MDU device set (RBV, IIci VIA path, 5380): boot to a
# desktop, save, reboot into a DIFFERENT machine (1 MB), load, and re-match the
# pre-save golden. Restoring over a deliberately mismatched machine is the
# point — it proves the restore rebuilds RAM size, devices and display from the
# checkpoint rather than inheriting them.
#
# This was a milestone row guarding proposal-emulator-bug-fixes.md §2: the
# guest state restored but the screen came back BLANK and never repainted,
# because nothing serialised the display CARD. rbv_checkpoint() covered the RBV
# chip registers; VRAM, the active depth/stride and the CLUT were not in the
# save set at all, so a restore re-ran card_init and came up on a zeroed
# framebuffer at the 1 bpp power-up default.
#
# Fixed 2026-07-29: the NuBus layer gained a per-card checkpoint pass and the
# built-in video card implements it. Promoted to enforced here.
#
# Boots at 8 MB, which is what the 7.0.1 golden was captured on — a 2 MB IIci
# never reaches a desktop with 7.0.1 at all, so the smaller RAM config has
# nothing to re-match.
def row_iici_checkpoint() {
    machine.boot model="iici" ram=8192 video_card="builtin_rbv_video"
    machine.floppy.drive[0].insert "${$sys_701}"
    scheduler.run 300000000
    wait_stable(900000000)
    check("goldens/iici-7.0.1-640x480x1-finder.png")
    assert checkpoint.save("${$WORK_DIR}/suite-iici.gsc") "iici-checkpoint: save failed"
    machine.boot model="iici" ram=1024 video_card="builtin_rbv_video"
    assert checkpoint.load("${$WORK_DIR}/suite-iici.gsc") "iici-checkpoint: load failed"
    scheduler.run 5000000
    wait_stable(400000000)
    assert machine.ram == 8192 "iici-checkpoint: restored RAM size wrong"
    # Re-match the pre-save golden rather than comparing raw checksums:
    # the restored guest keeps running for a few million instructions
    # before it is quiescent again, so only a settled frame is comparable.
    check("goldens/iici-7.0.1-640x480x1-finder.png")
    report_perf("suite-iici/iici-checkpoint", scheduler.instr_count)
}

# ---- iici-mactest-diag ------------------------------------------------------
# MacTest 2.11 is Apple's own board-level diagnostic and the closest thing this
# suite has to an oracle that is not a screenshot of ourselves: it exercises the
# VIA, RBV, ASC, RTC/PRAM, FPU, SCC, SCSI and floppy controller and returns a
# verdict of its own.  Reaching the "insert a diskette" prompt means every stage
# before the floppy passed.
#
# This was a milestone guarding proposal-emulator-bug-fixes.md §9: clicking Start
# put up "SUSPECTED PROBLEM: Logic board" and stayed there.  It took two fixes,
# and both were real emulator defects rather than anything to do with MacTest:
#
#   1. The VIA phi2 clock was derived from a hardcoded divisor that suited the
#      16 MHz IIcx, so this machine's timers ran 1.6x fast and MacTest's T1
#      free-run interrupt count landed outside its 128..207 window (commit
#      fd1db42).
#   2. Undecoded reads inside the I/O island returned 0x00 instead of floating
#      high.  MacTest's sound test reads the VIA2 IFR at island $3A00 — which a
#      IIci does not have, so the read floats — and checks bit 4.
#
# ADB Communication is unchecked before Start so the result cannot be blamed on
# the emulated keyboard/mouse.  The two check()s before Start are drift guards on
# the Options choreography, so a mis-click fails with its own message rather than
# silently reporting a board fault.
def row_iici_mactest_diag() {
    machine.boot model="iici" ram=8192 video_card="builtin_rbv_video"
    machine.floppy.drive[0].insert "${$mactest_img}" true
    machine.scc.loopback = true
    machine.scsi.loopback = true
    scheduler.run 120000000
    # A condition, not a budget (§5.2). The golden this row inherited from the
    # abandoned re-host was captured at a fixed `scheduler.run 200000000`, which
    # lands on a mid-paint frame: MacTest keeps painting until ~250 M and then
    # holds. Waiting for the settled screen and matching that is both stabler and
    # a truer statement of the state — "MacTest is up and offering Start".
    wait_stable(900000000)
    assert machine.id == "iici" "iici-mactest-diag: machine.id != iici"
    assert machine.screen.width == 640 "iici-mactest-diag: primary width != 640"
    assert machine.screen.height == 480 "iici-mactest-diag: primary height != 480"
    check("goldens/iici-mactest-640x480x1-main.png")

    # Options ▸ Test Selections, uncheck Keyboard + Mouse, OK. Coordinates and
    # the prime-click are inherited from iicx-mactest-options, which
    # established them; see that directory for the derivation.
    machine.adb.mouse.move 115 10 "global"
    scheduler.run 4000000
    machine.adb.mouse.click true
    scheduler.run 20000000
    machine.adb.mouse.move 115 28 "global"
    scheduler.run 8000000
    machine.adb.mouse.click false
    scheduler.run 160000000
    # Prime click: the first click after the dialog opens is swallowed on focus
    # under E-clock-synced ADB, so a throwaway on empty dialog area absorbs it.
    click(400, 90)
    click(130, 305)
    click(130, 325)
    check("goldens/iici-mactest-640x480x1-adb-unchecked.png")
    # OK is DITL item 1; (560, 385) is inside its rect-derived global bounds —
    # the rendered glyph centre is 2 px above the real rect and hits a dummy
    # user-item instead.
    click(560, 385)
    scheduler.run 60000000

    # Start (button centre ~(188, 153)), then let the whole board-level sequence
    # run.  Reaching the floppy phase is the assertion: MacTest only asks for a
    # diskette after VIA, RBV, sound, clock/PRAM, FPU, SCC and SCSI have all
    # passed, so this one golden stands in for every one of them.  That is a far
    # stronger claim than the checksum inequality this row carried as a
    # milestone, which only said "not the logic-board dialog".
    click(188, 153)
    wait_match("goldens/iici-mactest-640x480x1-insert-800k.png", 1500000000, 20000000)
    report_perf("suite-iici/iici-mactest-diag", scheduler.instr_count)
}

# ---- row dispatch -----------------------------------------------------------

if row_on("iici-chime") { row_end("iici-chime", try(row_iici_chime(), "FAILED")) }
if row_on("iici-701-fd") { row_end("iici-701-fd", try(row_iici_701_fd(), "FAILED")) }
if row_on("iici-701-depths") { row_end("iici-701-depths", try(row_iici_701_depths(), "FAILED")) }
if row_on("iici-75-hd") {
    if have_media($hd_75) {
        row_end("iici-75-hd", try(row_iici_75_hd(), "FAILED"))
    } else {
        echo "skip: iici-75-hd (7.5 prepared image not fetched)"
    }
}
if row_on("iici-76-hd") {
    if have_media($hd_76) {
        row_end("iici-76-hd", try(row_iici_76_hd(), "FAILED"))
    } else {
        echo "skip: iici-76-hd (7.6 prepared image not fetched)"
    }
}
if row_on("iici-71-hd") {
    if have_media($hd_71_gc) {
        row_end("iici-71-hd", try(row_iici_71_hd(), "FAILED"))
    } else {
        echo "skip: iici-71-hd (7.1 prepared image not fetched)"
    }
}
if row_on("iici-lowram") { row_end("iici-lowram", try(row_iici_lowram(), "FAILED")) }
if row_on("iici-24ac-dual") { row_end_milestone("iici-24ac-dual", try(row_iici_24ac_dual(), "FAILED")) }
if row_on("iici-checkpoint") { row_end("iici-checkpoint", try(row_iici_checkpoint(), "FAILED")) }
if row_on("iici-mactest-diag") {
    if have_media($mactest_img) {
        row_end("iici-mactest-diag", try(row_iici_mactest_diag(), "FAILED"))
    } else {
        echo "skip: iici-mactest-diag (MacTest image not fetched)"
    }
}

suite_done()
quit
