# The Lisa's on-board ImageWriter: LOS 3.1 prints the Calculator tape.
# See config.mk for what this row covers.  Screen coordinates are the
# Office System's 720x364 desktop; mouse.move "global" steers the OS
# cursor there through the COPS warp (docs/machines/lisa/cops.md).

# Click at (x, y): place the cursor, press, release.
def lclick(x, y) {
    machine.adb.mouse.move($x, $y, "global")
    scheduler.run 3000000
    machine.adb.mouse.click true
    scheduler.run 800000
    machine.adb.mouse.click false
    scheduler.run 800000
}

# Pull down the menu at title x `mx` and release on the item at (ix, iy).
def menu_pick(mx, ix, iy) {
    machine.adb.mouse.move($mx, 8, "global")
    scheduler.run 3000000
    machine.adb.mouse.click true
    scheduler.run 3000000
    machine.adb.mouse.move($ix, $iy, "global")
    scheduler.run 3000000
    machine.adb.mouse.click false
}

machine.hd.attach "$WORK_DIR/profile.image"
assert machine.hd.present == true "ProFile should be attached"
# BootVol=2 (the ProFile) with a non-verifying checksum, as suite-lisa's
# lisa-los31-profile row seeds it: the OS restores its configuration from
# the boot volume, which puts the ImageWriter on Serial A
assert machine.hd.pram_init(2, false) "pram_init failed"

assert machine.printer.jobs == 0 "a job exists before any print"
assert machine.printer.bytes == 0 "the printer received bytes before any print"

# Boot to the Office System desktop
scheduler.run 112000000

# Disk icon -> File/Print "Open"
lclick(657, 340)
scheduler.run 5000000
menu_pick(100, 140, 83)
scheduler.run 60000000

# Calculator -> File/Print "Open"
lclick(309, 62)
scheduler.run 5000000
menu_pick(100, 140, 83)
scheduler.run 80000000

# Customize -> "Show Tape", then select the tape by dragging across it
menu_pick(310, 318, 83)
scheduler.run 30000000
machine.adb.mouse.move(198, 44, "global")
scheduler.run 3000000
machine.adb.mouse.click true
scheduler.run 1000000
machine.adb.mouse.move(340, 60, "global")
scheduler.run 4000000
machine.adb.mouse.click false
scheduler.run 5000000

# File/Print -> "Print Current Tape Selection"
menu_pick(100, 170, 113)

# The driver streams the page; the job ends after 5 s of guest time with
# no byte.  Give it up to ~20 x 20M instructions.
let tries = 0
while machine.printer.jobs == 0 && $tries < 20 {
    scheduler.run 20000000
    $tries = $tries + 1
}

let job = machine.printer.last_job()
echo "printer: jobs=${machine.printer.jobs} bytes=${machine.printer.bytes} last_len=${machine.printer.last_len} pending=${machine.printer.pending}"
assert machine.printer.jobs == 1 "the print did not reach the ImageWriter as one job"
assert machine.printer.pending == 0 "bytes arrived after the job ended"
assert machine.printer.last_len > 3000 "the job is too short to be a printed page"
# The Office System driver resets the printer (CAN), selects its setup
# (ESC E ...) and sends the page as bit-image bands (ESC F position,
# ESC g graphics)
assert contains($job, '\x18\x18\x18\x18') "the job has no CAN reset from the driver"
assert contains($job, '\x1BE') "no ESC E setup in the job"
assert contains($job, '\x1BF') "no ESC F head positioning in the job"
assert contains($job, '\x1Bg') "no ESC g graphics in the job"

# The machine is still alive after printing
assert machine.cpu.sr < 0x2700 "the CPU is stuck with interrupts masked"

echo "PASS: lisa-imagewriter"
quit
