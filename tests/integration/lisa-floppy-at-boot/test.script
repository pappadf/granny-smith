# Integration test: Apple Lisa 2 -- a diskette in the drive at power-on.
#
# The LOS 3.1 ProFile is the startup disk (BootVol = 2, as hd0= / the New
# Machine dialog set it); the Office System's second installation diskette is
# in the drive from the start.  The boot ROM boots the ProFile; the OS then
# meets the diskette's latched insert event before its Sony driver exists,
# masks floppy interrupts, and later (driver up) unmasks and mounts it.  The
# desktop with the diskette's icon must appear.  The runner cd's into this
# directory, so WORK_DIR is absolute and data paths are relative.

include "../lib/mac.script"

files.cp "../../data/Lisa/LisaOfficeSystem-3.1/LOS-3.1-ProFile.image" "${$WORK_DIR}/profile.image"
machine.hd.attach "${$WORK_DIR}/profile.image"
assert machine.hd.pram_init(2, false) "pram_init failed"
machine.floppy.drive.0.insert "../../data/Lisa/LisaOfficeSystem-3.1/LOS-3.1-2.image"
assert machine.floppy.drive.0.present "diskette not inserted"

scheduler.run 120000000
check("desktop.png")

# Checkpoint round trip with the diskette still in the drive (#325).  The
# restore must reattach the diskette, not re-insert it: an insertion latches a
# disk-in event and raises FDIR / level 1 that nothing acknowledges, and the
# OS hung on the hourglass.  Straight after the load no interrupt source may
# be pending: the saved machine had none.
assert machine.irq == 0 "an interrupt was pending at the save"
assert checkpoint.save("${$WORK_DIR}/floppy.gscp") "checkpoint save failed"
assert checkpoint.load("${$WORK_DIR}/floppy.gscp") "checkpoint load failed"
assert machine.irq == 0 "the restore raised an interrupt nothing will acknowledge"
assert machine.floppy.drive.0.present "the diskette did not come back with the checkpoint"

# The restored desktop still responds: pressing on the Housekeeping menu
# title pulls the menu down, with Eject Micro Diskette enabled.  (The restored
# CPU resumes in user mode; it must translate through its process context,
# not the supervisor one, or its first fetch bus-errors into a system error.)
scheduler.run 5000000
check("desktop.png")
machine.adb.mouse.move 250 6 "global"
scheduler.run 3000000
machine.adb.mouse.click true
scheduler.run 3000000
check("menu-restored.png")
machine.adb.mouse.click false
quit
