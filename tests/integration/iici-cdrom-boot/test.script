# IIci CD-ROM boot
#
# Boot a Macintosh IIci from a bootable Apple system CD and nothing else, all
# the way to the Finder desktop.
#
# Why this is worth a test at all: there is no CD-specific code in the Mac ROM.
# A bootable CD is mastered like a hard disk — Driver Descriptor Map in block 0,
# an Apple_Driver43 partition holding the CD driver, an Apple_HFS partition with
# a blessed System Folder — and the Start Manager boots it with the same code
# that boots a hard disk.  So this row exercises the ordinary SCSI boot path
# against a device that is READ-ONLY and reports 2048-byte blocks, which nothing
# else in the suites does.  se30-cdrom only proves a CD on the bus does not
# BREAK a floppy boot; nothing until now booted FROM one.
#
# The disc's partition map, read off the image directly:
#
#   block 0                    'ER'  Driver Descriptor Map, blockSize 2048
#   [1] "Macintosh"  Apple_Driver43       start     64  blocks    128
#   [2] "MacOS"      Apple_HFS            start    192  blocks 500000
#   [3] "Extra"      Apple_Free           start 500192  blocks 565043
#   [4] "Apple"      Apple_partition_map  start      1  blocks     63
#
# Two other discs were tried and are NOT usable, for reasons worth recording so
# nobody re-tests them:
#   * the Quadra 660AV/840AV "Install Me First" CD has an Apple Partition Map
#     but NO driver partition — it is a Toast-mastered data disc, not bootable;
#   * the 1994 Apple Restoration CD ships as a bare HFS volume (block 0 is an
#     'LK' HFS boot block, not a Driver Descriptor Map), so it has no partition
#     map for the Start Manager to read.  The emulator mounts it fine; a Mac
#     cannot boot a SCSI device that has no driver partition.

include "../lib/mac.script"

let cd = "../../data/cdroms/SSW-7.5.3-CD.toast"

if !have_media($cd) {
    echo "skip: iici-cdrom-boot (7.5.3 CD image not fetched)"
    quit
}

# ---- cd-device --------------------------------------------------------------
# The plug contract: what the guest sees on the bus before anything boots.
# 2048-byte blocks and read_only are the two properties that make this a
# different transport from every HD row in the suites.
def row_cd_device() {
    machine.boot model="iici" ram=8192
    machine.scsi.attach_cdrom "${$cd}" 3
    assert machine.scsi.device[3].type == "cdrom" "cd-device: SCSI 3 is not a CD-ROM"
    assert machine.scsi.device[3].block_size == 2048 "cd-device: block_size ${machine.scsi.device[3].block_size}, want 2048"
    assert machine.scsi.device[3].read_only "cd-device: CD-ROM is not read-only"
    assert machine.scsi.device[3].medium_present "cd-device: no medium present"
    assert machine.scsi.device[3].vendor == "SONY    " "cd-device: unexpected vendor"
    # No other storage: the boot below can only come from the disc.  An empty
    # SCSI slot does not resolve as an object at all, so probe it with try()
    # rather than reading a type (shell v2 §7 — errors are not truth values).
    assert try(machine.scsi.device[0].type, none) == none "cd-device: something is attached at SCSI 0"
    assert !machine.floppy.drive[0].present "cd-device: a floppy is inserted"
}

# ---- cd-boot ----------------------------------------------------------------
# The actual claim: with ONLY the CD attached, the machine runs a System.
#
# Every assertion here is a fact that can only be true if the disc's driver
# partition was loaded and its HFS volume mounted and blessed — there is no
# other source of a System on this machine.
def row_cd_boot() {
    machine.rtc.time = 3000000000
    machine.boot model="iici" ram=8192
    machine.scsi.attach_cdrom "${$cd}" 3
    scheduler.run 400000000
    scheduler.run 1000000000

    assert machine.id == "iici" "cd-boot: machine.id != iici"
    # BootDrive is the drive number the Start Manager booted from; zero means
    # it never found a bootable device.
    assert debug.mac.globals.read("BootDrive") != 0 "cd-boot: BootDrive is 0 — nothing booted"
    # A running System: the Memory Manager zones are live and the tick
    # interrupt has been counting for a couple of emulated minutes.
    assert debug.mac.globals.read("SysZone") != 0 "cd-boot: SysZone unset — no System heap"
    assert debug.mac.globals.read("BufPtr") != 0 "cd-boot: BufPtr unset — Memory Manager not up"
    assert debug.mac.globals.read("Ticks") > 10000 "cd-boot: only ${debug.mac.globals.read("Ticks")} ticks — System not running"
    # SysMap is the System file's resource map reference — nonzero only once a
    # System FILE has been opened, which is the part that proves the read came
    # off the disc rather than out of the ROM.
    assert debug.mac.globals.read("SysMap") != 0 "cd-boot: SysMap unset — no System file opened"

    report_perf("iici-cdrom-boot/cd-boot", scheduler.instr_count)
}

# ---- cd-desktop -------------------------------------------------------------
# The destination: System 7.5.3's Finder desktop, with the disc's own volume
# window open, running entirely off the CD.
#
# This row was a milestone that could not be reached, and the reason is worth
# keeping because the symptom pointed somewhere else entirely.  The boot used
# to stop on "Not enough memory is available while using “System”", which is
# not a memory problem at all: it is System 7.5.3 reporting a REFUSED SCSI
# READ.  READ(6) carries an 8-bit transfer length (0 meaning 256 blocks), and
# the emulator rejected any request whose byte count exceeded BUF_LIMIT
# (256 * 512).  On a hard disk that ceiling is unreachable — 256 blocks of 512
# bytes is exactly BUF_LIMIT — but a CD-ROM's blocks are 2048 bytes, so any
# READ(6) of more than 64 blocks was answered with CHECK CONDITION.  The boot
# died on `lba=2531 tl=124`, a 248 KB read.  READ(10) had already been taught
# to grow its staging buffer for the System 7.1 installer; READ(6) had not,
# and its comment asserted the product "stays inside BUF_LIMIT in practice",
# which is only true for 512-byte blocks.
#
# The tell was the transfer volume: an entire System startup moved only
# 0.73 MB off the disc across 104 reads before stopping.  That is far too
# little to have loaded a System, and it is what redirected the investigation
# from the Memory Manager to the bus.  Worth remembering that a guest's own
# error dialog names the symptom it noticed, not the cause.
#
# Runs at 8 MB in 24-bit addressing with no PRAM seeding — exactly the
# configuration that used to fail.
def row_cd_desktop() {
    machine.rtc.time = 3000000000
    machine.boot model="iici" ram=8192
    machine.scsi.attach_cdrom "${$cd}" 3
    scheduler.run 400000000
    wait_stable(1600000000)
    # The application zone exists only once the Process Manager has launched
    # the Finder; while the boot was failing this stayed equal to SysZone.
    assert debug.mac.globals.read("ApplZone") != debug.mac.globals.read("SysZone") "cd-desktop: ApplZone == SysZone — the Finder never launched"
    check("goldens/iici-7.5.3-640x480x1-cd-finder.png")
    report_row("7.5.3", "rbv", "cd-boot finder-desktop")
    report_perf("iici-cdrom-boot/cd-desktop", scheduler.instr_count)
}

# ---- row dispatch -----------------------------------------------------------

if row_on("cd-device") { row_end("cd-device", try(row_cd_device(), "FAILED")) }
if row_on("cd-boot") { row_end("cd-boot", try(row_cd_boot(), "FAILED")) }
if row_on("cd-desktop") { row_end("cd-desktop", try(row_cd_desktop(), "FAILED")) }

suite_done()
quit
