# Integration test: Apple Lisa 2 — machine.floppy.drive.0.save.
#
# The Lisa's Sony disk keeps writes in a delta and its 12-byte sector tags in
# memory, so neither the source file nor files.export_raw reflects what the OS
# wrote.  save writes both to a DiskCopy 4.2 file: a 400K Lisa diskette is
# 84 header bytes + 800 x 512 data bytes + 800 x 12 tag bytes = 419284 bytes.
# The runner cd's into this directory, so WORK_DIR is absolute.

scheduler.run 10000000
machine.floppy.drive.0.insert "../../data/Lisa/Xenix-3.0/Xenix-3.0-1.dc42"
assert machine.floppy.drive.0.present "diskette not inserted"
assert machine.floppy.drive.0.save("${$WORK_DIR}/saved.dc42") "save returned false"
assert files.path_size("${$WORK_DIR}/saved.dc42") == 419284 "saved image has the wrong size"

# Round trip: the saved image mounts again and saves to the same size.
machine.floppy.drive.0.eject
machine.floppy.drive.0.insert "${$WORK_DIR}/saved.dc42"
assert machine.floppy.drive.0.present "saved image did not mount"
assert machine.floppy.drive.0.save("${$WORK_DIR}/saved2.dc42") "second save returned false"
assert files.path_size("${$WORK_DIR}/saved2.dc42") == 419284 "re-saved image has the wrong size"
quit
