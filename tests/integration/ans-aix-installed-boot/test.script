# Cold boot of an installed AIX 4.1.5 (proposal-apple-network-server-500-700
# §6, rung S13).  See config.mk for what the media is and why it is gated.
#
# RUNG S13.  A Network Server with AIX on the disk in bay 2 and the key in
# Normal boots it with no help: POST, Open Firmware's default boot device
# `disk2:aix`, the kernel, cfgmgr over both fast/wide channels (LCD 890 /
# 868), "Multi-user initialization completed" and `Console login:` on the
# system console — which this installation set to serial port B during
# its own install, so the whole narration is readable on `machine.scc.b`.
#
# Two prompts sit between multi-user and the login on a freshly installed
# system, and the row answers them the way a person at the terminal would:
# the terminal-type question (`vt100`) and the Installation Assistant
# (Esc+0, "Exit").  Both are AIX's first-boot behaviour, not the
# emulator's.
#
# BUDGET.  A Normal-key cold boot is slow by the machine's design — POST
# runs its full memory test, and cfgmgr pays one selection time-out plus a
# bus reset for every absent id on two wide buses (finding 48).  Sampled
# in 500 M-cycle strides; ~260 strides to the login prompt on the
# reference host.

include "../lib/mac.script"
include "../lib/ans.script"

let ans_root = "../../../local/gs-docs/projects/ans-500-700"
let aix_disk = "${$ans_root}/images/aix415-lp240s-installed.img"

def installed_boot() {
    machine.board.clear_nvram()
    machine.boot model="ans500" ram=524288 rom="${$ROM}"
    machine.board.keyswitch = "normal"
    assert machine.board.keyswitch == "normal" "the front keyswitch did not take the Normal position"

    # Bay 2 — Open Firmware's `disk2` alias, its default boot device.  The
    # golden image is never written: changes go to a scratch delta.
    machine.scsi.attach_hd("${$aix_disk}", 2)
    assert machine.scsi.device[2].type == "hd" "the installed AIX disk is not in bay 2"
    assert contains(machine.scsi.device[2].product, "LP240S") "the installed disk is not the LP240S the image was made on"

    let saw_scsi2 = 0
    let saw_integrated = 0
    let saw_multiuser = 0
    let saw_login = 0
    let answered_term = 0
    let exited_assistant = 0
    let console = ""
    for i in 0..400 {
        scheduler.run 500000000
        if contains(machine.lcd.text, "890") {
            $saw_scsi2 = 1
        }
        if contains(machine.lcd.text, "868") {
            $saw_integrated = 1
        }
        $console = "${$console}${machine.scc.b.sent()}"
        if contains($console, "Multi-user initialization completed") {
            $saw_multiuser = 1
        }
        if $answered_term == 0 && contains($console, ">>> Choice []:") {
            machine.scc.b.receive("vt100\r")
            $answered_term = 1
        }
        if $exited_assistant == 0 && contains($console, "Installation Assistant") {
            machine.scc.b.receive("\x1b0")
            $exited_assistant = 1
        }
        if contains($console, "Console login:") {
            $saw_login = 1
            break
        }
    }

    # --- S13: the installed system came up ---------------------------------
    assert $saw_scsi2 == 1 "S13: the LCD never showed 890 (cfgmgr configuring the SCSI-2 adapter)"
    assert $saw_integrated == 1 "S13: the LCD never showed 868 (the integrated SCSI adapter)"
    assert $saw_multiuser == 1 "S13: the console never reported 'Multi-user initialization completed'"
    assert $saw_login == 1 "S13: the console never reached 'Console login:'"
    # A clean shutdown left clean filesystems: the boot-time check is
    # suppressed rather than run, and no JFS log replay is reported.
    assert contains($console, "Unmounted cleanly") "S13: the boot-time filesystem check did not report a clean unmount"
    assert !contains($console, "Halt completed") "S13: the system halted instead of coming up"

    # And the disk is still the one it booted from.
    assert machine.scsi.device[2].type == "hd" "S13: the boot disk went away under AIX"

    echo "ans-aix-installed-boot: an installed AIX 4.1.5 cold-boots through Open Firmware's disk2:aix to 'Console login:' (rung S13)"
}

if have_media($aix_disk) {
    installed_boot()
} else {
    echo "skip: ans-aix-installed-boot (the installed AIX 4.1.5 disk image is not present — see gs-docs projects/ans-500-700, handover 114)"
}

quit
