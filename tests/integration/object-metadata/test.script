# The object-model metadata: see config.mk.  run.sh runs this and compares
# the usage blocks it prints with the golden files in this directory.

# === meta.members: keys by member kind (docs compared by presence) ========
def member_of(ms, name) {
    for m in $ms {
        if $m.name == $name { return $m }
    }
    return none
}

# Attribute: a type descriptor.
let d0 = member_of(machine.cpu.meta.members(), "d0")
assert $d0.kind == "attr" "d0 is an attribute"
assert $d0.task == "debug" "d0 inherits the cpu class task"
assert $d0.type.kind == "uint" "d0 type kind"
assert $d0.type.presentation == "hex" "d0 presentation"
assert $d0.type.width == 0 "d0 width"
assert $d0.type.enum == none "d0 has no enum table"
assert len($d0.doc) > 0 "d0 has a doc"

# Method: args with their own type descriptors, and the result.
let add = member_of(debug.breakpoints.meta.members(), "add")
assert $add.kind == "method" "add is a method"
assert $add.task == "debug" "add inherits debug"
assert len($add.args) == 3 "add has three arguments"
assert $add.args[0].name == "addr" "first argument"
assert $add.args[0].type.kind == "uint" "addr is a uint"
assert $add.args[0].optional == false "addr is required"
assert $add.args[2].type.kind == "enum" "space is an enum"
assert $add.args[2].type.enum[1] == "physical" "space's values"
assert $add.args[2].optional == true "space is optional"
assert $add.result.kind == "object" "add returns an object"

# Named child with a node doc; a collection container with live entries.
let fl = member_of(machine.meta.members(), "floppy")
assert $fl.kind == "child" "floppy is a child"
assert len($fl.doc) > 0 "floppy has a node doc"
assert $fl.task == "storage" "floppy is a storage node"
assert $fl.collection == false "floppy is not a collection"
let dr = member_of(machine.floppy.meta.members(), "drive")
assert $dr.collection == true "drive is a collection container"
assert len($dr.indices) == 2 "two drives"
assert $dr.keys == none "drive is not keyed"
let cat = member_of(log.meta.members(), "category")
assert $cat.collection == true "log.category is a collection container"
assert $cat.indices == none "log.category is not indexed"
assert len($cat.keys) > 10 "log.category lists its keys"

# Root children carry their domain.
let mach = member_of(meta.members(), "machine")
assert $mach.domain == "machine" "machine domain"
let at = member_of(meta.members(), "appletalk")
assert $at.domain == "network" "appletalk domain"
assert $at.task == "network" "appletalk task"
let sch = member_of(meta.members(), "scheduler")
assert $sch.domain == "emulator" "scheduler domain"
assert $sch.task == "run" "scheduler task"
let _m1 = member_of(meta.members(), "help")
assert $_m1.task == "shell" "root methods carry their task"

# Effective task: a method's own task overrides its node's; entries walk to
# their container; lookup-backed children to their entry.
let _m2 = member_of(machine.meta.members(), "boot")
assert $_m2.task == "run" "method task override"
let _m3 = member_of(machine.meta.members(), "attach_hd")
assert $_m3.task == "storage" "method task override"
machine.scsi.attach_hd ../../data/systems/System_6_0_8.dsk 3
let _m4 = member_of(machine.scsi.device[3].meta.members(), "eject")
assert $_m4.task == "storage" "entry inherits from its container"
let _m5 = member_of(machine.scsi.device[3].image.meta.members(), "export")
assert $_m5.task == "storage" "lookup child inherits"
assert machine.scsi.device[3].image.meta.path == "machine.scsi.device[3].image" "lookup child path"

# Tiers: statistics and plumbing.
let _m6 = member_of(scheduler.meta.members(), "cycles")
assert $_m6.category == "advanced" "scheduler.cycles is advanced"
let _m7 = member_of(machine.cpu.meta.members(), "vbr")
assert $_m7.category == "advanced" "cpu.vbr is advanced"
let _m8 = member_of(shell.meta.members(), "complete")
assert $_m8.hidden == true "shell.complete is hidden"
let _m9 = member_of(shell.meta.members(), "tasks")
assert $_m9.category == "internal" "shell.tasks is internal"

# === shell.tasks / shell.keywords ==========================================
assert len(shell.tasks) == 7 "seven tasks"
assert shell.tasks[0].id == "run" "chip order starts with run"
assert shell.tasks[4].label == "Logs" "log's chip label"
assert len(shell.keywords) >= 17 "every reserved word"
for k in shell.keywords {
    assert len($k.syntax) > 0 "keyword ${$k.word} has a syntax"
}

# === shell.needs_continuation ==============================================
assert shell.needs_continuation("if 1 {") "an open block continues"
assert !shell.needs_continuation("echo 1") "a statement does not"

# === shell.complete detail and context =====================================
let c = shell.complete("machine.floppy.drive[0].ins", 27, true)
assert $c.candidates[0].text == "machine.floppy.drive[0].insert" "candidate text"
assert $c.candidates[0].kind == "method" "candidate kind"
assert $c.candidates[0].task == "storage" "candidate task"
assert len($c.candidates[0].doc) > 0 "candidate doc"
assert $c.context.method == none "not in an argument position"
let p = shell.complete("machine.floppy.drive[0].insert foo", 34, true)
assert $p.context.method == "machine.floppy.drive[0].insert" "context method"
assert $p.context.arg_index == 0 "positional slot"
assert $p.context.arg_name == "path" "positional name"
let n = shell.complete("debug.breakpoints.add 0x10 space=p", 34, true)
assert $n.context.arg_index == 2 "a name= argument names its declared slot"
assert $n.context.arg_name == "space" "name= slot name"
let q = shell.complete("debug.breakpoints.add 0x10 space=physical 1", 43, true)
assert $q.context.arg_index == 1 "name= words do not count as positionals"
assert shell.complete("fi", 2).candidates == "[files.]" "without detail the result is unchanged"

# === shell.highlight on the live tree ======================================
# `flopy` does not resolve: it and everything after it are unknown.
let h = shell.highlight("machine.flopy.drive")
assert len($h) == 3 "three segment spans"
assert $h[0].class == "object" "machine resolves"
assert $h[1].class == "unknown" "flopy is unknown"
assert $h[1].start == 8 "flopy starts at byte 8"
assert $h[2].class == "unknown" "drive after it is unknown too"
let h2 = shell.highlight("machine.floppy.drive[0].insert /tmp/x.img writable=true")
assert $h2[6].class == "method" "insert resolves to a method"
assert $h2[7].class == "attribute" "a name= argument"
let h3 = shell.highlight("scheduler.mode = turbo")
assert $h3[len($h3) - 1].class == "enum" "an enum attribute's value"

# === shell.usage: signature spans, and the golden texts =====================
let u = shell.usage("debug.breakpoints.add")
assert $u.signature == "debug.breakpoints.add <addr> [condition] [space: logical | physical]" "signature"
assert $u.arg_spans[0][0] == 22 "first span start"
assert $u.arg_spans[0][1] == 28 "first span end"
for path in ["debug.breakpoints.add", "machine.floppy.drive[0].insert", "scheduler.mode", "machine.cpu.d0", "machine.floppy"] {
    echo "=== USAGE $path"
    echo "${shell.usage($path).text}"
}
echo "=== END"
assert help("debug.breakpoints.add") == shell.usage("debug.breakpoints.add").text "help prints the usage text"

echo "object-metadata-ok"
quit
