# An ISO 9660 disc (built at setup: a primary tree and a Joliet tree) is a
# bare volume: one synthetic partition holding the disc's files.
let iso = "${$WORK_DIR}/disc.iso"
assert files.probe($iso) "the disc is recognised as a disk"
let names = ""
for e in files.list("${$iso}/partition1") {
    $names = "${$names}|${$e.name}"
}
assert $names == "|Disk Images|Read Me.txt" "Joliet names, not 8.3 ones (got ${$names})"

# A file on the disc reads back byte for byte.
let readme = "${$iso}/partition1/Read Me.txt"
assert files.path_size($readme) == files.path_size("config.mk") "file size"
assert files.path_compare($readme, "config.mk") == -1 "file contents"
assert files.path_size("${$iso}/partition1/read me.txt") > 0 "names are matched without case"

# A floppy image on the disc is a disk in turn: descend into its HFS volume.
let fd = "${$iso}/partition1/Disk Images/System 6.0.8.dsk"
assert files.path_size($fd) == 819200 "the floppy image on the disc"
assert files.list("${$fd}/partition1/System Folder") "the HFS volume inside the floppy image on the disc"
assert files.path_size("${$fd}/partition1/System Folder/System/rsrc/_raw") > 0 "a resource fork two levels down"

# A hybrid disc: the partition map's HFS volume and, beside it, the ISO side.
let hy = "${$WORK_DIR}/hybrid.iso"
let roots = ""
for e in files.list($hy) {
    $roots = "${$roots}|${$e.name}"
}
assert $roots == "|partition1|partition2|iso9660" "the map's partitions, then the ISO side (got ${$roots})"
assert files.path_compare("${$hy}/partition2/Hello.txt", "config.mk") == -1 "the HFS side reads"
assert files.path_compare("${$hy}/ISO9660/Read Me.txt", "config.mk") == -1 "the ISO side reads (name matched without case)"
assert !files.path_exists("${$iso}/iso9660") "a disc that is only ISO has no iso9660 entry"
assert !files.path_exists("${$hy}/partition3") "the ISO side is not a partitionN"

# Apple's "AA" entry is the file's Finder info, and a copy out keeps it.
assert files.path_compare("${$hy}/iso9660/Read Me.txt/finf", "${$WORK_DIR}/readme.finf") == -1 "Finder info from AA"
assert !files.path_exists("${$iso}/partition1/Read Me.txt/finf") "no AA, no Finder info"
assert files.cp("${$hy}/iso9660/Read Me.txt", "${$WORK_DIR}/Read Me.txt") "copy the file out"
assert files.path_size("${$WORK_DIR}/._Read Me.txt") > 0 "its AppleDouble sidecar carries the Finder info"

quit
