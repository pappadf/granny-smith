# rom.identify and catalog.profile probe surface.
#
# Headless boots Plus from plus-v3-4d1f8172.rom (config.mk's TEST_ROM); we then
# probe the same file plus the SE/30 ROM by relative path to exercise the
# new map shape, and call catalog.profile() for both registered models to
# pin the static configuration shape.  The cross-check here is what keeps
# the ROM table and the model profiles from drifting apart.

# rom.identify on the loaded Plus ROM.  Output is a JSON-encoded V_STRING.
echo "${machine.rom.identify("../../data/roms/plus-v3-4d1f8172.rom")}"

# Universal ROM: must list se30 / iicx / iix as compatible.  Headless ran
# its boot pass against Plus, so this is just a path probe — no machine
# state is touched.
echo "${machine.rom.identify("../../data/roms/iix-iicx-se30-97221136.rom")}"

# The map's content fields: kind, the ROM's own stored checksum as its id,
# and the self-check verdict.  A known ROM of an emulated model is supported.
assert machine.rom.identify("../../data/roms/plus-v3-4d1f8172.rom").kind == "mac68k" "Plus is a 68k ROM"
assert machine.rom.identify("../../data/roms/plus-v3-4d1f8172.rom").id == "4d1f8172" "Plus id is its header sum"
assert machine.rom.identify("../../data/roms/plus-v3-4d1f8172.rom").intact "Plus ROM self-check"
assert machine.rom.identify("../../data/roms/plus-v3-4d1f8172.rom").supported "Plus ROM is supported"
assert machine.rom.identify("../../data/roms/plus-v3-4d1f8172.rom").reason == "" "an intact ROM has no reason"

# An Old World PowerPC ROM carries two of Apple's checksums, and its id is
# both: the 32-bit header sum, which covers only the 68k half (the first
# 3 MB), and the ConfigInfo's 64-bit ROMCheckSum64 over the whole 4 MB.
# intact means both verify.  No whole-region sum of our own exists (#186):
# on this ROM it would read B2138FBB, which is neither of Apple's.
let pm7500 = machine.rom.identify("../../data/roms/pm7500-pm8500-pm9500-96cd923d.rom")
assert $pm7500.kind == "ppc" "pm7500 ROM is a PowerPC ROM"
assert $pm7500.id == "96cd923d-c241cd82bf90797a" "pm7500 id is <68k-half header sum>-<ROMCheckSum64>"
assert $pm7500.intact "pm7500 ROM: both of Apple's sums verify"
assert $pm7500.reason == "" "an intact PowerPC ROM has no reason"

# Unrecognised file: probing /dev/null/nonexistent must yield V_ERROR.
# The shell's truthiness rule treats errors as falsy.
assert !machine.rom.identify("/dev/null/nonexistent") "expected V_ERROR for unreadable path"

# Per-instance attributes describe the *loaded* ROM (Plus_v3 in this run).
assert machine.rom.loaded == true "Plus ROM must be loaded"
assert machine.rom.id == "4d1f8172" "Plus_v3 id is 4d1f8172"
assert machine.rom.intact "loaded Plus ROM self-check"
assert machine.rom.name == "Macintosh Plus (Rev 3, Loud Harmonicas)" "Plus_v3 family name"
assert machine.rom.size == 131072 "Plus ROM is 128 KiB"

# Static profile lookup.  Both registered models must resolve.  IIcx is
# intentionally unregistered (no partial profiles).
echo "${catalog.profile("plus")}"
echo "${catalog.profile("se30")}"

# Empty / unknown id → V_ERROR.
assert !catalog.profile("") "catalog.profile(\"\") must error"
assert !catalog.profile("nonesuch") "catalog.profile(\"nonesuch\") must error"

# Per-instance attributes (post-boot, Plus is the active machine).
assert machine.created == true "machine.created should be true"
assert machine.id == "plus" "machine.id"
assert machine.name == "Macintosh Plus" "machine.name"
assert machine.freq == 7833600 "machine.freq"
assert machine.ram == 4096 "machine.ram (default 4 MB)"

# machine.boot's ram-options validation.  4 MB is in Plus's ram_options;
# 99999 KB is not.  The 2.5 MB stepping is accepted (Plus supports it).
# (The document is complete — rom= travels explicitly, positionally here.)
assert !machine.boot("plus", 99999, "${$ROM}") "ram=99999 must fail Plus ram_options check"
assert machine.boot("plus", 2560, "${$ROM}") "ram=2560 (2.5 MB) must succeed for Plus"
assert machine.ram == 2560 "machine.ram reflects 2.5 MB after re-boot"

# Re-boot back to a default-ish 4 MB so the rest of the harness sees
# something it can boot — the cleanup quit() below is what matters.
assert machine.boot("plus", 4096, "${$ROM}") "ram=4096 must succeed for Plus"

# Switch to SE/30 with its default 8 MB to confirm the cross-model attr
# update.  The model switch needs its own compatible ROM in the document.
assert machine.boot("se30", 8192, "../../data/roms/iix-iicx-se30-97221136.rom") "machine.boot(se30, 8192)"
assert machine.id == "se30" "machine.id after se30 boot"
assert machine.ram == 8192 "machine.ram after se30 boot"
assert machine.freq == 15667200 "machine.freq after se30 boot"

quit
