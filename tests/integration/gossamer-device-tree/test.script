assert contains($p, "name                    cpus") "G6: /cpus@0: name cpus"
assert contains($p, "device_type             cpus") "G6: /cpus@0: device_type cpus"
assert contains($p, "#address-cells          00000001") "G6: /cpus@0: #address-cells 00000001"
assert contains($p, "#size-cells             00000000") "G6: /cpus@0: #size-cells 00000000"

