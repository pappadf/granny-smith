# The beige Power Macintosh G3's Open Firmware device tree (rung G6).
#
# The reference is a full `dump-device-tree` from a real Rev C beige G3
# (Open Firmware 2.4) posted to a public forum.  Open Firmware builds the
# tree by probing the hardware — Grackle's configuration space, Heathrow's
# BAR and cells, the Cuda I2C bus (SPD EEPROMs, the personality card's ID
# EEPROM) — so every property that matches is a register or a bus answer
# the model got right.  The assertions were generated property by
# property from the nodes the two machines share, keeping each property
# whose value matches; what is left out, and why:
#
#   * /cpus/PowerPC,*: the reference machine carries a 400 MHz G4 ZIF
#     upgrade (cpu-version 000C0206); ours is the stock 750.  Its node is
#     asserted separately below against the profile's own clocks.
#   * /memory reg/available: the reference has 768 MB; ours is 64 MB.
#   * /chosen, /options: firmware instance handles and that machine's own
#     NVRAM settings (it ran with nvramrc, a boot-device and a
#     pci-probe-list).
#   * bmac local-mac-address / cell-id: the Ethernet cell is not modelled
#     yet; the address is per-machine in any case.
#   * the PCI slot cards (a USB card and an nVidia card) and the /packages
#     firmware packages, which no hardware feeds.
#
# The reference prints hex in lower case and our console in upper case;
# the assertions use what this firmware prints.  Everything runs over the
# SCC channel A console; the row stops the boot by holding
# Command-Option-O-F from power-on (see lib/gossamer.script).

include "../lib/mac.script"
include "../lib/gossamer.script"

let banner = gos_boot_prompt("pmg3dt", 65536)
# The Open Firmware console on the Rage Pro's screen: the banner, the
# prompt, and the `ttya io` the row typed — drawn by the ATI FCode 1.53 in
# the Mac ROM through the chip's little-endian aperture at 640 x 480 x 8.
check("of-console.png")

let cd = ""
let p = ""

# mac-io's children are addressed by unit (mesh@10000, ide@20000/@21000),
# and the stock firmware cannot resolve one: Heathrow's node has no
# decode-unit method, so `dev /pci/mac-io/mesh@10000` answers "can't find
# device".  The reference machine could, because it ran with the Mac OS X
# installer's nvramrc, whose script does exactly this — `dev mac-io` and
# `: decode-unit parse-1hex ;` — which is also why its mac-io METHODS list
# begins with decode-unit.  The row defines the same one-liner so the two
# machines' paths mean the same thing.
gos_send("dev /pc")
gos_send("i/mac-i")
gos_send("o")
$cd = gos_go()
gos_send(": decod")
gos_send("e-unit ")
gos_send("parse-1")
gos_send("hex ;")
$cd = gos_go()
assert !contains($cd, "unknown") "the mac-io decode-unit definition was refused"

# --- The CPU node: the profile's 750 at 267 MHz on the 66.82 MHz bus -------
gos_send("dev /cp")
gos_send("us/Powe")
gos_send("rPC,750")
$cd = gos_go()
gos_send(".proper")
gos_send("ties")
$p = gos_go()
assert contains($p, "name                    PowerPC,750") "G6: cpu node is not PowerPC,750"
assert contains($p, "cpu-version             00080202") "G6: cpu-version != the 750's PVR 00080202"
# The ROM decodes HID1's PLL field against its bus-code table: code 10
# (4x) on bus code 6 is 267.28 MHz.
assert contains($p, "clock-frequency         0FEE5E80") "G6: cpu clock-frequency != 267,280,000"
assert contains($p, "bus-frequency           03FB97A0") "G6: bus-frequency != 66,820,000"
assert contains($p, "timebase-frequency      00FEE5E8") "G6: timebase-frequency != bus/4 (16,705,000)"


# /
gos_send("dev /")
$cd = gos_go()
gos_send(".proper")
gos_send("ties")
$p = gos_go()
assert contains($p, "name                    device-tree") "G6: /: name device-tree"
assert contains($p, "copyright               28632920 4170706C 6520436F 6D707574 65722C20 496E632E 20313939 3800") "G6: /: copyright 28632920 4170706C 6520436F 6D707574 65722C20 496E6"
assert contains($p, "system-id               30303030 30303030 30303030 3000") "G6: /: system-id 30303030 30303030 30303030 3000"
assert contains($p, "#address-cells          00000001") "G6: /: #address-cells 00000001"
assert contains($p, "#size-cells             00000001") "G6: /: #size-cells 00000001"
assert contains($p, "clock-frequency         03FB97A0") "G6: /: clock-frequency 03FB97A0"
assert contains($p, "AAPL,cpu-id             00000000") "G6: /: AAPL,cpu-id 00000000"
assert contains($p, "model                   Power Macintosh") "G6: /: model Power Macintosh"
assert contains($p, "compatible              AAPL,PowerMac G3") "G6: /: compatible AAPL,PowerMac G3"
assert contains($p, "MacRISC") "G6: /: MacRISC"

