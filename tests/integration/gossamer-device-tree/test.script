assert contains($p, "#size-cells             00000002") "G6: /pci@80000000: #size-cells 00000002"
assert contains($p, "#interrupt-cells        00000001") "G6: /pci@80000000: #interrupt-cells 00000001"
assert contains($p, "clock-frequency         01FCA055") "G6: /pci@80000000: clock-frequency 01FCA055"
assert contains($p, "slot-names              0000E000 41310042 31004331 00") "G6: /pci@80000000: slot-names 0000E000 41310042 31004331 00"
assert contains($p, "ranges                  01000000 00000000 00000000  FE000000  00000000 00800000") "G6: /pci@80000000: ranges 01000000 00000000 00000000 FE000000 00000000 00800000"
assert contains($p, "02000000 00000000 00000000  FD000000  00000000 01000000") "G6: /pci@80000000: 02000000 00000000 00000000 FD000000 00000000 01000000"
assert contains($p, "02000000 00000000 80000000  80000000  00000000 7D000000") "G6: /pci@80000000: 02000000 00000000 80000000 80000000 00000000 7D000000"
