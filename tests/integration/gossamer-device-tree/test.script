gos_send("dev /me")
gos_send("mory")
$cd = gos_go()
gos_send(".proper")
gos_send("ties")
$p = gos_go()
assert contains($p, "name                    memory") "G6: /memory@0: name memory"
assert contains($p, "device_type             memory") "G6: /memory@0: device_type memory"

# /openprom@0
gos_send("dev /op")
gos_send("enprom")
$cd = gos_go()
gos_send(".proper")
gos_send("ties")
$p = gos_go()
assert contains($p, "name                    openprom") "G6: /openprom@0: name openprom"
assert contains($p, "model                   Open Firmware, 2.4") "G6: /openprom@0: model Open Firmware, 2.4"
assert contains($p, "relative-addressing") "G6: /openprom@0: relative-addressing"

# /AAPL,ROM@FFC00000
gos_send("dev /AA")
gos_send("PL,ROM")
$cd = gos_go()
gos_send(".proper")
gos_send("ties")
$p = gos_go()
assert contains($p, "name                    AAPL,ROM") "G6: /AAPL,ROM@FFC00000: name AAPL,ROM"
assert contains($p, "device_type             rom") "G6: /AAPL,ROM@FFC00000: device_type rom"
assert contains($p, "compatible              AAPL,ROM") "G6: /AAPL,ROM@FFC00000: compatible AAPL,ROM"
assert contains($p, "reg                     FFC00000  00400000") "G6: /AAPL,ROM@FFC00000: reg FFC00000 00400000"

# /aliases@0
gos_send("dev /al")
gos_send("iases")
$cd = gos_go()
gos_send(".proper")
gos_send("ties")
$p = gos_go()
assert contains($p, "name                    aliases") "G6: /aliases@0: name aliases"
assert contains($p, "pci                     /pci@80000000") "G6: /aliases@0: pci /pci@80000000"
assert contains($p, "mac-io                  /pci/mac-io") "G6: /aliases@0: mac-io /pci/mac-io"
assert contains($p, "kbd                     /pci/mac-io/via-cuda/adb/keyboard") "G6: /aliases@0: kbd /pci/mac-io/via-cuda/adb/keyboard"
assert contains($p, "mouse                   /pci/mac-io/via-cuda/adb/mouse") "G6: /aliases@0: mouse /pci/mac-io/via-cuda/adb/mouse"
assert contains($p, "ttya                    /pci/mac-io/escc/ch-a") "G6: /aliases@0: ttya /pci/mac-io/escc/ch-a"
assert contains($p, "ttyb                    /pci/mac-io/escc/ch-b") "G6: /aliases@0: ttyb /pci/mac-io/escc/ch-b"
assert contains($p, "scsi                    /pci/mac-io/mesh") "G6: /aliases@0: scsi /pci/mac-io/mesh"
assert contains($p, "scsi-int                /pci/mac-io/mesh") "G6: /aliases@0: scsi-int /pci/mac-io/mesh"
assert contains($p, "ide0                    /pci/mac-io/ide@20000") "G6: /aliases@0: ide0 /pci/mac-io/ide@20000"
assert contains($p, "ide                     /pci/mac-io/ide@20000") "G6: /aliases@0: ide /pci/mac-io/ide@20000"
assert contains($p, "ata-int                 /pci/mac-io/ide@20000") "G6: /aliases@0: ata-int /pci/mac-io/ide@20000"
assert contains($p, "ide1                    /pci/mac-io/ide@21000") "G6: /aliases@0: ide1 /pci/mac-io/ide@21000"
assert contains($p, "enet                    /pci/mac-io/bmac") "G6: /aliases@0: enet /pci/mac-io/bmac"
assert contains($p, "swim                    /pci/mac-io/swim3") "G6: /aliases@0: swim /pci/mac-io/swim3"
assert contains($p, "fd                      /pci/mac-io/swim3") "G6: /aliases@0: fd /pci/mac-io/swim3"

