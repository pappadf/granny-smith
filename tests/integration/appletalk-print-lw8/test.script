# LaserWriter 8 print over AppleTalk from System 7.5, timed.  See config.mk
# for the defect this row guards against.
#
# Boot System 7.5 on a IIci, enable the emulated LaserWriter, and drive the
# Chooser and the Finder's "Print Window..." with injected mouse input, then
# measure the guest time from the Print button to the finished PDF.
#
# Pointer moves use the "global" form: the IIci has an ADB mouse, whose
# relative deltas are accelerated, so only absolute moves land where the
# coordinates say.

include "../lib/mac.script"

machine.boot model="iici" ram=16384 video_card="builtin_rbv_video" rom="${$ROM}"
machine.scsi.attach_hd "../../data/systems/system_7_5_0_77mb_mode32_24ac.img" 0
machine.rtc.time = "2026-09-30T00:00:00"
scheduler.run 400000000

appletalk.printer.enabled = true
scheduler.run 20000000

if appletalk.printer.interpreter == false {
    echo "SKIP: this headless binary has no PostScript interpreter (build with PLATEN=1)"
    quit
}

assert appletalk.printer.status == "status: idle" "printer is not idle before printing"
assert appletalk.printer.documents == 0 "a document exists before any print"

# --- Chooser: pick the LaserWriter ------------------------------------------
# Apple menu -> Chooser
machine.adb.mouse.move 22 9 "global"
wait_cursor(20)
machine.adb.mouse.click true
scheduler.run 6000000
machine.adb.mouse.move 70 114 "global"
scheduler.run 4000000
machine.adb.mouse.click false
scheduler.run 60000000

# The LaserWriter 8 driver icon in the left-hand list
machine.adb.mouse.move 245 220 "global"
wait_cursor(20)
machine.adb.mouse.click true
machine.adb.mouse.click false
wait_mouse_taken(100000000)
scheduler.run 80000000

# The printer itself in the right-hand list
machine.adb.mouse.move 420 111 "global"
wait_cursor(20)
machine.adb.mouse.click true
machine.adb.mouse.click false
wait_mouse_taken(100000000)
scheduler.run 150000000

# Close the Chooser; System 7 then advises "choose Page Setup..." -- OK it.
machine.adb.mouse.move 101 67 "global"
wait_cursor(20)
machine.adb.mouse.click true
machine.adb.mouse.click false
wait_mouse_taken(100000000)
scheduler.run 40000000
machine.adb.mouse.move 437 261 "global"
wait_cursor(20)
machine.adb.mouse.click true
machine.adb.mouse.click false
wait_mouse_taken(100000000)
scheduler.run 60000000

# --- Open the volume window and print it ------------------------------------
# Double-click the "Macintosh HD" icon
machine.adb.mouse.move 600 52 "global"
wait_cursor(20)
machine.adb.mouse.click true
machine.adb.mouse.click false
wait_mouse_taken(100000000)
scheduler.run 300000
machine.adb.mouse.click true
machine.adb.mouse.click false
wait_mouse_taken(100000000)
scheduler.run 80000000

# File -> Print Window...
machine.adb.mouse.move 52 9 "global"
wait_cursor(20)
machine.adb.mouse.click true
scheduler.run 6000000
machine.adb.mouse.move 95 268 "global"
scheduler.run 3000000
machine.adb.mouse.click false
scheduler.run 120000000

# The Print button of the LaserWriter 8.1.1 dialog; the clock starts on its
# release.
machine.adb.mouse.move 520 45 "global"
wait_cursor(20)
machine.adb.mouse.click true
machine.adb.mouse.click false
wait_mouse_taken(100000000)
let c0 = scheduler.cycles
let hz = scheduler.frequency

# Run until the PDF exists, for at most 90 s of guest time -- long enough for
# the slow path to finish too, so a regression reports its time, not a hang.
let n = 0
while appletalk.printer.documents == 0 && (scheduler.cycles - $c0) < 90 * $hz {
    scheduler.run 2000000
    $n = $n + 1
}
let print_ms = (scheduler.cycles - $c0) * 1000 / $hz
# Let the connection close and the printer go idle.
scheduler.run 30000000

echo "printer: documents=${appletalk.printer.documents} pages=${appletalk.printer.last_pages} outcome='${appletalk.printer.last_outcome}' status='${appletalk.printer.status}'"
echo "printer: print_ms=${$print_ms:d} jobs=${appletalk.printer.stats.jobs} bytes=${appletalk.printer.stats.bytes}"

# The document printed: one page, clean outcome, and the printer is idle.
assert appletalk.printer.documents == 1 "no document was produced"
assert appletalk.printer.last_outcome == "ok" "the job did not finish cleanly"
assert appletalk.printer.last_pages == 1 "the printed document is not one page"
assert appletalk.printer.status == "status: idle" "the printer is not idle after the job"

# The speed: the driver read the query's answers, so it sent one small job
# (Level 2 procsets, the resident Helvetica) and the whole print took about
# 15 s of guest time.  The defect this row was written for sent two jobs,
# 346 KB, and took 33 s.
assert appletalk.printer.stats.jobs == 1 "the driver sent more than one job: it did not read the query's answers"
assert appletalk.printer.stats.bytes < 65536 "the driver sent 64 KB or more: it downloaded procsets or fonts the printer has"
assert $print_ms < 30000 "the print took 30 s or more of guest time (Print button to PDF)"
echo done
quit
