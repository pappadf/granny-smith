# ── Build output ──────────────────────────────────────────────────
build/

# ── Standalone tool binaries (rebuilt by `make -C tools/<tool>`) ─
tools/dump/dump
tools/disasm/disasm
tools/peeler/peeler

# ── Emscripten / WASM artifacts ──────────────────────────────────
*.wasm.map
*.debug.wasm
*.tmp.wasm
.emsdk/
.emsdk_env

# ── Test data (copyrighted; fetched by scripts/fetch-test-data.sh) ─
tests/data/*
!tests/data/README.md
tests/data/**/*.blocks/

# ── Node / Playwright (tests/e2e) ───────────────────────────────
node_modules/
playwright-report/
test-results/

# ── Native unit-test build artifacts ─────────────────────────────
tests/unit/build/
tests/unit/*.o
tests/unit/c-tests

# ── Decoded single-step-test JSON (generated from .json.bin) ────
third-party/single-step-tests/v1/*.json

# ── Runtime / temporary files ────────────────────────────────────
test-server.pid
*.log

# ── ROM images (copyrighted; never commit) ──────────────────────
*.rom

# ── OS / editor temporary files ──────────────────────────────────
.DS_Store
Thumbs.db
.env
.env.local
*.swp
*.swo
*~

# ── Internal development notes and checklists (not shipped) ─────
notes/
todo/
local/
tmp/
.claude/scheduled_tasks.lock
__pycache__/

# A working clone of pappadf/m68k-test, used to settle 68k FPU questions
# against the sail model.  NOT a submodule: unlike single-step-tests and
# powerpc-test, which tests/unit/suites/cpu and .../ppc_vectors build against,
# nothing in the tree consumes this one yet -- so registering it would put a
# clone in everyone's checkout and CI for no build.  Promote it to a submodule
# in .gitmodules the day a suite needs it.
third-party/m68k-test/

# Machine-local agent notes (never committed)
*.local.md
